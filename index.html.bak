// ── THREE PERSONAL CALENDARS — each person gets their own Firebase path ──
const CAL_PERSONS = {
  hitendra: { key:'hitendra', label:'Hitendra', color:'#00BFA5', db: DB_BASE+'/calendarHitendra.json' },
  sitendra: { key:'sitendra', label:'Sitendra', color:'#7E57C2', db: DB_BASE+'/calendarSitendra.json' },
  nitendra: { key:'nitendra', label:'Nitendra', color:'#FF8F00', db: DB_BASE+'/calendarNitendra.json' },
};
const DB_CALENDAR = DB_BASE + '/calendarHitendra.json'; // legacy compat

// All three calendars' events
let _allCalEvents = { hitendra:[], sitendra:[], nitendra:[] };
let _activeCalPerson = 'hitendra'; // currently viewed calendar
// calEvents always points to the active person's events
let calEvents = _allCalEvents.hitendra;
let _calPollingTimers = {}; // per-person polling
let calView      = 'week';   // day | week | month
let calDate      = new Date(); // current view anchor date
let editingCalId = null;
let _reminderChecked = new Set(); // prevent duplicate reminders
let _calDragId   = null;

const CAL_COLORS = [
  '#00BFA5','#7E57C2','#FF8F00','#0097A7',
  '#E91E63','#1565C0','#546E7A','#43A047',
  '#E53935','#F06292','#00ACC1','#8D6E63'
];

const CAT_CLASS = {
  meeting:'cat-meeting', review:'cat-review', call:'cat-call',
  travel:'cat-travel', personal:'cat-personal', focus:'cat-focus', other:'cat-other'
};

// ── Visibility: only Directors see the calendar tab ──────────────
function applyCalendarAccess() {
  const tab = document.getElementById('cal-nav-tab');
  if(!tab) return;
  if(hasFullAccess()) {
    tab.classList.remove('cal-nav-tab-hidden');
  } else {
    tab.classList.add('cal-nav-tab-hidden');
    // If someone navigates to calendar without access, redirect
    const page = document.getElementById('page-personal-calendar');
    if(page && page.classList.contains('active')) showTab('dashboard');
  }
}

// ── Load from Firebase ────────────────────────────────────────────
/* loadCalendar replaced by multi-person system */

function mergeCalEvents(arr1, arr2) {
  const map = {};
  [...arr1, ...arr2].forEach(ev => {
    if(ev && ev.id) {
      // Keep the newer version based on createdAt
      if(!map[ev.id] || (ev.createdAt > map[ev.id].createdAt)) map[ev.id] = ev;
    }
  });
  return Object.values(map);
}

/* _saveCalendarToFirebase replaced by multi-person system */

function loadCalendarFromLocalStorage() {
  try {
    const raw = localStorage.getItem('dcd-calendar-backup');
    if(!raw) return [];
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed.filter(e => e && e.id) : [];
  } catch(e) { return []; }
}

/* saveCalendar replaced by multi-person system */

function setCalView(v) {
  calView = v;
  ['day','week','month'].forEach(x => {
    const btn = document.getElementById('cal-btn-'+x);
    if(btn) btn.classList.toggle('active', x===v);
  });
  renderCalendar();
}

function calNav(dir) {
  const d = new Date(calDate);
  if(calView==='day')   d.setDate(d.getDate()+dir);
  if(calView==='week')  d.setDate(d.getDate()+dir*7);
  if(calView==='month') d.setMonth(d.getMonth()+dir);
  calDate = d;
  renderCalendar();
}

function calGoToday() { calDate = new Date(); renderCalendar(); }

// ── Date helpers ──────────────────────────────────────────────────
function dateStr(d) {
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
function isToday(d) { return dateStr(d)===dateStr(new Date()); }
function timeToMin(t) {
  if(!t) return 0;
  const [h,m] = t.split(':').map(Number); return h*60+m;
}
function fmtTime(t) {
  if(!t) return '';
  let [h,m]=t.split(':').map(Number);
  const ap=h>=12?'PM':'AM'; h=h%12||12;
  return h+':'+(m<10?'0':'')+m+' '+ap;
}
function getWeekStart(d) {
  const s=new Date(d); s.setDate(d.getDate()-d.getDay()+1); s.setHours(0,0,0,0); return s;
}

// ── Expand recurring events for a date range ─────────────────────
function expandEvents(startDate, endDate) {
  const result = [];
  const s = new Date(startDate); s.setHours(0,0,0,0);
  const e = new Date(endDate);   e.setHours(23,59,59,0);
  const search = (document.getElementById('cal-search')?.value||'').toLowerCase();

  calEvents.forEach(ev => {
    if(search && !(ev.title||'').toLowerCase().includes(search) &&
       !(ev.description||'').toLowerCase().includes(search)) return;
    const base = new Date(ev.date+'T00:00:00');
    if(ev.recurrence==='Once' || !ev.recurrence) {
      if(base>=s && base<=e) result.push({...ev});
      return;
    }
    const end2 = ev.recurrenceEnd ? new Date(ev.recurrenceEnd+'T00:00:00') : e;
    let cur = new Date(base);
    let count = 0;
    while(cur<=e && cur<=end2 && count<200) {
      count++;
      if(cur>=s) {
        result.push({...ev, date:dateStr(cur), _recurring:true});
      }
      if(ev.recurrence==='Daily')        cur.setDate(cur.getDate()+1);
      else if(ev.recurrence==='Weekly')  cur.setDate(cur.getDate()+7);
      else if(ev.recurrence==='Monthly') cur.setMonth(cur.getMonth()+1);
      else break;
    }
  });
  return result.sort((a,b) => (a.date+a.startTime).localeCompare(b.date+b.startTime));
}

// ── RENDER: Main calendar ─────────────────────────────────────────
function renderCalendar() {
  // Always sync calEvents to active person's events
  if(!_allCalEvents[_activeCalPerson]) _allCalEvents[_activeCalPerson] = [];
  calEvents = _allCalEvents[_activeCalPerson];
  if(calView==='week')  renderWeekView();
  else if(calView==='day')  renderDayView();
  else renderMonthView();
}

// ── Week View ─────────────────────────────────────────────────────
/* renderWeekView replaced */

function placeEvents(evs) {
  // Simple column overlap algorithm
  const sorted = [...evs].sort((a,b)=>timeToMin(a.startTime)-timeToMin(b.startTime));
  const placed=[]; const cols=[];
  sorted.forEach(ev=>{
    let c=0;
    while(cols[c]&&timeToMin(cols[c].endTime)>timeToMin(ev.startTime)) c++;
    cols[c]=ev;
    placed.push({ev,col:c,cols:0});
  });
  const maxCol=cols.filter(Boolean).length||1;
  placed.forEach(p=>p.cols=maxCol);
  return placed;
}

// ── Day View ─────────────────────────────────────────────────────
/* renderDayView replaced */

function renderMonthView() {
  const y=calDate.getFullYear(), mo=calDate.getMonth();
  const titleEl=document.getElementById('cal-title');
  if(titleEl) titleEl.textContent=calDate.toLocaleDateString('en-IN',{month:'long',year:'numeric'});
  const first=new Date(y,mo,1), last=new Date(y,mo+1,0);
  const startDay=(first.getDay()+6)%7;
  const ms=new Date(first); ms.setDate(ms.getDate()-startDay);
  const me=new Date(ms); me.setDate(ms.getDate()+41);
  const events=expandEvents(ms,me);
  const evByDate={};
  events.forEach(ev=>(evByDate[ev.date]=evByDate[ev.date]||[]).push(ev));
  const DOW=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
  const accentColor = CAL_PERSONS[_activeCalPerson]?.color || '#00BFA5';

  let html=`<div style="display:grid;grid-template-columns:repeat(7,1fr);border:1px solid var(--border);border-radius:10px;overflow:hidden;">`;
  DOW.forEach(d=>{ html+=`<div style="padding:9px 8px;text-align:center;background:var(--bg2);border-bottom:2px solid ${accentColor};border-right:1px solid var(--border);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--text3);">${d}</div>`; });
  for(let i=0;i<42;i++){
    const d=new Date(ms); d.setDate(ms.getDate()+i);
    const ds=dateStr(d);
    const other=d.getMonth()!==mo;
    const tod=isToday(d);
    const dayEvs=evByDate[ds]||[];
    html+=`<div onclick="calDate=new Date('${ds}T12:00:00');setCalView('day');"
      style="min-height:90px;padding:6px;border-bottom:1px solid var(--border);
             border-right:1px solid var(--border);cursor:pointer;
             background:${tod?'rgba(0,191,165,.08)':other?'var(--bg2)':'var(--surface)'};
             ${tod?'border-top:2px solid '+accentColor+';':''}
             opacity:${other?'.6':'1'};">
      <div style="font-size:12px;font-weight:700;color:${tod?accentColor:'var(--text2)'};margin-bottom:4px;">${d.getDate()}</div>
      ${dayEvs.slice(0,3).map(ev=>`<div onclick="event.stopPropagation();openCalEventModal('${ev.id}')"
        style="font-size:9px;font-weight:700;padding:2px 5px;border-radius:3px;margin-bottom:2px;
               background:${ev.color||accentColor};color:#fff;white-space:nowrap;overflow:hidden;
               text-overflow:ellipsis;cursor:pointer;">${h(ev.title)}</div>`).join('')}
      ${dayEvs.length>3?`<div style="font-size:9px;color:var(--text3);padding:1px 3px;">+${dayEvs.length-3} more</div>`:''}
    </div>`;
  }
  html+='</div>';
  const wrap=document.getElementById('cal-grid-wrap');
  if(wrap) wrap.innerHTML=`<div style="padding:4px;height:100%;overflow:auto;">${html}</div>`;
}


function onCalMonthCellClick(ds) { calDate=new Date(ds+'T12:00:00'); setCalView('day'); }

// ── Sidebar: Today + Upcoming ─────────────────────────────────────
function renderCalSidebar() {
  const todayList = document.getElementById('cal-today-list');
  const upcomingList = document.getElementById('cal-upcoming-list');
  const today = new Date();
  const in7 = new Date(); in7.setDate(today.getDate()+7);
  const todayEvs = expandEvents(today, today);
  const upEvs    = expandEvents(new Date(today.getTime()+86400000), in7);

  if(todayList) {
    if(!todayEvs.length) { todayList.innerHTML='<div style="font-size:11px;color:var(--text3);padding:6px 0;">No entries today.</div>'; }
    else todayList.innerHTML=todayEvs.map(ev=>`
      <div class="cal-today-event-item">
        <div class="cal-today-dot" style="background:${ev.color||'#00BFA5'};"></div>
        <div>
          <div style="font-size:11px;font-weight:700;color:var(--text);">${h(ev.title)}</div>
          <div class="cal-today-time">${fmtTime(ev.startTime)} – ${fmtTime(ev.endTime)}</div>
        </div>
      </div>`).join('');
  }
  if(upcomingList) {
    if(!upEvs.length) { upcomingList.innerHTML='<div style="font-size:11px;color:var(--text3);padding:6px 0;">No entries in the next 7 days.</div>'; }
    else upcomingList.innerHTML=upEvs.slice(0,8).map(ev=>`
      <div class="cal-today-event-item">
        <div class="cal-today-dot" style="background:${ev.color||'#00BFA5'};"></div>
        <div>
          <div style="font-size:11px;font-weight:700;color:var(--text);">${h(ev.title)}</div>
          <div class="cal-today-time">${new Date(ev.date+'T12:00:00').toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short'})} · ${fmtTime(ev.startTime)}</div>
        </div>
      </div>`).join('');
  }
}

