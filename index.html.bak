/* onCalDrop replaced */

function openCalEventModal(id, ds, hour, minute) {
  const modal=document.getElementById('cal-modal'); if(!modal)return;
  // Build color swatches
  const cgEl=document.getElementById('ce-color-grid');
  if(cgEl) {
    cgEl.innerHTML=CAL_COLORS.map(c=>
      `<div class="cal-color-swatch" style="background:${c};"
        onclick="selectCalColor('${c}')" data-color="${c}" title="${c}"></div>`
    ).join('');
  }
  if(id) {
    const ev=calEvents.find(x=>x.id===id); if(!ev) return;
    editingCalId=id;
    document.getElementById('cal-modal-title').textContent='✏️ Edit Calendar Entry';
    document.getElementById('ce-title').value=ev.title||'';
    document.getElementById('ce-date').value=ev.date||'';
    document.getElementById('ce-start').value=ev.startTime||'';
    document.getElementById('ce-end').value=ev.endTime||'';
    document.getElementById('ce-desc').value=ev.description||'';
    document.getElementById('ce-priority').value=ev.priority||'Medium';
    document.getElementById('ce-category').value=ev.category||'meeting';
    document.getElementById('ce-status').value=ev.status||'Planned';
    document.getElementById('ce-reminder').value=ev.reminder!==undefined?ev.reminder:'15';
    document.getElementById('ce-recur').value=ev.recurrence||'Once';
    document.getElementById('ce-recur-end').value=ev.recurrenceEnd||'';
    document.getElementById('ce-color').value=ev.color||'#00BFA5';
    document.getElementById('ce-delete-btn').style.display='';
    selectCalColor(ev.color||'#00BFA5');
    onCalRecurChange();
  } else {
    editingCalId=null;
    document.getElementById('cal-modal-title').textContent='📅 New Calendar Entry';
    document.getElementById('ce-title').value='';
    document.getElementById('ce-date').value=ds||dateStr(calDate);
    const h2=hour||9, startStr=String(h2).padStart(2,'0')+':'+(minute?String(minute).padStart(2,'0'):'00');
    document.getElementById('ce-start').value=startStr;
    document.getElementById('ce-end').value=String(h2+1<24?h2+1:h2).padStart(2,'0')+':00';
    document.getElementById('ce-desc').value='';
    document.getElementById('ce-priority').value='Medium';
    document.getElementById('ce-category').value='meeting';
    document.getElementById('ce-status').value='Planned';
    document.getElementById('ce-reminder').value='15';
    document.getElementById('ce-recur').value='Once';
    document.getElementById('ce-recur-end').value='';
    document.getElementById('ce-color').value='#00BFA5';
    document.getElementById('ce-delete-btn').style.display='none';
    selectCalColor('#00BFA5');
    onCalRecurChange();
  }
  modal.classList.add('open');
}

function selectCalColor(c) {
  document.getElementById('ce-color').value=c;
  document.querySelectorAll('.cal-color-swatch').forEach(sw=>{
    sw.classList.toggle('selected', sw.dataset.color===c);
    sw.style.outline = sw.dataset.color===c ? '2px solid white' : 'none';
  });
}

function onCalRecurChange() {
  const v=document.getElementById('ce-recur')?.value;
  const rw=document.getElementById('ce-recur-end-wrap');
  if(rw) rw.style.display=(v&&v!=='Once')?'':'none';
  const rv=document.getElementById('ce-reminder')?.value;
  const cw=document.getElementById('ce-custom-reminder-wrap');
  if(cw) cw.style.display=rv==='custom'?'':'none';
}

function closeCalEventModal() {
  editingCalId=null;
  document.getElementById('cal-modal').classList.remove('open');
}

function saveCalEvent() {
  try {
    const titleEl = document.getElementById('ce-title');
    const title   = titleEl ? titleEl.value.trim() : '';
    if(!title){ alert('Work title is required.'); return; }

    const evDate  = (document.getElementById('ce-date')?.value||'').trim();
    const start   = (document.getElementById('ce-start')?.value||'').trim();
    const end     = (document.getElementById('ce-end')?.value||'').trim();

    if(!evDate){ alert('Date is required.'); return; }
    if(!start) { alert('Start time is required.'); return; }
    if(!end)   { alert('End time is required.'); return; }

    // Parse and validate times
    const [sh,sm] = start.split(':').map(Number);
    const [eh,em] = end.split(':').map(Number);
    const startMins = sh*60+(sm||0);
    const endMins   = eh*60+(em||0);
    if(endMins <= startMins){ alert('End time must be after start time.'); return; }

    // Sync calEvents from latest in-memory state
    if(!_allCalEvents[_activeCalPerson]) _allCalEvents[_activeCalPerson] = [];
    calEvents = _allCalEvents[_activeCalPerson];

    // Build entry object with safe fallbacks
    const reminderEl  = document.getElementById('ce-reminder');
    const reminderVal = reminderEl ? reminderEl.value : '15';
    const reminder    = reminderVal==='custom'
      ? parseInt(document.getElementById('ce-custom-reminder')?.value||'15')
      : parseInt(reminderVal)||15;

    const color = document.getElementById('ce-color')?.value ||
                  CAL_PERSONS[_activeCalPerson]?.color || '#00BFA5';

    const data = {
      id:           editingCalId || ('CAL-' + Date.now()),
      title,
      date:         evDate,
      startTime:    start,
      endTime:      end,
      description:  document.getElementById('ce-desc')?.value?.trim() || '',
      priority:     document.getElementById('ce-priority')?.value   || 'Medium',
      category:     document.getElementById('ce-category')?.value   || 'meeting',
      color,
      reminder,
      status:       document.getElementById('ce-status')?.value     || 'Planned',
      recurrence:   document.getElementById('ce-recur')?.value      || 'Once',
      recurrenceEnd:document.getElementById('ce-recur-end')?.value  || null,
      createdAt:    editingCalId
                      ? (calEvents.find(e=>e.id===editingCalId)||{}).createdAt || new Date().toISOString()
                      : new Date().toISOString(),
      createdBy:    currentUser?.email || 'director',
      _person:      _activeCalPerson,
    };

    // Update in-memory array
    if(editingCalId) {
      const i = calEvents.findIndex(e => e.id === editingCalId);
      if(i >= 0) calEvents[i] = data;
      else calEvents.push(data);
    } else {
      calEvents.push(data);
    }
    _allCalEvents[_activeCalPerson] = calEvents;

    // Persist to Firebase + localStorage
    saveCalendarForPerson(_activeCalPerson, calEvents);

    // Close modal and confirm
    closeCalEventModal();
    showGreenSaved(editingCalId ? 'Calendar entry updated' : 'Calendar entry saved');

    // Render updated calendar
    renderCalendar();
    renderCalSidebar();

    console.log('[Calendar] ✅ Entry saved:', data.title, data.date, data.startTime, '→', data.endTime);
  } catch(err) {
    console.error('[Calendar] ❌ saveCalEvent error:', err);
    alert('Error saving calendar entry: ' + err.message + '\n\nPlease try again.');
  }
}

function deleteCalEvent() {
  if(!editingCalId) { toast('No entry selected.','error'); return; }
  const ev = calEvents.find(e=>e.id===editingCalId);
  if(!ev) { toast('Entry not found.','error'); closeCalEventModal(); return; }
  if(!confirm('Delete "' + (ev.title||'this entry') + '"?\n\nThis will be permanently deleted from the cloud.')) return;
  const filtered = calEvents.filter(e=>e.id!==editingCalId);
  calEvents = filtered;
  _allCalEvents[_activeCalPerson] = filtered;

  // Save deletion to Firebase (this is permanent — Firebase will have the smaller array)
  // localStorage is also updated via saveCalendarForPerson
  saveCalendarForPerson(_activeCalPerson, filtered);

  renderCalendar(); renderCalSidebar();
  closeCalEventModal();
  toast('✅ Entry deleted permanently.','success');
}

// ── Reminders ─────────────────────────────────────────────────────
function startReminderChecker() {
  setInterval(checkReminders, 30000);
  checkReminders();
}

function checkReminders() {
  if(!hasFullAccess()) return;
  const now=new Date();
  const todayEvs=expandEvents(now,now);
  todayEvs.forEach(ev=>{
    if(ev.status==='Cancelled'||ev.status==='Completed') return;
    if(ev.reminder===-1||ev.reminder===undefined) return;
    const reminderMin=timeToMin(ev.startTime)-ev.reminder;
    const nowMin=now.getHours()*60+now.getMinutes();
    const key=ev.id+'_'+ev.date+'_'+ev.startTime;
    if(nowMin>=reminderMin && nowMin<reminderMin+2 && !_reminderChecked.has(key)){
      _reminderChecked.add(key);
      showCalReminder(ev);
    }
  });
}

function showCalReminder(ev) {
  const popup=document.getElementById('cal-reminder-popup'); if(!popup)return;
  document.getElementById('cal-reminder-title').textContent=ev.title||'Reminder';
  document.getElementById('cal-reminder-time').textContent=
    (ev.reminder>0?'In '+ev.reminder+' minutes — ':'Now — ')+fmtTime(ev.startTime)+' – '+fmtTime(ev.endTime);
  popup.classList.add('show');
  // Browser notification if permission granted
  if('Notification' in window && Notification.permission==='granted') {
    new Notification('📅 '+ev.title,{body:fmtTime(ev.startTime)+' – '+fmtTime(ev.endTime),icon:'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">📅</text></svg>'});
  }
}

function dismissReminder() {
  document.getElementById('cal-reminder-popup').classList.remove('show');
}

// Request notification permission when calendar is opened
function requestCalNotifPermission() {
  if('Notification' in window && Notification.permission==='default') {
    Notification.requestPermission();
  }
}


// ═══════════════════════════════════════════════════════════════════
// FROZEN COLUMNS — JavaScript-based left offset calculator
// Measures actual rendered pixel widths after every render.
// This is the ONLY reliable approach across all zoom levels.
// ═══════════════════════════════════════════════════════════════════

function applyFrozenColumns(tableEl) {
  if(!tableEl) return;
  const rows = tableEl.querySelectorAll('tr');
  if(!rows.length) return;

  // Step 1: Measure cumulative left offsets from the header row
  const headerRow = tableEl.querySelector('thead tr');
  if(!headerRow) return;
  const headerCells = headerRow.querySelectorAll('th');
  const offsets = [];
  let cumLeft = 0;
  headerCells.forEach((th, i) => {
    if(i < 3) {
      offsets[i] = cumLeft;
      cumLeft += th.getBoundingClientRect().width;
    }
  });
  if(!offsets.length) return;

  // Step 2: Apply sticky left to all frozen cells in every row
  rows.forEach(row => {
    const isHead = !!row.closest('thead');
    const cells  = row.querySelectorAll('th, td');
    cells.forEach((cell, i) => {
      if(i >= 3) return;
      // Apply position and left
      cell.style.position = 'sticky';
      cell.style.left     = offsets[i] + 'px';
      cell.style.zIndex   = isHead ? (20 - i) : (8 - i);
      // Solid background — no transparency
      cell.style.background = isHead
        ? getComputedStyle(document.documentElement).getPropertyValue('--bg2').trim() || '#0D2137'
        : getComputedStyle(document.documentElement).getPropertyValue('--surface').trim() || '#112840';
      // top for headers
      if(isHead) cell.style.top = '0px';
    });
  });
}

// Apply to all task tables after render
function applyAllFrozenColumns() {
  document.querySelectorAll('.task-table').forEach(tbl => applyFrozenColumns(tbl));
}

// ResizeObserver — reapply when window/zoom changes
let _frozenResizeObs = null;
function startFrozenObserver() {
  if(_frozenResizeObs) _frozenResizeObs.disconnect();
  if(typeof ResizeObserver !== 'undefined') {
    _frozenResizeObs = new ResizeObserver(() => applyAllFrozenColumns());
    document.querySelectorAll('.task-table').forEach(tbl => _frozenResizeObs.observe(tbl));
  }
}


// ═══════════════════════════════════════════════════════════════════
// CALENDAR DATA RECOVERY SYSTEM
// Searches ALL possible storage locations for calendar data
// Uses STABLE key that never changes with filename
// ═══════════════════════════════════════════════════════════════════

// STABLE storage keys — do NOT change with filename or version
const CAL_KEY_PRIMARY  = 'director-calendar-v1';          // stable primary
const CAL_KEY_BACKUP1  = 'director-calendar-backup-1';    // rotating backup 1
const CAL_KEY_BACKUP2  = 'director-calendar-backup-2';    // rotating backup 2
const CAL_KEY_BACKUP3  = 'director-calendar-backup-3';    // rotating backup 3
const CAL_KEY_LEGACY1  = 'dcd-calendar-backup';           // old key from v1
const CAL_KEY_LEGACY2  = 'personalcalendar';              // old key attempt
const CAL_ALL_KEYS = [CAL_KEY_PRIMARY, CAL_KEY_BACKUP1, CAL_KEY_BACKUP2,
                      CAL_KEY_BACKUP3, CAL_KEY_LEGACY1, CAL_KEY_LEGACY2];

// ── Multi-key search across all storage ──────────────────────────
function searchAllCalendarStorage() {
  // ONLY check current per-person keys — no legacy resurrection
  const found=[]; const seen=new Set();
  ['hitendra','sitendra','nitendra'].forEach(person=>{
    try{
      const raw=localStorage.getItem('dcd-cal-'+person); if(!raw) return;
      const p=JSON.parse(raw);
      const evs=p._v?p.events:(Array.isArray(p)?p:[]);
      (evs||[]).forEach(ev=>{if(ev&&ev.id&&!seen.has(ev.id)){seen.add(ev.id);found.push({...ev,_foundIn:'dcd-cal-'+person});}});
    }catch(e){}
  });
  return found;
}

function saveCalendarAllKeys(events) { return; // disabled — single-key saves only
  const data = events.filter(e => e && e.id);
  const json = JSON.stringify(data);
  const meta = JSON.stringify({ events: data, savedAt: new Date().toISOString(), count: data.length });
  try { localStorage.setItem(CAL_KEY_PRIMARY, json); } catch(e) {}
  try {
    // Rotate: backup3 ← backup2 ← backup1 ← current primary
    const b2 = localStorage.getItem(CAL_KEY_BACKUP2);
    if(b2) try { localStorage.setItem(CAL_KEY_BACKUP3, b2); } catch(e) {}
    const b1 = localStorage.getItem(CAL_KEY_BACKUP1);
    if(b1) try { localStorage.setItem(CAL_KEY_BACKUP2, b1); } catch(e) {}
    localStorage.setItem(CAL_KEY_BACKUP1, meta);
  } catch(e) {}
  // Keep legacy key in sync for backward compatibility
  try { localStorage.setItem(CAL_KEY_LEGACY1, json); } catch(e) {}
}

// ── Load calendar: multi-key fallback, never overwrites ──────────
/* loadCalendarFromAllStorage replaced by multi-person system */

function minFromStart(timeStr) {
  return timeToMin(timeStr) - CAL_START * 60;
}

/* buildTimeGutter replaced */

/* buildDayColumnInner replaced */

function scanAndShowCalendarRecovery() {
  const bar    = document.getElementById('cal-recovery-bar');
  const msg    = document.getElementById('cal-recovery-msg');
  const recBtn = document.getElementById('cal-recover-btn');
  if(!bar||!msg) return;

  // Show bar while scanning
  bar.style.display = 'flex';
  msg.textContent = '🔍 Scanning all storage locations for your calendar data…';
  if(recBtn) recBtn.style.display = 'none';

  setTimeout(() => {
    const allFound = searchAllCalendarStorage();
    const storageCount = allFound.length;
    const currentCount = calEvents.length;

    if(storageCount === 0 && currentCount === 0) {
      // No data anywhere
      msg.textContent = 'ℹ No calendar data found in this browser. If you saved on a different browser/computer, use Import from File.';
      if(recBtn) recBtn.style.display = 'none';
    } else if(storageCount > currentCount) {
      // Found MORE data in storage than currently loaded
      msg.textContent = `📦 Found ${storageCount} calendar entries in local backup! Current view shows ${currentCount}. Click Restore to recover all.`;
      if(recBtn) { recBtn.style.display = ''; recBtn.textContent = `♻ Restore All ${storageCount} Entries`; }
    } else if(currentCount > 0) {
      // Already loaded correctly
      msg.textContent = `✅ ${currentCount} calendar entries loaded successfully. All your data is here.`;
      if(recBtn) recBtn.style.display = 'none';
      // Auto-hide after 3 seconds if everything is fine
      setTimeout(() => { bar.style.display = 'none'; }, 3000);
    } else {
      bar.style.display = 'none';
    }
  }, 500);
}

function doCalendarRecovery() {
  // Firebase is the authoritative source — just reload from there
  loadCalendar();
  const bar=document.getElementById('cal-recovery-bar');
  if(bar)bar.style.display='none';
  toast('🔄 Calendar refreshed from Firebase (your deleted entries stay deleted).','success');
}


function getCalPersonForUser() {
  if(!currentUser) return null;
  if(hasFullAccess()) return null; // Directors see all tabs
  const name  = (currentUser.displayName||'').toLowerCase();
  const email = (currentUser.email||'').toLowerCase();
  const combined = name + ' ' + email;
  if(combined.includes('hitendra')) return 'hitendra';
  if(combined.includes('sitendra')) return 'sitendra';
  if(combined.includes('nitendra')) return 'nitendra';
  return null; // no calendar for this user
}

function canViewCalPerson(person) {
  if(hasFullAccess()) return true; // Directors see all
  return getCalPersonForUser() === person;
}

// ── Switch active calendar ────────────────────────────────────────
function switchCalPerson(person) {
  if(!canViewCalPerson(person)) {
    toast('You can only view your own personal calendar.','error');
    return;
  }
  _activeCalPerson = person;
  calEvents = _allCalEvents[person] = _allCalEvents[person] || []; // point calEvents at right array

  // Update tab styling + color accent
  document.querySelectorAll('.cal-person-tab').forEach(t => t.classList.remove('active'));
  const activeTab = document.getElementById('cal-tab-'+person);
  if(activeTab) activeTab.classList.add('active');

  // Set calendar accent color
  const color = CAL_PERSONS[person]?.color || '#00BFA5';
  document.documentElement.style.setProperty('--cal-accent', color);

  // Load this person's calendar from Firebase (fresh)
  loadCalendarForPerson(person);
  renderCalendar();
  renderCalSidebar();
}

function applyCalendarPersonAccess() {
  const userPerson = getCalPersonForUser();
  if(hasFullAccess()) {
    // Director: show all 3 tabs
    ['hitendra','sitendra','nitendra'].forEach(p => {
      const t = document.getElementById('cal-tab-'+p);
      if(t) t.style.display = '';
    });
  } else if(userPerson) {
    // Regular user: show only their tab and auto-switch to it
    ['hitendra','sitendra','nitendra'].forEach(p => {
      const t = document.getElementById('cal-tab-'+p);
      if(t) t.style.display = (p===userPerson) ? '' : 'none';
    });
    if(userPerson !== _activeCalPerson) switchCalPerson(userPerson);
  } else {
    // No calendar access
    const calTab = document.getElementById('cal-nav-tab');
    if(calTab) calTab.style.display = 'none';
  }
}

// ── Firebase: load one person's calendar ─────────────────────────
function loadCalendarForPerson(person, silent) {
  const cfg = CAL_PERSONS[person]; if(!cfg) return;
  updateCalFirebaseStatus('loading');

  // Show localStorage cache immediately for instant UI (while Firebase loads)
  const cached = _getLocalCache(person);
  if(cached.events.length > 0 && !_allCalEvents[person]?.length) {
    _allCalEvents[person] = cached.events;
    if(person===_activeCalPerson){ calEvents=cached.events; if(!silent){renderCalendar();renderCalSidebar();} }
  }

  withToken(token => {
    fetch(cfg.db + '?auth=' + token)
    .then(r => {
      if(r.status===401||r.status===403) throw new Error('permission');
      if(!r.ok) throw new Error('HTTP '+r.status);
      return r.json();
    })
    .then(data => {
      const fb = _extractEvents(data);

      // ── FIREBASE IS AUTHORITATIVE ─────────────────────────────────
      // Trust whatever Firebase says — including empty arrays (deletions)
      // ONLY exception: Firebase path has NEVER been written (null AND no savedAt)
      // which means it's a brand-new path, not an intentional deletion

      if(data === null || data === undefined) {
        // Path never written — this is the ONLY case we consider localStorage
        // But we ONLY push localStorage to Firebase if it has events AND is recent (<7 days)
        if(cached.events.length > 0 && _isRecentCache(cached.savedAt, 7)) {
          console.log('[Calendar] New Firebase path — pushing', cached.events.length, person, 'events from cache');
          _allCalEvents[person] = cached.events;
          if(person===_activeCalPerson){ calEvents=cached.events; if(!silent){renderCalendar();renderCalSidebar();} }
          // Push to Firebase to initialize the path
          saveCalendarForPerson(person, cached.events);
        } else {
          // No recent cache or path is genuinely new
          _allCalEvents[person] = [];
          if(person===_activeCalPerson){ calEvents=[]; if(!silent){renderCalendar();renderCalSidebar();} }
        }
      } else {
        // Firebase has data — use it, but only if local wasn't JUST saved (prevent race)
        _allCalEvents[person] = fb.events;
        if(person===_activeCalPerson) calEvents = fb.events;
        // Update localStorage to match Firebase
        try { localStorage.setItem('dcd-cal-'+person, JSON.stringify(data)); } catch(e){}
        console.log('[Calendar] Firebase →', person, fb.events.length, 'events (savedAt:', fb.savedAt||'legacy',')');
        // Clear legacy keys so old deleted data can't be resurrected
        try {
          ['dcd-calendar-backup','director-calendar-v1','personalcalendar'].forEach(k=>{
            const old=localStorage.getItem(k);
            if(old) { localStorage.removeItem(k); }
          });
        } catch(e){};
        if(person===_activeCalPerson){
          calEvents=fb.events;
          if(!silent){renderCalendar();renderCalSidebar();}
        }
      }
      updateCalFirebaseStatus('ok');
    })
    .catch(e => {
      // Network/auth error — Firebase unreachable
      // ONLY NOW fall back to localStorage (offline mode)
      console.warn('[Calendar] Firebase unreachable for', person, '—', e.message, '(using local cache)');
      const cached2 = _getLocalCache(person);
      _allCalEvents[person] = cached2.events;
      if(person===_activeCalPerson){
        calEvents=cached2.events;
        if(!silent){renderCalendar();renderCalSidebar();}
      }
      updateCalFirebaseStatus('err');
    });
  });
}

function _getLocalCache(person) {
  try {
    const raw = localStorage.getItem('dcd-cal-'+person);
    if(!raw) return {events:[], savedAt:null};
    return _extractEvents(JSON.parse(raw));
  } catch(e) { return {events:[], savedAt:null}; }
}

function _isRecentCache(savedAt, maxDays) {
  if(!savedAt) return false;
  const age = (Date.now() - new Date(savedAt).getTime()) / 86400000;
  return age < maxDays;
}


function loadCalPersonFromCache(person) {
  // Check multiple keys for this person
  const keys = ['dcd-cal-'+person, 'director-calendar-v1', 'dcd-calendar-backup', CAL_KEY_PRIMARY];
  for(const key of keys) {
    try {
      const raw = localStorage.getItem(key);
      if(!raw) continue;
      const data = JSON.parse(raw);
      const events = Array.isArray(data) ? data : (data&&data.events ? data.events : []);
      // Filter for this person or use all if person-specific key
      if(key === 'dcd-cal-'+person) return events.filter(e=>e&&e.id);
      // For global keys, filter by person if possible
      const personEvents = events.filter(e => e && e.id && (!e._person || e._person===person));
      if(personEvents.length > 0) return personEvents;
    } catch(e){}
  }
  return [];
}

// ── Firebase: save one person's calendar ─────────────────────────
function saveCalendarForPerson(person, events) {
  const cfg = CAL_PERSONS[person]; if(!cfg) return;
  const clean = (events||[]).filter(e=>e&&e.id);

  // Versioned payload — savedAt timestamp lets us compare versions
  const payload = {
    events:   clean,
    savedAt:  new Date().toISOString(),
    count:    clean.length,
    _v:       2  // schema version
  };

  // Write to localStorage IMMEDIATELY (local cache only)
  try { localStorage.setItem('dcd-cal-'+person, JSON.stringify(payload)); } catch(e){}

  // Write to Firebase (permanent, authoritative source of truth)
  updateCalFirebaseStatus('saving');
  withToken(token => {
    fetch(cfg.db + '?auth=' + token, {
      method: 'PUT',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    })
    .then(r => {
      if(!r.ok) throw new Error('HTTP '+r.status);
      return r.json();
    })
    .then(() => {
      updateCalFirebaseStatus('ok');
      console.log('[Calendar] ✅', person, clean.length, 'events saved to Firebase at', payload.savedAt);
    })
    .catch(e => {
      updateCalFirebaseStatus('err');
      console.error('[Calendar] ❌ Firebase save FAILED for', person, ':', e.message);
      console.error('[Calendar] Save FAILED:', e.message);
      toast('⚠ Calendar save failed: '+e.message,'error');
      // Auto-retry once after 10 seconds
      setTimeout(() => saveCalendarForPerson(person, events), 10000);
    });
  });
}

function _extractEvents(data) {
  // Handle both old format (array) and new format ({events:[], savedAt:...})
  if(!data) return { events:[], savedAt:null };
  if(Array.isArray(data)) return { events:data.filter(e=>e&&e.id), savedAt:null };
  if(data._v && data.events) return { events:(data.events||[]).filter(e=>e&&e.id), savedAt:data.savedAt||null };
  if(typeof data==='object') return { events:Object.values(data).filter(e=>e&&e.id&&e.title), savedAt:null };
  return { events:[], savedAt:null };
}


function updateCalFirebaseStatus(state) {
  const el = document.getElementById('cal-firebase-status');
  if(!el) return;
  if(state==='ok')      { el.textContent='● Firebase ✓'; el.className='cal-save-status cal-save-ok'; }
  else if(state==='err'){ el.textContent='● Firebase ✗ (offline)'; el.className='cal-save-status cal-save-err'; }
  else if(state==='saving'){ el.textContent='⏳ Saving…'; el.className='cal-save-status cal-save-ing'; }
  else if(state==='loading'){ el.textContent='⏳ Loading…'; el.className='cal-save-status cal-save-ing'; }
}

// ── Load ALL three calendars ──────────────────────────────────────
function loadCalendar() {
  if(!hasFullAccess() && !getCalPersonForUser()) return;
  applyCalendarPersonAccess();
  if(hasFullAccess()) {
    // Director: load all 3
    ['hitendra','sitendra','nitendra'].forEach(p => loadCalendarForPerson(p, true));
    // Render the active one
    setTimeout(() => {
      calEvents = _allCalEvents[_activeCalPerson];
      renderCalendar(); renderCalSidebar();
    }, 600);
  } else {
    const person = getCalPersonForUser();
    if(person) { _activeCalPerson = person; loadCalendarForPerson(person); }
  }
}

// ── Override saveCalendar to save to the right person ────────────
function saveCalendar() {
  const person = _activeCalPerson;
  _allCalEvents[person] = [...calEvents];
  saveCalendarForPerson(person, calEvents);
  renderCalendar(); renderCalSidebar();
}

// ── Override saveQNote so it uses correct person's calendar ───────
function _saveCalendarToFirebase(events) {
  saveCalendarForPerson(_activeCalPerson, events);
}

// ── Calendar polling: sync every 15s from Firebase ───────────────
function startCalendarPolling() {
  stopCalendarPolling();
  const pollFn = () => {
    if(hasFullAccess()) {
      // Skip poll if a save is currently in progress
      if(document.getElementById('cal-firebase-status')?.textContent?.includes('Saving')) return;
      ['hitendra','sitendra','nitendra'].forEach(p => loadCalendarForPerson(p, true));
    } else {
      const p = getCalPersonForUser();
      if(p) loadCalendarForPerson(p, true);
    }
  };
  _calPollingTimers.main = setInterval(pollFn, 15000);
  console.log('[Calendar] Real-time polling started (15s interval)');
}

function stopCalendarPolling() {
  Object.values(_calPollingTimers).forEach(t => clearInterval(t));
  _calPollingTimers = {};
}

