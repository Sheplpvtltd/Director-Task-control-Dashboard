<!-- ══════════════════════════════════════════════════
     JAVASCRIPT
══════════════════════════════════════════════════ -->
<script>
'use strict';

// ── FIREBASE CONFIG (replace with your values) ──────────────
// ── ACCESS CONTROL CONSTANTS ──────────────────────────────────
const SUPER_ADMIN_EMAIL = 'ea.director@shengitech.com';
const FIREBASE_CONFIG = {
  apiKey:            "AIzaSyACkVo_v0BEiNdDfWLIT3V_LFE8frXAGT0",
  authDomain:        "shepl-director-task-control.firebaseapp.com",
  databaseURL:       "https://shepl-director-task-control-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId:         "shepl-director-task-control",
  storageBucket:     "shengitech-dashboard.firebasestorage.app",
  messagingSenderId: "718793086409",
  appId:             "1:718793086409:web:7b010d87a39b28e70fc418",
  measurementId:     "G-MFQ1557MCE"
};

// ── MASTER LISTS ─────────────────────────────────────────────
const L = {
  depts:      ['Management','Engineering & Projects','Purchase & Finance','Trainee','HR & Admin','Sales & Proposals','IT','Process','Accounts','Other'],
  taskTypes:  ['Review','Approval','Follow-up','Decision','Report','Development','Office','Renewal','Bank','Repair','Client','Vendor','Recruitment','SOP','ERP','Meeting','Other'],
  pris:       ['P1 - Critical','P2 - High','P3 - Medium','P4 - Low'],
  statuses:   ['Not Started','In Progress','Waiting','Blocked','Done','Cancelled'],
  owners:     ['Director','Project Head','Project Manager','Finance Head','Accounts Executive','Purchase Head','Proposal Owner','ERP Coordinator','Department Lead','HR / Admin','External Vendor','Client','Other'],
  projStatus: ['Planning','Active','On Hold','Completed','Cancelled'],
  recurrence: ['None','Daily','Alternate Days','Weekly','Fortnightly','Monthly','Quarterly','Custom'],
};

// Recurrence interval in days
// Migration helper — old tasks used `project` string, new use `projects` array
function getTaskProjects(t) {
  if (Array.isArray(t.projects)) return t.projects;
  if (t.project) return [t.project];
  return [];
}

const RECUR_DAYS = {
  Daily:1, 'Alternate Days':2, Weekly:7, Fortnightly:14, Monthly:30, Quarterly:91
};

// ── FIREBASE REST ─────────────────────────────────────────────
const AUTH_URL    = 'https://identitytoolkit.googleapis.com/v1/accounts:';
const API_KEY     = FIREBASE_CONFIG.apiKey;
const DB_BASE     = FIREBASE_CONFIG.databaseURL;
const DB_TASKS    = DB_BASE + '/tasks.json';
const DB_PROJECTS = DB_BASE + '/projects.json';
const DB_EMPLOYEES = DB_BASE + '/employees.json';
const DB_NOTES     = DB_BASE + '/notes.json';
const DB_ACTIVITY  = DB_BASE + '/activity.json';
const DB_ARCHIVE   = DB_BASE + '/archive.json';

// ── SESSION ───────────────────────────────────────────────────
let idToken      = localStorage.getItem('dcd-idToken')     || '';
let tokenExpiry  = parseInt(localStorage.getItem('dcd-tokenExpiry') || '0');
let refreshToken = localStorage.getItem('dcd-refreshToken') || '';
let savedName    = localStorage.getItem('dcd-userName')    || '';
let savedEmail   = localStorage.getItem('dcd-userEmail')   || '';

function isLoggedIn() { return !!idToken && Date.now() < tokenExpiry; }

function saveSession(data, name) {
  idToken     = data.idToken;
  refreshToken= data.refreshToken || refreshToken;
  tokenExpiry = Date.now() + parseInt(data.expiresIn || 3600) * 1000;
  savedEmail  = data.email || savedEmail;
  savedName   = name || savedName;
  localStorage.setItem('dcd-idToken',      idToken);
  localStorage.setItem('dcd-tokenExpiry',  tokenExpiry);
  localStorage.setItem('dcd-refreshToken', refreshToken);
  localStorage.setItem('dcd-userName',     savedName);
  localStorage.setItem('dcd-userEmail',    savedEmail);
}

function clearSession() {
  idToken=''; refreshToken=''; tokenExpiry=0; savedName=''; savedEmail='';
  ['dcd-idToken','dcd-tokenExpiry','dcd-refreshToken','dcd-userName','dcd-userEmail'].forEach(k=>localStorage.removeItem(k));
}

function withToken(cb) {
  if (isLoggedIn()) { cb(idToken); return; }
  if (!refreshToken) { clearSession(); showScreen('auth'); return; }
  fetch('https://securetoken.googleapis.com/v1/token?key=' + API_KEY, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body:JSON.stringify({grant_type:'refresh_token',refresh_token:refreshToken})
  }).then(r=>r.json()).then(d=>{
    if (d.error) { clearSession(); showScreen('auth'); return; }
    idToken=d.id_token; refreshToken=d.refresh_token;
    tokenExpiry=Date.now()+parseInt(d.expires_in)*1000;
    localStorage.setItem('dcd-idToken',idToken);
    localStorage.setItem('dcd-tokenExpiry',tokenExpiry);
    localStorage.setItem('dcd-refreshToken',refreshToken);
    cb(idToken);
  }).catch(()=>{ clearSession(); showScreen('auth'); });
}

// ── APP STATE ─────────────────────────────────────────────────
let tasks        = [];
let projects     = [];
let fbReady      = false;
let currentUser  = null;
let editingId    = null;
let _userRole    = 'none';    // superadmin | director | department | limited
let _userDept    = null;      // null = all access
let _qnoteTaskId = null;      // task being quick-noted
let editingProjId= null;
let pendingDelId = null;
let pendingDelProjId = null;
let employees    = [];
let notes        = [];  // quick notes
let archived     = [];  // ONLY Done tasks live here
let lastETagA    = '';  // ETag for archive polling
let pollTimer    = null;
let _excelBlob   = null;  // pre-generated Excel blob
let _excelBlobUrl= null;
let _excelGenTimer = null;
let lastETagT    = '';
let lastETagP    = '';
let lastETagE    = '';
let editingEmpId = null;
let pendingDelEmpId = null;

// ── THEME ─────────────────────────────────────────────────────
(function(){ const t=localStorage.getItem('dcd-theme')||'dark'; document.documentElement.setAttribute('data-theme',t); })();

function toggleTheme() {
  const html=document.documentElement;
  const next=html.getAttribute('data-theme')==='dark'?'light':'dark';
  html.setAttribute('data-theme',next);
  localStorage.setItem('dcd-theme',next);
  updateAuthThemeBtn();
}
function updateAuthThemeBtn() {
  const dark=document.documentElement.getAttribute('data-theme')==='dark';
  const icon=document.getElementById('auth-theme-icon');
  const lbl=document.getElementById('auth-theme-lbl');
  if(icon) icon.textContent=dark?'☀️':'🌙';
  if(lbl)  lbl.textContent=dark?'Light':'Dark';
}

// ── AUTH ──────────────────────────────────────────────────────
function isConfigured() { return FIREBASE_CONFIG.apiKey && !FIREBASE_CONFIG.apiKey.includes('PASTE_YOUR'); }

function showPanel(name) {
  document.getElementById('panel-signin').style.display=name==='signin'?'':'none';
  document.getElementById('panel-signup').style.display=name==='signup'?'':'none';
  clearAuthErrors();
}
function clearAuthErrors() {
  ['signin-error','signup-error'].forEach(id=>{ const el=document.getElementById(id); if(el){el.textContent='';el.classList.remove('visible');} });
}
function showAuthError(id,msg) { const el=document.getElementById(id); if(el){el.textContent=msg;el.classList.add('visible');} }
function setBtnLoading(id,loading) { const btn=document.getElementById(id); if(!btn)return; btn.classList.toggle('loading',loading); btn.disabled=loading; }

const AUTH_ERRORS = {
  'EMAIL_NOT_FOUND':'No account found with this email.',
  'INVALID_PASSWORD':'Incorrect password.',
  'INVALID_LOGIN_CREDENTIALS':'Incorrect email or password.',
  'USER_DISABLED':'This account has been disabled.',
  'EMAIL_EXISTS':'This email is already registered. Sign in instead.',
  'WEAK_PASSWORD':'Password must be at least 6 characters.',
  'INVALID_EMAIL':'Invalid email address.',
  'TOO_MANY_ATTEMPTS_TRY_LATER':'Too many attempts. Please wait and try again.'
};
function friendlyErr(data) { const msg=(data.error&&data.error.message)||'Unknown error'; return AUTH_ERRORS[msg.split(' : ')[0]]||msg; }

function doSignIn() {
  const email=document.getElementById('signin-email').value.trim();
  const pass=document.getElementById('signin-password').value;
  if(!email||!pass){showAuthError('signin-error','Please enter email and password.');return;}
  clearAuthErrors(); setBtnLoading('btn-signin',true);
  fetch(AUTH_URL+'signInWithPassword?key='+API_KEY,{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({email,password:pass,returnSecureToken:true})})
  .then(r=>r.json()).then(data=>{
    setBtnLoading('btn-signin',false);
    if(data.error){showAuthError('signin-error',friendlyErr(data));return;}
    saveSession(data,data.displayName||email.split('@')[0]);
    currentUser={email:savedEmail,displayName:savedName};
    setUserChip(currentUser); showScreen('app'); startDB();
  }).catch(err=>{ setBtnLoading('btn-signin',false); showAuthError('signin-error','⚠ '+err.message+' — See fix steps above.'); document.getElementById('domain-banner').style.display=''; });
}

function doSignUp() {
  const name=document.getElementById('signup-name').value.trim();
  const email=document.getElementById('signup-email').value.trim();
  const pass=document.getElementById('signup-password').value;
  if(!name){showAuthError('signup-error','Please enter your name.');return;}
  if(!email){showAuthError('signup-error','Please enter your email.');return;}
  if(pass.length<6){showAuthError('signup-error','Password must be at least 6 characters.');return;}
  clearAuthErrors(); setBtnLoading('btn-signup',true);
  fetch(AUTH_URL+'signUp?key='+API_KEY,{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({email,password:pass,returnSecureToken:true})})
  .then(r=>r.json()).then(data=>{
    if(data.error){setBtnLoading('btn-signup',false);showAuthError('signup-error',friendlyErr(data));return;}
    return fetch(AUTH_URL+'update?key='+API_KEY,{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({idToken:data.idToken,displayName:name,returnSecureToken:true})})
    .then(r=>r.json()).then(updated=>{
      setBtnLoading('btn-signup',false);
      saveSession({idToken:updated.idToken||data.idToken,refreshToken:data.refreshToken,expiresIn:data.expiresIn,email},name);
      currentUser={email,displayName:name};
      setUserChip(currentUser); showScreen('app'); startDB();
      resolveUserRole(); applyRoleToUI();
      setTimeout(fitToScreen, 200);
    });
  }).catch(err=>{ setBtnLoading('btn-signup',false); showAuthError('signup-error','⚠ '+err.message+' — See fix steps above.'); document.getElementById('domain-banner').style.display=''; });
}

function doSignOut() {
  clearSession(); if(pollTimer){clearInterval(pollTimer);pollTimer=null;}
  tasks=[]; projects=[]; fbReady=false;
  showScreen('auth'); toast('Signed out.','success');
}

// ── DATABASE REST ─────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════════
// CALENDAR RENDER ENGINE — All views (Day, Week, Month)
// Pure inline styles, no CSS class dependency
// ═══════════════════════════════════════════════════════════════════
const _CAL_START  = 6;
const _CAL_END    = 22;
const _CAL_PX_HR  = 64;
const _CAL_TOTAL  = (_CAL_END - _CAL_START) * _CAL_PX_HR;

function _fmtHour(h) {
  if(h===0||h===24) return '12 AM';
  if(h===12) return '12 PM';
  return h<12 ? h+' AM' : (h-12)+' PM';
}
function _minFromTop(t) {
  if(!t) return 0;
  const [hh,mm]=t.split(':').map(Number);
  return (hh*60+mm)-_CAL_START*60;
}
function _buildTimeGutterHtml() {
  let s=`<div style="width:56px;min-width:56px;flex-shrink:0;border-right:1px solid var(--border);">
    <div style="position:relative;height:${_CAL_TOTAL}px;">`;
  for(let h2=_CAL_START;h2<_CAL_END;h2++){
    s+=`<div style="position:absolute;top:${(h2-_CAL_START)*_CAL_PX_HR}px;left:0;right:0;
      height:${_CAL_PX_HR}px;display:flex;align-items:flex-start;justify-content:flex-end;
      padding:3px 6px 0;font-size:9px;font-weight:700;color:var(--text3);
      font-family:var(--mono);border-top:1px solid var(--border);">${_fmtHour(h2)}</div>`;
  }
  return s+'</div></div>';
}
function _buildEventsHtml(dayEvs,ds) {
  const placed=placeEvents(dayEvs);
  let s='';
  placed.forEach(({ev,col,cols:tc})=>{
    const sm=_minFromTop(ev.startTime), em=_minFromTop(ev.endTime);
    if(em<=0||sm>=_CAL_TOTAL) return;
    const top=Math.max(0,sm), ht=Math.max(20,Math.min(em,_CAL_TOTAL)-top);
    const cw=100/tc, lp=col*cw;
    const clr=ev.color||CAL_PERSONS[_activeCalPerson]?.color||'#00BFA5';
    s+=`<div onclick="event.stopPropagation();openCalEventModal('${ev.id}')" draggable="true"
      ondragstart="event.stopPropagation();_calDragId='${ev.id}';"
      style="position:absolute;top:${top}px;height:${ht}px;left:calc(${lp}% + 2px);
        width:calc(${cw}% - 4px);background:${clr};color:#fff;border-radius:5px;
        padding:3px 7px;overflow:hidden;cursor:pointer;z-index:5;
        border-left:3px solid rgba(0,0,0,.2);box-sizing:border-box;">
      <div style="font-size:11px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${h(ev.title||'')}</div>
      ${ht>28?`<div style="font-size:9px;opacity:.85;font-family:var(--mono);">${fmtTime(ev.startTime)} \u2013 ${fmtTime(ev.endTime)}</div>`:''}
    </div>`;
  });
  if(ds===dateStr(new Date())){
    const nm=new Date().getHours()*60+new Date().getMinutes()-_CAL_START*60;
    if(nm>0&&nm<_CAL_TOTAL)
      s+=`<div style="position:absolute;left:0;right:0;top:${nm}px;height:2px;background:var(--red);z-index:10;pointer-events:none;">
        <div style="position:absolute;left:-4px;top:-4px;width:10px;height:10px;border-radius:50%;background:var(--red);"></div></div>`;
  }
  return s;
}
function _buildDayColHtml(dayEvs,ds,xStyle) {
  let slots='';
  for(let i=0;i<(_CAL_END-_CAL_START);i++){
    slots+=`<div style="position:absolute;left:0;right:0;top:${i*_CAL_PX_HR}px;height:${_CAL_PX_HR}px;
      border-top:1px solid var(--border);" onclick="onCalGridClick(event,'${ds}',${i+_CAL_START})"></div>
      <div style="position:absolute;left:0;right:0;top:${i*_CAL_PX_HR+_CAL_PX_HR/2}px;height:1px;
      background:var(--border);opacity:.4;pointer-events:none;"></div>`;
  }
  return `<div style="flex:1;min-width:0;border-right:1px solid var(--border);position:relative;${xStyle||''}"
    ondragover="event.preventDefault()" ondrop="onCalDrop(event,'${ds}')">
    <div style="position:relative;height:${_CAL_TOTAL}px;">${slots}${_buildEventsHtml(dayEvs,ds)}</div>
  </div>`;
}

function renderWeekView() {
  const ws=getWeekStart(calDate), we=new Date(ws); we.setDate(ws.getDate()+6);
  const days=Array.from({length:7},(_,i)=>{const d=new Date(ws);d.setDate(ws.getDate()+i);return d;});
  const DOW=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
  const events=expandEvents(ws,we), byDate={};
  events.forEach(ev=>(byDate[ev.date]=byDate[ev.date]||[]).push(ev));
  const el=document.getElementById('cal-title');
  if(el) el.textContent=ws.toLocaleDateString('en-IN',{day:'numeric',month:'short'})+' \u2013 '+we.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});
  const ac=CAL_PERSONS[_activeCalPerson]?.color||'#00BFA5';
  let head=`<div style="display:flex;border-bottom:2px solid ${ac};background:var(--bg2);flex-shrink:0;">
    <div style="width:56px;min-width:56px;border-right:1px solid var(--border);"></div>`;
  days.forEach((d,i)=>{
    const tod=isToday(d);
    head+=`<div onclick="calDate=new Date('${dateStr(d)}T12:00:00');setCalView('day');"
      style="flex:1;padding:8px 6px;text-align:center;border-right:1px solid var(--border);cursor:pointer;
      background:${tod?'rgba(0,191,165,.1)':'transparent'};">
      <div style="font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--text3);">${DOW[i]}</div>
      <div style="font-size:20px;font-weight:800;color:${tod?ac:'var(--text)'};">${d.getDate()}</div>
    </div>`;
  });
  head+='</div>';
  let cols='';
  days.forEach(d=>{
    const ds=dateStr(d);
    cols+=_buildDayColHtml(byDate[ds]||[],ds,isToday(d)?'background:rgba(0,191,165,.02);':'');
  });
  const body=`<div style="display:flex;flex:1;overflow-y:auto;overflow-x:hidden;">
    ${_buildTimeGutterHtml()}
    <div style="display:flex;flex:1;min-width:0;">${cols}</div>
  </div>`;
  const wrap=document.getElementById('cal-grid-wrap'); if(!wrap) return;
  wrap.innerHTML=`<div style="display:flex;flex-direction:column;height:100%;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--surface);">${head}${body}</div>`;
  const be=wrap.querySelector('[style*="overflow-y:auto"]');
  if(be){const nm=new Date().getHours()*60+new Date().getMinutes()-_CAL_START*60;be.scrollTop=Math.max(0,nm-_CAL_PX_HR*2);}
}

function renderDayView() {
  const ds=dateStr(calDate);
  const el=document.getElementById('cal-title');
  if(el) el.textContent=calDate.toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  const events=expandEvents(calDate,calDate);
  const dayEvs=events.filter(ev=>ev.date===ds);
  const ac=CAL_PERSONS[_activeCalPerson]?.color||'#00BFA5';
  const tod=isToday(calDate);
  const head=`<div style="display:flex;border-bottom:2px solid ${ac};background:var(--bg2);flex-shrink:0;">
    <div style="width:56px;min-width:56px;border-right:1px solid var(--border);"></div>
    <div style="flex:1;padding:8px 6px;text-align:center;background:${tod?'rgba(0,191,165,.1)':'transparent'};">
      <div style="font-size:9px;font-weight:800;text-transform:uppercase;color:var(--text3);">${calDate.toLocaleDateString('en-IN',{weekday:'short'})}</div>
      <div style="font-size:20px;font-weight:800;color:${tod?ac:'var(--text)'};">${calDate.getDate()}</div>
    </div>
  </div>`;
  const body=`<div style="display:flex;flex:1;overflow-y:auto;overflow-x:hidden;">
    ${_buildTimeGutterHtml()}
    <div style="display:flex;flex:1;min-width:0;">${_buildDayColHtml(dayEvs,ds,'')}</div>
  </div>`;
  const wrap=document.getElementById('cal-grid-wrap'); if(!wrap) return;
  wrap.innerHTML=`<div style="display:flex;flex-direction:column;height:100%;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--surface);">${head}${body}</div>`;
  const be=wrap.querySelector('[style*="overflow-y:auto"]');
  if(be){const nm=new Date().getHours()*60+new Date().getMinutes()-_CAL_START*60;be.scrollTop=Math.max(0,nm-_CAL_PX_HR*2);}
}

function renderMonthView() {
  const y=calDate.getFullYear(),mo=calDate.getMonth();
  const el=document.getElementById('cal-title');
  if(el) el.textContent=calDate.toLocaleDateString('en-IN',{month:'long',year:'numeric'});
  const first=new Date(y,mo,1);
  const startDay=(first.getDay()+6)%7;
  const ms=new Date(first); ms.setDate(ms.getDate()-startDay);
  const me=new Date(ms); me.setDate(ms.getDate()+41);
  const events=expandEvents(ms,me), evByDate={};
  events.forEach(ev=>(evByDate[ev.date]=evByDate[ev.date]||[]).push(ev));
  const DOW=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
  const ac=CAL_PERSONS[_activeCalPerson]?.color||'#00BFA5';
  let html=`<div style="display:grid;grid-template-columns:repeat(7,1fr);border:1px solid var(--border);border-radius:10px;overflow:hidden;">`;
  DOW.forEach(d=>{html+=`<div style="padding:9px 8px;text-align:center;background:var(--bg2);border-bottom:2px solid ${ac};border-right:1px solid var(--border);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--text3);">${d}</div>`;});
  for(let i=0;i<42;i++){
    const d=new Date(ms); d.setDate(ms.getDate()+i);
    const ds=dateStr(d);
    const other=d.getMonth()!==mo, tod=isToday(d);
    const dayEvs=evByDate[ds]||[];
    html+=`<div onclick="calDate=new Date('${ds}T12:00:00');setCalView('day');"
      style="min-height:90px;padding:6px;border-bottom:1px solid var(--border);border-right:1px solid var(--border);
      cursor:pointer;background:${tod?'rgba(0,191,165,.08)':other?'var(--bg2)':'var(--surface)'};
      ${tod?'border-top:2px solid '+ac+';':''}opacity:${other?'.6':'1'};">
      <div style="font-size:12px;font-weight:700;color:${tod?ac:'var(--text2)'};margin-bottom:4px;">${d.getDate()}</div>
      ${dayEvs.slice(0,3).map(ev=>`<div onclick="event.stopPropagation();openCalEventModal('${ev.id}')"
        style="font-size:9px;font-weight:700;padding:2px 5px;border-radius:3px;margin-bottom:2px;
        background:${ev.color||ac};color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;">${h(ev.title)}</div>`).join('')}
      ${dayEvs.length>3?`<div style="font-size:9px;color:var(--text3);">+${dayEvs.length-3} more</div>`:''}
    </div>`;
  }
  html+='</div>';
  const wrap=document.getElementById('cal-grid-wrap');
  if(wrap) wrap.innerHTML=`<div style="padding:4px;height:100%;overflow:auto;">${html}</div>`;
}

function onCalGridClick(e,ds,hour) {
  if(e.target.closest('[onclick*="openCalEventModal"]')) return;
  openCalEventModal(null,ds,hour,0);
}
function onCalDrop(e,ds) {
  e.preventDefault(); if(!_calDragId) return;
  const ev=calEvents.find(x=>x.id===_calDragId); if(!ev) return;
  const container=e.currentTarget.querySelector('[style*="position:relative"]'); if(!container) return;
  const rect=container.getBoundingClientRect();
  const dropMin=Math.floor((e.clientY-rect.top)/_CAL_PX_HR)*60;
  const dur=timeToMin(ev.endTime)-timeToMin(ev.startTime);
  const ns=dropMin+_CAL_START*60;
  ev.date=ds; ev.startTime=String(Math.floor(ns/60)).padStart(2,'0')+':'+String(ns%60).padStart(2,'0');
  const ne=ns+dur;
  ev.endTime=String(Math.floor(ne/60)).padStart(2,'0')+':'+String(ne%60).padStart(2,'0');
  _allCalEvents[_activeCalPerson]=[...calEvents];
  saveCalendarForPerson(_activeCalPerson,calEvents);
  renderCalendar(); _calDragId=null;
}



// One-time legacy calendar key cleanup (prevents resurrection of deleted data)
(function(){
  if(localStorage.getItem('_cal_cleanup_v3')==='done') return;
  ['director-calendar-v1','director-calendar-backup-1','director-calendar-backup-2',
   'director-calendar-backup-3','dcd-calendar-backup','personalcalendar'].forEach(k=>{
    try{localStorage.removeItem(k);}catch(e){}
  });
  try{localStorage.setItem('_cal_cleanup_v3','done');}catch(e){}
})();


// ── Green ✓ Saved indicator after task save ──────────────────────
function showGreenSaved(msg) {
  const el = document.getElementById('save-indicator');
  const sp = document.getElementById('saving-spinner');
  if(sp) sp.classList.remove('active');
  if(el) {
    el.textContent = '✔ ' + (msg||'Saved');
    el.style.color   = '#26A69A';
    el.style.opacity = '1';
    el.style.fontWeight = '700';
    setTimeout(()=>{ el.style.opacity='0'; }, 3000);
  }
  // Also show a brief green toast at top of page
  const toast_el = document.createElement('div');
  toast_el.style.cssText = 'position:fixed;top:70px;left:50%;transform:translateX(-50%);'
    +'z-index:99999;background:#26A69A;color:#fff;padding:8px 22px;border-radius:20px;'
    +'font-size:12px;font-weight:800;box-shadow:0 4px 16px rgba(38,166,154,.4);'
    +'animation:fadeInDown .3s ease;pointer-events:none;';
  toast_el.textContent = '✔ ' + (msg||'Saved');
  document.body.appendChild(toast_el);
  setTimeout(()=>{ toast_el.style.opacity='0'; toast_el.style.transition='opacity .4s';
    setTimeout(()=>toast_el.remove(), 400); }, 2000);
}


// ── Quick Note: Save Now → green tick → auto-close ───────────────
function saveQNoteAndClose() {
  saveQNoteNow();  // save the note

  // Show green tick inside the modal button area
  const btn = document.querySelector('#qnote-modal .btn-primary');
  if(btn) {
    const orig = btn.innerHTML;
    btn.innerHTML = '✔ Saved!';
    btn.style.background = '#26A69A';
    btn.style.pointerEvents = 'none';
    // Auto-close after 700ms
    setTimeout(() => {
      closeQNote();
      btn.innerHTML = orig;
      btn.style.background = '';
      btn.style.pointerEvents = '';
      showGreenSaved('Quick note saved');
    }, 700);
  } else {
    closeQNote();
    showGreenSaved('Quick note saved');
  }
}

// ── Remark: Save → green tick → auto-close ───────────────────────
function saveRemarkAndClose() {
  saveRemarkNow();  // save the remark

  const btn = document.querySelector('#inline-remark-modal .btn-primary');
  if(btn) {
    const orig = btn.innerHTML;
    btn.innerHTML = '✔ Saved!';
    btn.style.background = '#26A69A';
    btn.style.pointerEvents = 'none';
    setTimeout(() => {
      closeInlineRemark();
      btn.innerHTML = orig;
      btn.style.background = '';
      btn.style.pointerEvents = '';
      showGreenSaved('Remark saved');
    }, 700);
  } else {
    closeInlineRemark();
    showGreenSaved('Remark saved');
  }
}


// ── TYPING PERFORMANCE: Debounced render + pause polling while typing ──
let _renderDebounceTimers = {};
let _typingPauseTimer = null;
let _pollPausedByTyping = false;

function debouncedRender(fn, delay) {
  // Returns a debounced version of fn
  const key = fn.name || String(fn);
  if(_renderDebounceTimers[key]) clearTimeout(_renderDebounceTimers[key]);
  _renderDebounceTimers[key] = setTimeout(() => {
    delete _renderDebounceTimers[key];
    fn();
  }, delay || 350);
}

function onSearchInput(renderFn) {
  // Pause polling while user types (prevents poll from hijacking focus)
  if(pollTimer && !_pollPausedByTyping) {
    clearInterval(pollTimer);
    _pollPausedByTyping = true;
  }
  if(_typingPauseTimer) clearTimeout(_typingPauseTimer);
  _typingPauseTimer = setTimeout(() => {
    // Resume polling 3 seconds after user stops typing
    _pollPausedByTyping = false;
    if(!pollTimer) pollTimer = setInterval(() => loadAllFromDB(false), 8000);
    _typingPauseTimer = null;
  }, 3000);
  // Debounce the actual render
  debouncedRender(renderFn, 350);
}


// ── Normalize task fields: support both old string and new array format ──
function getTaskDepts(t) {
  if(Array.isArray(t.depts) && t.depts.length) return t.depts;
  if(t.dept && t.dept !== '') return [t.dept];
  return [];
}
function getTaskPersons(t) {
  if(Array.isArray(t.concernedPersons) && t.concernedPersons.length) return t.concernedPersons;
  if(t.concernedPerson && t.concernedPerson !== '') return [t.concernedPerson];
  return [];
}

// ── Multi-Dept Selector State ─────────────────────────────
let _mdsOpen     = false;
let _mdsSelected = [];  // currently selected depts in form

function openMDS() {
  _mdsOpen = true;
  _mdsSelected = getMDSFromForm();
  renderMDSPanel();
  // Position the panel relative to the trigger using screen coordinates
  const trigger = document.getElementById('mds-tags');
  const panel   = document.getElementById('mds-panel');
  if(trigger && panel) {
    const rect = trigger.getBoundingClientRect();
    panel.style.top  = Math.min(rect.bottom + 4, window.innerHeight - 320) + 'px';
    panel.style.left = rect.left + 'px';
    panel.style.width = Math.max(rect.width, 260) + 'px';
    panel.style.display = 'block';
  }
  const tri = document.getElementById('mds-trigger');
  if(tri) tri.style.borderColor = 'var(--corp-teal)';
}
function closeMDS() {
  _mdsOpen = false;
  document.getElementById('mds-panel').style.display = 'none';
  document.getElementById('mds-trigger').style.borderColor = '';
  updateMDSTags();
}
function getMDSFromForm() {
  try { return JSON.parse(document.getElementById('f-depts-json').value || '[]'); } catch(e){ return []; }
}
function setMDSValue(arr) {
  _mdsSelected = arr;
  document.getElementById('f-depts-json').value = JSON.stringify(arr);
  updateMDSTags();
}
function toggleMDSItem(dept) {
  const idx = _mdsSelected.indexOf(dept);
  if(idx >= 0) _mdsSelected.splice(idx, 1);
  else _mdsSelected.push(dept);
  document.getElementById('f-depts-json').value = JSON.stringify(_mdsSelected);
  renderMDSPanel();
  updateMDSTags();
}
function renderMDSPanel() {
  const panel = document.getElementById('mds-options'); if(!panel) return;
  panel.innerHTML = L.depts.map(d => {
    const sel = _mdsSelected.includes(d);
    return `<div onclick="toggleMDSItem('${h(d)}')"
      style="padding:7px 10px;cursor:pointer;border-radius:5px;display:flex;align-items:center;gap:8px;
             background:${sel?'rgba(0,191,165,.12)':'transparent'};">
      <div style="width:16px;height:16px;border-radius:3px;border:2px solid ${sel?'var(--corp-teal)':'var(--border2)'};
                  background:${sel?'var(--corp-teal)':'transparent'};display:flex;align-items:center;justify-content:center;">
        ${sel?'<span style="color:#fff;font-size:10px;font-weight:800;">✓</span>':''}
      </div>
      <span style="font-size:12px;color:${sel?'var(--corp-teal)':'var(--text)'};">${h(d)}</span>
    </div>`;
  }).join('');
}
function updateMDSTags() {
  const container = document.getElementById('mds-tags'); if(!container) return;
  if(!_mdsSelected.length) {
    container.innerHTML = '<span style="color:var(--text3);font-size:11px;">Click to select departments…</span>';
  } else {
    container.innerHTML = _mdsSelected.map(d =>
      `<span style="display:inline-flex;align-items:center;gap:3px;background:rgba(0,191,165,.12);
         color:var(--corp-teal);border:1px solid rgba(0,191,165,.3);border-radius:4px;
         padding:2px 7px;font-size:11px;font-weight:600;">
        ${h(d)}
        <span onclick="toggleMDSItem('${h(d)}')" style="cursor:pointer;opacity:.7;font-size:12px;line-height:1;">✕</span>
      </span>`
    ).join(' ');
  }
}
document.addEventListener('click', function(e) {
  const panel = document.getElementById('mds-wrap');
  if(_mdsOpen && panel && !panel.contains(e.target)) closeMDS();
});

// ── Multi-Person Selector State ───────────────────────────
let _mpsPersonOpen     = false;
let _mpsPersonSelected = [];

function openMPSPerson() {
  _mpsPersonOpen = true;
  _mpsPersonSelected = getMPSPersonFromForm();
  renderMPSPersonPanel();
  // Position panel using screen coordinates — bypasses modal overflow:hidden
  const trigger = document.getElementById('mpsp-tags');
  const panel   = document.getElementById('mpsp-panel');
  if(trigger && panel) {
    const rect = trigger.getBoundingClientRect();
    panel.style.top    = Math.min(rect.bottom + 4, window.innerHeight - 360) + 'px';
    panel.style.left   = rect.left + 'px';
    panel.style.width  = Math.max(rect.width, 280) + 'px';
    panel.style.display = 'flex';
  }
}
function closeMPSPerson() {
  _mpsPersonOpen = false;
  document.getElementById('mpsp-panel').style.display = 'none';
  updateMPSPersonTags();
}
function getMPSPersonFromForm() {
  try { return JSON.parse(document.getElementById('f-persons-json').value || '[]'); } catch(e){ return []; }
}
function setMPSPersonValue(arr) {
  _mpsPersonSelected = arr;
  document.getElementById('f-persons-json').value = JSON.stringify(arr);
  updateMPSPersonTags();
}
function toggleMPSPersonItem(name) {
  const idx = _mpsPersonSelected.indexOf(name);
  if(idx >= 0) _mpsPersonSelected.splice(idx, 1);
  else _mpsPersonSelected.push(name);
  document.getElementById('f-persons-json').value = JSON.stringify(_mpsPersonSelected);
  renderMPSPersonPanel();
  updateMPSPersonTags();
}
function renderMPSPersonPanel() {
  const panel = document.getElementById('mpsp-options'); if(!panel) return;
  const srch  = (document.getElementById('mpsp-search')?.value||'').toLowerCase();
  const active = employees.filter(e => e.status !== 'Inactive' && (!srch || e.name.toLowerCase().includes(srch) || (e.designation||'').toLowerCase().includes(srch)));
  const dirs   = active.filter(e => e.isDirector);
  const others = active.filter(e => !e.isDirector);
  let html = '';
  if(dirs.length) {
    html += '<div style="font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);padding:6px 10px 3px;">★ Directors</div>';
    html += dirs.map(e => personOption(e)).join('');
    html += '<div style="height:1px;background:var(--border);margin:4px 0;"></div>';
  }
  if(others.length) {
    html += '<div style="font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);padding:6px 10px 3px;">── Employees</div>';
    html += others.map(e => personOption(e)).join('');
  }
  panel.innerHTML = html || '<div style="padding:10px;color:var(--text3);font-size:11px;">No employees found. Add employees first.</div>';
}
function personOption(e) {
  const sel = _mpsPersonSelected.includes(e.name);
  const dsg = e.designation ? ' · ' + e.designation.slice(0,20) : '';
  return `<div onclick="toggleMPSPersonItem('${h(e.name)}')"
    style="padding:7px 10px;cursor:pointer;border-radius:5px;display:flex;align-items:center;gap:8px;
           background:${sel?'rgba(0,191,165,.1)':'transparent'};">
    <div style="width:16px;height:16px;border-radius:3px;border:2px solid ${sel?'var(--corp-teal)':'var(--border2)'};
                background:${sel?'var(--corp-teal)':'transparent'};display:flex;align-items:center;justify-content:center;flex-shrink:0;">
      ${sel?'<span style="color:#fff;font-size:10px;font-weight:800;">✓</span>':''}
    </div>
    <div>
      <div style="font-size:12px;color:${sel?'var(--corp-teal)':'var(--text)'};">${h(e.name)}</div>
      ${dsg?`<div style="font-size:9px;color:var(--text3);">${h(dsg)}</div>`:''}
    </div>
  </div>`;
}
function updateMPSPersonTags() {
  const c = document.getElementById('mpsp-tags'); if(!c) return;
  if(!_mpsPersonSelected.length) {
    c.innerHTML = '<span style="color:var(--text3);font-size:11px;">Click to select concerned persons…</span>';
  } else {
    c.innerHTML = _mpsPersonSelected.map(n =>
      `<span style="display:inline-flex;align-items:center;gap:3px;background:rgba(126,87,194,.12);
         color:#7E57C2;border:1px solid rgba(126,87,194,.3);border-radius:4px;
         padding:2px 7px;font-size:11px;font-weight:600;">
        ${h(n)}
        <span onclick="toggleMPSPersonItem('${h(n)}')" style="cursor:pointer;opacity:.7;font-size:12px;line-height:1;">✕</span>
      </span>`
    ).join(' ');
  }
}
document.addEventListener('click', function(e) {
  const p = document.getElementById('mpsp-wrap');
  if(_mpsPersonOpen && p && !p.contains(e.target)) closeMPSPerson();
});


// ── Inline dept picker (in task table) ────────────────────────────
function openInlineDeptPicker(taskId, el) {
  // Build a floating checkbox panel
  const t = tasks.find(x=>x.id===taskId); if(!t) return;
  const current = getTaskDepts(t);
  let selected  = [...current];

  const panel = document.createElement('div');
  panel.style.cssText = 'position:fixed;z-index:9000;background:var(--surface);border:1px solid var(--border2);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.35);min-width:220px;max-height:300px;overflow-y:auto;padding:6px;';
  const rect = el.getBoundingClientRect();
  panel.style.top  = Math.min(rect.bottom+4, window.innerHeight-320) + 'px';
  panel.style.left = rect.left + 'px';

  function buildPanel() {
    panel.innerHTML = L.depts.map(d => {
      const sel = selected.includes(d);
      return `<div onclick="__toggleD('${h(d)}')"
        style="padding:7px 10px;cursor:pointer;border-radius:5px;display:flex;align-items:center;gap:8px;background:${sel?'rgba(0,191,165,.1)':'transparent'};">
        <div style="width:15px;height:15px;border-radius:3px;border:2px solid ${sel?'var(--corp-teal)':'var(--border2)'};background:${sel?'var(--corp-teal)':'transparent'};display:flex;align-items:center;justify-content:center;flex-shrink:0;">${sel?'<span style="color:#fff;font-size:9px;">✓</span>':''}</div>
        <span style="font-size:11px;color:${sel?'var(--corp-teal)':'var(--text)'};">${h(d)}</span>
      </div>`;
    }).join('') +
    `<div style="padding:6px 10px;border-top:1px solid var(--border);display:flex;gap:6px;justify-content:flex-end;margin-top:4px;">
      <button class="btn btn-ghost btn-sm" onclick="__closeDeptPanel()">Cancel</button>
      <button class="btn btn-primary btn-sm" onclick="__saveDeptPanel('${taskId}')">Save ✓</button>
    </div>`;
  }

  window.__toggleD = d => {
    const i = selected.indexOf(d);
    if(i>=0) selected.splice(i,1); else selected.push(d);
    buildPanel();
  };
  window.__saveDeptPanel = taskId2 => {
    const idx2 = tasks.findIndex(x=>x.id===taskId2);
    if(idx2>=0){
      tasks[idx2].depts = selected;
      tasks[idx2].dept  = selected[0]||'';
      tasks[idx2].lastUpdate = todayStr();
      addActivityLog('update','task',taskId2,'Departments updated: '+selected.join(', '));
      saveTasks(); renderAll();
    }
    __closeDeptPanel();
    showGreenSaved('Departments saved');
  };
  window.__closeDeptPanel = () => { panel.remove(); delete window.__toggleD; delete window.__saveDeptPanel; delete window.__closeDeptPanel; };

  buildPanel();
  document.body.appendChild(panel);
  // Close on outside click
  setTimeout(() => {
    document.addEventListener('click', function outsideClick(e) {
      if(!panel.contains(e.target)&&e.target!==el&&!el.contains(e.target)) { window.__closeDeptPanel?.(); document.removeEventListener('click',outsideClick); }
    });
  }, 50);
}

// ── Inline person picker (in task table) ──────────────────────────
function openInlinePersonPicker(taskId, el) {
  const t = tasks.find(x=>x.id===taskId); if(!t) return;
  const current = getTaskPersons(t);
  let selected  = [...current];
  const active  = employees.filter(e => e.status !== 'Inactive');
  const dirs    = active.filter(e => e.isDirector);
  const others  = active.filter(e => !e.isDirector);

  const panel = document.createElement('div');
  panel.style.cssText = 'position:fixed;z-index:9000;background:var(--surface);border:1px solid var(--border2);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.35);min-width:260px;max-height:340px;display:flex;flex-direction:column;';
  const rect = el.getBoundingClientRect();
  panel.style.top  = Math.min(rect.bottom+4, window.innerHeight-360) + 'px';
  panel.style.left = rect.left + 'px';

  function personRow(e) {
    const sel = selected.includes(e.name);
    const dsg = e.designation ? ' · '+e.designation.slice(0,18) : '';
    return `<div onclick="__toggleP('${h(e.name)}')"
      style="padding:7px 10px;cursor:pointer;border-radius:5px;display:flex;align-items:center;gap:8px;background:${sel?'rgba(126,87,194,.1)':'transparent'};">
      <div style="width:15px;height:15px;border-radius:3px;border:2px solid ${sel?'#7E57C2':'var(--border2)'};background:${sel?'#7E57C2':'transparent'};display:flex;align-items:center;justify-content:center;flex-shrink:0;">${sel?'<span style="color:#fff;font-size:9px;">✓</span>':''}</div>
      <div><div style="font-size:11px;color:${sel?'#7E57C2':'var(--text)'};">${h(e.name)}</div>${dsg?`<div style="font-size:9px;color:var(--text3);">${h(dsg)}</div>`:''}</div>
    </div>`;
  }

  function buildPanel() {
    let body = '<div style="overflow-y:auto;flex:1;padding:6px;">';
    if(dirs.length) {
      body += '<div style="font-size:9px;font-weight:800;text-transform:uppercase;color:var(--text3);padding:4px 10px;">★ Directors</div>';
      body += dirs.map(personRow).join('');
    }
    if(others.length) {
      body += '<div style="font-size:9px;font-weight:800;text-transform:uppercase;color:var(--text3);padding:4px 10px;border-top:1px solid var(--border);margin-top:4px;">── Employees</div>';
      body += others.map(personRow).join('');
    }
    body += '</div>';
    body += `<div style="padding:6px 10px;border-top:1px solid var(--border);display:flex;gap:6px;justify-content:flex-end;flex-shrink:0;">
      <button class="btn btn-ghost btn-sm" onclick="__closePersonPanel()">Cancel</button>
      <button class="btn btn-primary btn-sm" onclick="__savePersonPanel('${taskId}')">Save ✓</button>
    </div>`;
    panel.innerHTML = body;
  }

  window.__toggleP = name => {
    const i = selected.indexOf(name);
    if(i>=0) selected.splice(i,1); else selected.push(name);
    buildPanel();
  };
  window.__savePersonPanel = taskId2 => {
    const idx2 = tasks.findIndex(x=>x.id===taskId2);
    if(idx2>=0){
      tasks[idx2].concernedPersons = selected;
      tasks[idx2].concernedPerson  = selected[0]||'';
      tasks[idx2].lastUpdate = todayStr();
      addActivityLog('update','task',taskId2,'Concerned persons updated: '+selected.join(', '));
      saveTasks(); renderAll();
    }
    __closePersonPanel();
    showGreenSaved('Concerned persons saved');
  };
  window.__closePersonPanel = () => { panel.remove(); delete window.__toggleP; delete window.__savePersonPanel; delete window.__closePersonPanel; };

  buildPanel();
  document.body.appendChild(panel);
  setTimeout(() => {
    document.addEventListener('click', function outsideClick(e) {
      if(!panel.contains(e.target)&&e.target!==el&&!el.contains(e.target)) { window.__closePersonPanel?.(); document.removeEventListener('click',outsideClick); }
    });
  }, 50);
}


// ═══════════════════════════════════════════════════════════════════
// FULL DASHBOARD BACKUP & RESTORE SYSTEM
// Exports/Imports: tasks, archive, employees, projects, notes,
// calendar (all 3 persons), activity log
// ═══════════════════════════════════════════════════════════════════

function exportFullBackup() {
  showSaving();
  const backup = {
    _version:    2,
    _exportedAt: new Date().toISOString(),
    _exportedBy: currentUser?.email || 'director',
    tasks:       tasks       || [],
    archived:    archived    || [],
    employees:   employees   || [],
    projects:    projects    || [],
    notes:       notes       || [],
    calHitendra: _allCalEvents?.hitendra || [],
    calSitendra: _allCalEvents?.sitendra || [],
    calNitendra: _allCalEvents?.nitendra || [],
    auditLog:    auditLog    || [],
  };

  const json = JSON.stringify(backup, null, 2);
  const blob = new Blob([json], {type:'application/json'});
  const a    = document.createElement('a');
  a.href     = URL.createObjectURL(blob);
  a.download = 'FullDashboardBackup_' + todayStr() + '.json';
  a.click();
  URL.revokeObjectURL(a.href);
  showSaved();
  toast('✅ Full backup downloaded — includes tasks, archive, employees, projects, notes, calendars.', 'success');
}

function importFullBackup() {
  const input = document.createElement('input');
  input.type   = 'file';
  input.accept = '.json';
  input.onchange = e => {
    const file = e.target.files[0]; if(!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      try {
        const data = JSON.parse(ev.target.result);

        // Validate it's a full backup
        if(!data._version && !data.tasks && !data.employees) {
          toast('❌ Invalid file. Please use a Full Backup JSON file.','error');
          return;
        }

        const taskCount = (data.tasks||[]).length;
        const empCount  = (data.employees||[]).length;
        const projCount = (data.projects||[]).length;
        const archCount = (data.archived||[]).length;
        const calCount  = (data.calHitendra||[]).length + (data.calSitendra||[]).length + (data.calNitendra||[]).length;

        if(!confirm(
          'Import Full Backup?\n\n' +
          '📋 Tasks: ' + taskCount + '\n' +
          '📦 Archive: ' + archCount + '\n' +
          '👥 Employees: ' + empCount + '\n' +
          '📁 Projects: ' + projCount + '\n' +
          '📅 Calendar events: ' + calCount + '\n\n' +
          'This will REPLACE all current data. Continue?'
        )) return;

        showSaving();

        // Restore all data in memory
        if(data.tasks)      tasks     = data.tasks;
        if(data.archived)   archived  = data.archived;
        if(data.employees)  employees = data.employees;
        if(data.projects)   projects  = data.projects;
        if(data.notes)      notes     = data.notes;

        // Restore calendars
        if(_allCalEvents) {
          if(data.calHitendra) _allCalEvents.hitendra = data.calHitendra;
          if(data.calSitendra) _allCalEvents.sitendra = data.calSitendra;
          if(data.calNitendra) _allCalEvents.nitendra = data.calNitendra;
          calEvents = _allCalEvents[_activeCalPerson] || [];
        }

        // Save everything to Firebase
        saveTasks();
        saveArchive();
        saveProjects();
        saveEmployees();
        saveNotes();
        if(data.calHitendra) saveCalendarForPerson('hitendra', data.calHitendra);
        if(data.calSitendra) saveCalendarForPerson('sitendra', data.calSitendra);
        if(data.calNitendra) saveCalendarForPerson('nitendra', data.calNitendra);

        // Also save to localStorage
        try { lsBackupSave(tasks); } catch(e){}
        try { localStorage.setItem('dcd-archive-backup', JSON.stringify(archived)); } catch(e){}
        try { localStorage.setItem('dcd-projects-backup', JSON.stringify({projects})); } catch(e){}

        // Re-render everything
        renderAll();
        renderArchive();
        renderEmployees();
        renderProjects();
        renderCalSidebar?.();

        showSaved();
        closeRecoveryModal();
        toast('✅ Full backup restored! Tasks: ' + taskCount + ', Employees: ' + empCount + ', Projects: ' + projCount, 'success');

      } catch(err) {
        console.error('Import error:', err);
        toast('❌ Error reading file: ' + err.message, 'error');
      }
    };
    reader.readAsText(file);
  };
  input.click();
}


// ── Dashboard card click → navigate to Task View with filter ─────
function dashCardClick(filterType) {
  // Switch to Task View tab
  showPage('task-view');
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  const tvTab = document.querySelector('[data-tab="task-view"]');
  if(tvTab) tvTab.classList.add('active');

  // Reset all filters first
  const tvSearch   = document.getElementById('tv-search');
  const tvStatus   = document.getElementById('tv-status');
  const tvPriority = document.getElementById('tv-priority');
  const tvEsc      = document.getElementById('tv-escalation');
  const tvDeadline = document.getElementById('tv-deadline');
  if(tvSearch)   tvSearch.value   = '';
  if(tvStatus)   tvStatus.value   = 'All';
  if(tvPriority) tvPriority.value = 'All';
  if(tvEsc)      tvEsc.value      = 'All';
  if(tvDeadline) tvDeadline.value = '';

  const today = todayStr();
  const in7   = new Date(); in7.setDate(in7.getDate()+7);
  const in7s  = dateStr(in7);

  // Apply specific filter based on card clicked
  switch(filterType) {
    case 'active':
      if(tvStatus) tvStatus.value = 'All';
      // Show all non-done non-cancelled
      _dashFilter = t => t.status !== 'Done' && t.status !== 'Cancelled';
      break;
    case 'overdue':
      _dashFilter = t => t.deadline && t.deadline < today && t.status !== 'Done' && t.status !== 'Cancelled';
      break;
    case 'duetoday':
      _dashFilter = t => t.deadline === today && t.status !== 'Done' && t.status !== 'Cancelled';
      break;
    case 'due7':
      _dashFilter = t => t.deadline && t.deadline > today && t.deadline <= in7s && t.status !== 'Done' && t.status !== 'Cancelled';
      break;
    case 'blocked':
      _dashFilter = t => (t.escalation||'').toLowerCase()==='blocked' || (t.dependency||'').trim()!=='';
      break;
    case 'p1':
      _dashFilter = t => (t.priority||'').includes('P1') && t.status !== 'Done' && t.status !== 'Cancelled';
      break;
    case 'done':
      _dashFilter = t => t.status === 'Done';
      break;
    default:
      _dashFilter = null;
  }

  // Show a filter indicator
  const indicator = document.getElementById('tv-filter-indicator');
  const labels = {
    active:'Active Tasks', overdue:'Overdue Tasks', duetoday:'Due Today',
    due7:'Due in 7 Days', blocked:'Blocked Tasks', p1:'P1 Critical Tasks', done:'Done This Week'
  };
  if(indicator) {
    indicator.textContent = '🔍 Filtered: ' + (labels[filterType]||filterType);
    indicator.style.display = 'inline-block';
    const clearBtn = document.getElementById('tv-clear-filter');
    if(clearBtn) clearBtn.style.display = 'inline-block';
  }

  renderTaskView();
}

// Global dashboard filter (applied in renderTaskView)
let _dashFilter = null;

function initFirebase() {
  hideLoadingOverlay();
  if(!isConfigured()){ showEl('setup-banner'); showScreen('auth'); return; }
  if(isLoggedIn()){
    currentUser = { email: savedEmail, displayName: savedName };
    setUserChip(currentUser);
    resolveUserRole();   // ← CRITICAL: resolve role BEFORE showing app
    applyRoleToUI();     // ← apply permissions to UI
    showScreen('app');
    startDB();
    setTimeout(fitToScreen, 300);
  } else {
    showScreen('auth');
  }
}

function startDB() {
  setConn('wait','Connecting…');
  // Initial load
  loadAllFromDB(true);
  // Fast 2-second polling so other users' changes appear quickly
  if(pollTimer) clearInterval(pollTimer);
  pollTimer = setInterval(() => loadAllFromDB(false), 8000); /* 8-second poll */ if(false) setInterval(()=>{},  2000);
  // Excel auto-backup every 30 seconds
  startExcelBackupTimer();
  // Load personal calendar (Directors only)
  loadCalendar();
  startCalendarPolling();
  // Start reminder checker
  startReminderChecker();
}

function loadAllFromDB(initial) {
  withToken(token => {
    // ── TASKS ─────────────────────────────────────────────
    fetch(DB_TASKS + '?auth=' + token)
    .then(r => {
      if(r.status === 401 || r.status === 403) { handleFirebasePermissionError(r.status,'read tasks'); return null; }
      if(!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(data => {
      if(data === null || data === undefined) return;
      const rawArr = Array.isArray(data) ? data
                   : (typeof data === 'object' ? Object.values(data) : []);

      // Migrate any Done tasks found in tasks endpoint → archive
      const doneTasks   = rawArr.filter(t => t.status === 'Done');
      const activeTasks = rawArr.filter(t => t.status !== 'Done');
      if(doneTasks.length > 0) {
        doneTasks.forEach(t => {
          if(!archived.find(a => a.id === t.id)) {
            t.archivedAt = t.archivedAt || new Date().toISOString();
            archived.unshift(t);
          }
        });
        saveArchive();
        // Save active-only tasks back to Firebase (one-time migration)
        if(!fbReady) saveTasks(activeTasks, true);
      }

      // Guard: never replace real data with empty
      if(activeTasks.length === 0 && (tasks.length > 0 || fbReady)) {
        setConn('live','Live'); return;
      }
      // First-time empty DB → seed once
      if(activeTasks.length === 0 && !fbReady && lsBackup().length === 0) {
        safeSeedOnce(); return;
      }

      // Only re-render if data actually changed (prevents unnecessary flicker)
      const newSnap = JSON.stringify(activeTasks);
      if(newSnap !== JSON.stringify(tasks)) {
        tasks = activeTasks;
        lsBackupSave(tasks);
        renderAll();
        updateArchiveNavCount();
      }
      fbReady = true;
      setConn('live','Live');
      hideFirebaseError();
    })
    .catch(e => {
      setConn('err','Offline');
      if(initial) tryRestoreFromLocalStorage();
    });

    // ── PROJECTS ──────────────────────────────────────────
    fetch(DB_PROJECTS + '?auth=' + token)
    .then(r => { if(!r.ok) return null; return r.json(); })
    .then(data => {
      if(!data) return;
      const loaded = Array.isArray(data) ? data : Object.values(data);
      if(JSON.stringify(loaded) !== JSON.stringify(projects)) {
        projects = loaded; populateProjectDropdown(); renderProjects(); renderProjSummary(); updateMPSTags();
      }
    }).catch(() => {});

    // ── EMPLOYEES ─────────────────────────────────────────
    fetch(DB_EMPLOYEES + '?auth=' + token)
    .then(r => { if(!r.ok) return null; return r.json(); })
    .then(data => {
      if(!data) return;
      const loaded = Array.isArray(data) ? data : Object.values(data);
      if(JSON.stringify(loaded) !== JSON.stringify(employees)) {
        employees = loaded;
        renderEmployees(); populateCPDropdown(); refreshEmpFilters();
        populateQNoteEmployeeDropdown();
        resolveUserRole(); applyRoleToUI();
      }
    }).catch(() => {});

    // ── NOTES ─────────────────────────────────────────────
    fetch(DB_NOTES + '?auth=' + token)
    .then(r => { if(!r.ok) return null; return r.json(); })
    .then(data => {
      if(!data) return;
      const loaded = Array.isArray(data) ? data : Object.values(data);
      if(JSON.stringify(loaded) !== JSON.stringify(notes)) { notes = loaded; renderNotes(); }
    }).catch(() => { try { const b = localStorage.getItem('dcd-notes-backup'); if(b) { notes = JSON.parse(b); renderNotes(); } } catch(_) {} });

    // ── ARCHIVE ───────────────────────────────────────────
    fetch(DB_ARCHIVE + '?auth=' + token)
    .then(r => { if(!r.ok) return null; return r.json(); })
    .then(data => {
      if(!data) return;
      const loaded = Array.isArray(data) ? data : Object.values(data);
      if(JSON.stringify(loaded) !== JSON.stringify(archived)) {
        archived = loaded; renderArchive(); updateArchiveNavCount();
      }
    }).catch(() => { try { const b = localStorage.getItem('dcd-archive-backup'); if(b) { archived = JSON.parse(b); renderArchive(); } } catch(_) {} });
  });
}


function saveEmployees() {
  withToken(token=>{
    fetch(DB_EMPLOYEES+'?auth='+token,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(employees)})
    .then(r=>{ if(!r.ok)throw new Error('HTTP '+r.status); return r.json(); })
    .then(()=>{ showGreenSaved('Employee saved'); renderEmployees(); populateCPDropdown(); refreshEmpFilters(); populateQNoteEmployeeDropdown(); addAuditLog('save','employees','*','Employee list updated'); renderCapture(); renderTaskView();
        if(hasFullAccess()||getCalPersonForUser()) { loadCalendar(); applyCalendarPersonAccess(); }
        })
    .catch(e=>toast('Employee save failed: '+e.message,'error'));
  });
}

function saveTasks(override, silent) {
  const data = override !== undefined ? override : tasks;
  if(!Array.isArray(data)) { console.warn('saveTasks: not an array'); return; }
  if(data.length === 0 && fbReady && tasks.length > 0 && override === undefined) {
    console.warn('saveTasks: blocked empty-array overwrite'); return;
  }
  const rollbackSnap = JSON.stringify(tasks);
  if(!silent) showSaving();

  // OPTIMISTIC: update local state and render immediately (instant UI feedback)
  if(override !== undefined) { tasks = data; fbReady = true; }
  renderAll();

  withToken(token => {
    fetch(DB_TASKS + '?auth=' + token, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(override !== undefined ? override : tasks)
    })
    .then(r => {
      if(r.status === 401 || r.status === 403) {
        handleFirebasePermissionError(r.status, 'write tasks'); return null;
      }
      if(!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(resp => {
      if(resp === null) return;
      if(!silent) showSaved();
      lsBackupSave(override !== undefined ? override : tasks);
      updateExcelSnapshot();
      // Force a fresh load from Firebase to stay in sync (skip if user is typing)
      if(!_pollPausedByTyping) setTimeout(() => loadAllFromDB(false), 500);
    })
    .catch(e => {
      // Rollback to pre-save state
      try { tasks = JSON.parse(rollbackSnap); } catch(_) {}
      showSaveError(e.message);
      renderAll();
    });
  });
}


function saveProjects() {
  showSaving();
  withToken(token=>{
    fetch(DB_PROJECTS+'?auth='+token,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(projects)})
    .then(r=>{ if(!r.ok)throw new Error('HTTP '+r.status); return r.json(); })
    .then(()=>{
      showGreenSaved('Project saved');
      try { localStorage.setItem('dcd-projects-backup', JSON.stringify({projects, savedAt:new Date().toISOString()})); } catch(e){}
      populateProjectDropdown(); renderProjects(); renderProjSummary();
    })
    .catch(e=>{ showSaveError(e.message); });
  });
}

// ── SEED DATA ─────────────────────────────────────────────────
const SEED_TASKS = [
  {id:'T-0001',captureDate:'2026-05-22',task:'Create daily project review report format',dept:'Projects',projects:['P-001'],concernedPerson:'',taskType:'Report',taskTypeOther:'',deptOther:'',priority:'P1 - Critical',status:'In Progress',owner:'Project Head',ownerOther:'',assignedBy:'Director',deadline:'2026-05-23',followup:'2026-05-23',followupRecurrence:'None',followupCustomDays:'',nextAction:'Get open issues by 9 AM',dependency:'Need inputs from project leads',lastUpdate:'',remarks:'Sample row',closedDate:'',createdBy:''},
  {id:'T-0002',captureDate:'2026-05-22',task:'Prepare proposal calendar and responsibility matrix',dept:'Proposals',projects:['P-002'],concernedPerson:'',taskType:'Follow-up',taskTypeOther:'',deptOther:'',priority:'P1 - Critical',status:'Not Started',owner:'Proposal Owner',ownerOther:'',assignedBy:'Director',deadline:'2026-05-24',followup:'2026-05-23',followupRecurrence:'Weekly',followupCustomDays:'',nextAction:'List active proposals with due dates',dependency:'',lastUpdate:'',remarks:'Sample row',closedDate:'',createdBy:''},
  {id:'T-0003',captureDate:'2026-05-22',task:'Build weekly finance review checklist',dept:'Finance',projects:[],concernedPerson:'',taskType:'Review',taskTypeOther:'',deptOther:'',priority:'P1 - Critical',status:'Waiting',owner:'Finance Head',ownerOther:'',assignedBy:'Director',deadline:'2026-05-23',followup:'2026-05-23',followupRecurrence:'Monthly',followupCustomDays:'',nextAction:'Share receivables and payables',dependency:'Awaiting bank balance',lastUpdate:'',remarks:'Sample row',closedDate:'',createdBy:''},
];

// ── DATE & CALC HELPERS ───────────────────────────────────────
function today() {
  // Returns midnight in LOCAL timezone (not UTC) to avoid date-shifting
  const d = new Date();
  return new Date(d.getFullYear(), d.getMonth(), d.getDate());
}
function todayStr() {
  // Uses LOCAL date components — safe for all timezones including IST (UTC+5:30)
  const d = new Date();
  return d.getFullYear() + '-' +
    String(d.getMonth() + 1).padStart(2, '0') + '-' +
    String(d.getDate()).padStart(2, '0');
}
function parseDate(s) { if(!s)return null; const d=new Date(s); return isNaN(d)?null:new Date(d.toDateString()); }
function fmtDate(s)   { const d=parseDate(s); if(!d)return'—'; return d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}); }
function sowk()       { const d=today(),dy=d.getDay(),sub=dy===0?6:dy-1; return new Date(d-sub*86400000); }
function eowk()       { return new Date(sowk().getTime()+6*86400000); }
function isOpen(t)    { return t.status!=='Done'&&t.status!=='Cancelled'; }
function calcAge(t)   { const c=parseDate(t.captureDate); return c?Math.floor((today()-c)/86400000):0; }
function calcLeft(t)  { const d=parseDate(t.deadline); return d?Math.floor((d-today())/86400000):null; }
function calcEsc(t) {
  if(!isOpen(t))return'—';
  if(t.status==='Blocked')return'Escalate';
  const dl=calcLeft(t); if(dl===null)return'Normal';
  if(dl<0)return'Overdue'; if(dl===0)return'Due Today'; if(dl<=2)return'Due Soon';
  if(t.priority==='P1 - Critical'&&dl<=10)return'Watch';
  return'Normal';
}

function calcNextFollowup(dateStr, recurrence, customDays) {
  if(!dateStr||!recurrence||recurrence==='None')return null;
  const d=new Date(dateStr);
  const days=recurrence==='Custom'?parseInt(customDays||7):(RECUR_DAYS[recurrence]||7);
  d.setDate(d.getDate()+days);
  return d.toISOString().slice(0,10);
}

// ── AGGREGATION ───────────────────────────────────────────────
function calcKpis(list) {
  const t=today(),t7=new Date(t.getTime()+7*86400000),ws=sowk(),we=eowk();
  let ac=0,ov=0,dt=0,d7=0,bl=0,p1=0,dw=0;
  list.forEach(k=>{
    const dl=parseDate(k.deadline);
    if(isOpen(k)){ ac++; if(dl){if(dl<t)ov++;else if(+dl===+t)dt++;else if(dl<=t7)d7++;} if(k.status==='Blocked')bl++; if(k.priority==='P1 - Critical')p1++; }
  });
  // Done This Week: count from archived array
  archived.forEach(k=>{
    const cd=parseDate(k.closedDate||k.archivedAt?.slice(0,10)||'');
    if(cd&&cd>=ws&&cd<=we)dw++;
  });
  return{ac,ov,dt,d7,bl,p1,dw};
}


function calcDeptSummary(list) {
  const t=today(),t7=new Date(t.getTime()+7*86400000),ws=sowk(),we=eowk();
  const rows={};
  L.depts.forEach(d=>rows[d]={dept:d,tot:0,open:0,ov:0,d7:0,bl:0,wt:0,p1:0,dn:0});
  list.forEach(k=>{
    const r=rows[k.dept]||rows['Other'],dl=parseDate(k.deadline),cd=parseDate(k.closedDate);
    r.tot++;
    if(isOpen(k)){ r.open++; if(dl){if(dl<t)r.ov++;else if(dl<=t7)r.d7++;} if(k.status==='Blocked')r.bl++; if(k.status==='Waiting')r.wt++; if(k.priority==='P1 - Critical')r.p1++; }
    if(k.status==='Done'&&cd&&cd>=ws&&cd<=we)r.dn++;
  });
  return L.depts.map(d=>({...rows[d],action:sugAction(rows[d])}));
}

function calcProjSummary(list) {
  const t=today(),t7=new Date(t.getTime()+7*86400000);
  const rows={};
  projects.forEach(p=>rows[p.projectNo]={proj:p.projectNo,name:p.projectName,client:p.clientName,pStatus:p.status,tot:0,open:0,ov:0,d7:0,bl:0,p1:0,next:null});
  // Also include projects referenced in tasks but not in projects array
  list.forEach(k=>{ getTaskProjects(k).forEach(pno=>{ if(pno&&!rows[pno])rows[pno]={proj:pno,name:'',client:'',pStatus:'',tot:0,open:0,ov:0,d7:0,bl:0,p1:0,next:null}; }); });
  list.forEach(k=>{
    getTaskProjects(k).forEach(pno=>{
      const r=rows[pno]; if(!r)return;
      const dl=parseDate(k.deadline);
      r.tot++;
      if(isOpen(k)){ r.open++; if(dl){if(dl<t)r.ov++;else if(dl<=t7)r.d7++;if(!r.next||dl<r.next)r.next=dl;} if(k.status==='Blocked')r.bl++; if(k.priority==='P1 - Critical')r.p1++; }
    }); // end pno forEach
  });  // end list forEach
  return Object.values(rows).map(r=>({...r,action:sugActionProj(r)}));
}

function calcOwnerSummary(list) {
  const t=today(),t7=new Date(t.getTime()+7*86400000),ws=sowk(),we=eowk();
  const rows={};
  L.owners.forEach(o=>rows[o]={owner:o,tot:0,open:0,ov:0,d7:0,bl:0,wt:0,p1:0,dn:0});
  list.forEach(k=>{
    const r=rows[k.owner]||rows['Other'],dl=parseDate(k.deadline),cd=parseDate(k.closedDate);
    r.tot++;
    if(isOpen(k)){ r.open++; if(dl){if(dl<t)r.ov++;else if(dl<=t7)r.d7++;} if(k.status==='Blocked')r.bl++; if(k.status==='Waiting')r.wt++; if(k.priority==='P1 - Critical')r.p1++; }
    if(k.status==='Done'&&cd&&cd>=ws&&cd<=we)r.dn++;
  });
  return L.owners.map(o=>({...rows[o],action:sugAction(rows[o])}));
}

function sugAction(r) { if(r.bl>0)return'Escalate blocked'; if(r.wt>0)return'Need decision'; if(r.p1>0)return'Review P1'; if(r.open>0)return'Monitor'; return'Normal'; }
function sugActionProj(r) { if(r.bl>0)return'Escalate blocked'; if(r.p1>0)return'Review P1'; if(r.open>0)return'Monitor'; if(r.tot>0)return'Normal'; return'—'; }

// ── BADGE HELPERS ─────────────────────────────────────────────
function h(s){return s?String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'):''}
function bStatus(s){
  const cfg={
    'Not Started': {cls:'st-notstarted', icon:'⏱', label:'Not Started'},
    'In Progress': {cls:'st-inprogress', icon:'🔄', label:'In Progress'},
    'Waiting':     {cls:'st-waiting',    icon:'⏸',  label:'Waiting'},
    'Blocked':     {cls:'st-blocked',    icon:'🔴', label:'Blocked'},
    'Done':        {cls:'st-done',       icon:'✅', label:'Done'},
    'Cancelled':   {cls:'st-cancelled',  icon:'✕',  label:'Cancelled'},
  };
  const c=cfg[s]||{cls:'st-notstarted',icon:'•',label:s||'—'};
  return `<span class="st-badge ${c.cls}">${c.icon} ${c.label}</span>`;
}


function bPri(p){if(!p)return'<span class="c-gray">—</span>';const m={'P1 - Critical':'p1','P2 - High':'p2','P3 - Medium':'p3','P4 - Low':'p4'};return`<span class="badge ${m[p]||''}">${p}</span>`;}
function bAction(a){const m={'Escalate blocked':'a-esc','Escalate':'a-esc','Need decision':'a-dec','Review P1':'a-rev','Monitor':'a-mon','Normal':'a-nor','—':'a-nor'};return`<span class="badge ${m[a]||'a-nor'}">${a||'—'}</span>`;}
function bEsc(e){const m={'Escalate':'b-red','Overdue':'b-red','Due Today':'b-amber','Due Soon':'b-orange','Watch':'b-purple','Normal':'b-gray','—':'b-gray'};return`<span class="badge ${m[e]||'b-gray'}">${e||'—'}</span>`;}
function bProjStatus(s){const m={'Planning':'ps-planning','Active':'ps-active','On Hold':'ps-hold','Completed':'ps-completed','Cancelled':'ps-cancelled'};return`<span class="badge ${m[s]||'b-gray'}">${s||'—'}</span>`;}
function bRecur(r){if(!r||r==='None')return'<span class="c-gray sm">—</span>';return`<span class="recur-badge">↻ ${r}</span>`;}
function nCell(n,cls=''){return n===0?`<td class="num c-gray">0</td>`:`<td class="num ${cls}" style="font-weight:700;">${n}</td>`;}

// ── RENDER FUNCTIONS ──────────────────────────────────────────

// ── Smart render: only render the active page + dashboard KPIs ──
let _renderDebounceTimer = null;
function renderAll() {
  // Debounce: skip if another renderAll is queued within 150ms
  if(_renderDebounceTimer) clearTimeout(_renderDebounceTimer);
  _renderDebounceTimer = setTimeout(_doRenderAll, 150);
}
function _doRenderAll() {
  // Always update dashboard KPIs (they're shown on every page in header)
  renderDashboard();
  // Only render the currently visible page — skip the rest
  const activeTab = document.querySelector('.nav-tab.active');
  const tabId = activeTab ? activeTab.dataset.tab : '';
  if(tabId==='task-capture')    renderCapture();
  else if(tabId==='task-view')  renderTaskView();
  else if(tabId==='dept-summary') renderDeptSummary();
  else if(tabId==='project-summary') renderProjSummary();
  else if(tabId==='owner-summary') renderOwnerSummary();
  else if(tabId==='archive')    renderArchive();
  else {
    // Default: render both task pages (for polling updates)
    renderCapture(); renderTaskView();
  }
  // Don't call generateExcelBlob() on every render — it's very heavy
  // Excel is generated on-demand when user clicks Export
}


function renderDashboard() {
  const k=calcKpis(tasks);
  const cards=[
    {lbl:'Active Tasks',val:k.ac,sub:'Open & in-progress',kc:'var(--blue)'},
    {lbl:'Overdue',val:k.ov,sub:'Past deadline',kc:'var(--red)'},
    {lbl:'Due Today',val:k.dt,sub:'Deadline = today',kc:'var(--amber)'},
    {lbl:'Due in 7 Days',val:k.d7,sub:'Coming up soon',kc:'var(--teal)'},
    {lbl:'Blocked',val:k.bl,sub:'Needs intervention',kc:'var(--orange)'},
    {lbl:'P1 Open',val:k.p1,sub:'Critical priority',kc:'var(--purple)'},
    {lbl:'Done This Week',val:k.dw,sub:'Closed this week',kc:'var(--green)'},
  ];
  const filterKeys=['active','overdue','duetoday','due7','blocked','p1','done'];
  document.getElementById('kpi-grid').innerHTML=cards.map((c,i)=>`<div class="kpi-card" style="--kc:${c.kc};cursor:pointer;" 
    onclick="_dashFilter=null;dashCardClick('${filterKeys[i]}')" 
    onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 24px rgba(0,0,0,.3)'" 
    onmouseout="this.style.transform='';this.style.boxShadow=''">
    <div class="kpi-label">${c.lbl}</div>
    <div class="kpi-value">${c.val}</div>
    <div class="kpi-sub">${c.sub}</div>
    <div style="font-size:9px;color:var(--kc);margin-top:4px;opacity:.7;">Click to view →</div>
  </div>`).join('');

  document.querySelector('#dash-dept-tbl tbody').innerHTML=calcDeptSummary(tasks).map(r=>`<tr><td style="font-weight:600;color:${(r.bl||r.ov||r.p1)?'var(--text)':'var(--text2)'};">${r.dept}</td>${nCell(r.open)}${nCell(r.ov,'c-red')}${nCell(r.d7,'c-amber')}${nCell(r.bl,'c-red')}${nCell(r.wt,'c-amber')}${nCell(r.p1,'c-purple')}<td>${bAction(r.action)}</td></tr>`).join('');

  const ps=calcProjSummary(tasks).filter(r=>r.tot>0||projects.find(p=>p.projectNo===r.proj)).slice(0,10);
  const ptb=document.querySelector('#dash-proj-tbl tbody');
  if(!ps.length){ptb.innerHTML=`<tr><td colspan="9" class="empty-state">No project tasks yet.</td></tr>`;return;}
  ptb.innerHTML=ps.map(r=>`<tr><td class="mono sm" style="color:var(--blue);">${h(r.proj)}</td><td class="sm">${h(r.name)||'—'}</td><td class="sm c-text2">${h(r.client)||'—'}</td>${nCell(r.open)}${nCell(r.ov,'c-red')}${nCell(r.d7,'c-amber')}${nCell(r.bl,'c-red')}${nCell(r.p1,'c-purple')}<td>${bAction(r.action)}</td></tr>`).join('');
}

function renderCapture() {
  const visible = getVisibleTasks();
  const k = calcKpis(visible);
  document.getElementById('cap-kpis').innerHTML=[
    {cls:'ck-blue',val:k.ac,lbl:'Active'},{cls:'ck-red',val:k.ov,lbl:'Overdue'},
    {cls:'ck-amber',val:k.dt,lbl:'Due Today'},{cls:'ck-amber',val:k.d7,lbl:'Due 7D'},
    {cls:'ck-orange',val:k.bl,lbl:'Blocked'},{cls:'ck-purple',val:k.p1,lbl:'P1 Open'},
  ].map(c=>`<div class="cap-kpi ${c.cls}"><span class="cap-kpi-val">${c.val}</span><span class="cap-kpi-lbl">${c.lbl}</span></div>`).join('');
  const thead=document.querySelector('#page-task-capture table thead');
  if(thead) thead.innerHTML=TASK_TABLE_HEADERS;
  const tbody=document.getElementById('capture-tbody');
  if(!visible.length){
    tbody.innerHTML=`<tr><td colspan="24" class="empty-state"><div class="empty-icon">📥</div>No tasks${_userRole==='department'?' for department: '+_userDept:''}. ${canAddTask()?'Click + Add Task.':''}</td></tr>`;
    return;
  }
  tbody.innerHTML=visible.map(t=>buildTaskRow(t,true)).join('');
}



function renderTaskView() {
  const dept    = document.getElementById('tv-dept')?.value||'All';
  const proj    = document.getElementById('tv-proj')?.value||'All';
  const owner   = document.getElementById('tv-owner')?.value||'All';
  const status  = document.getElementById('tv-status')?.value||'All';
  const pri     = document.getElementById('tv-pri')?.value||'All';
  const esc     = document.getElementById('tv-esc')?.value||'All';
  const closed  = document.getElementById('tv-closed')?.value||'All';
  const search  = (document.getElementById('tv-search')?.value||'').toLowerCase();
  const concerned=(document.getElementById('tv-concerned')?.value||'').toLowerCase().trim();
  const dline   = document.getElementById('tv-deadline')?.value||'';

  let base = getVisibleTasks();
  let f = base.filter(t=>{
    if(dept!=='All' && t.dept!==dept) return false;
    if(proj!=='All' && !getTaskProjects(t).includes(proj)) return false;
    if(owner!=='All' && t.owner!==owner) return false;
    if(pri!=='All' && t.priority!==pri) return false;
    if(esc!=='All' && calcEsc(t)!==esc) return false;
    if(concerned && !(t.concernedPerson||'').toLowerCase().includes(concerned)) return false;
    if(search && !(t.task||'').toLowerCase().includes(search) &&
                 !(t.id||'').toLowerCase().includes(search) &&
                 !(t.remarks||'').toLowerCase().includes(search) &&
                 !(t.taskNote||'').toLowerCase().includes(search)) return false;
    if(dline && t.deadline && t.deadline > dline) return false;
    if(status==='Open')   return t.status!=='Done'&&t.status!=='Cancelled';
    if(status==='Closed') return t.status==='Done'||t.status==='Cancelled';
    if(status!=='All' && t.status!==status) return false;
    return true;
  });

  const countEl=document.getElementById('tv-count');
  if(countEl) countEl.textContent=`${f.length} task${f.length!==1?'s':''} (of ${base.length} visible)`;

  const thead=document.querySelector('#page-task-view table thead');
  if(thead) thead.innerHTML=TASK_TABLE_HEADERS;

  const tbody=document.getElementById('view-tbody');
  if(!f.length){
    tbody.innerHTML=`<tr><td colspan="24"><div class="empty-state"><div class="empty-icon">🔍</div>No tasks match the filters.</div></td></tr>`;
    return;
  }
  tbody.innerHTML=f.map(t=>buildTaskRow(t,true)).join('');
  requestAnimationFrame(()=>{  });
}


function renderDeptSummary() {
  document.getElementById('dept-tbody').innerHTML=calcDeptSummary(tasks).map(r=>`<tr><td style="font-weight:600;">${r.dept}</td>${nCell(r.tot)}${nCell(r.open)}${nCell(r.ov,'c-red')}${nCell(r.d7,'c-amber')}${nCell(r.bl,'c-red')}${nCell(r.wt,'c-amber')}${nCell(r.p1,'c-purple')}${nCell(r.dn,'c-green')}<td>${bAction(r.action)}</td></tr>`).join('');
}

function renderProjSummary() {
  const ps=calcProjSummary(tasks);
  const active=ps.filter(r=>r.tot>0||projects.find(p=>p.projectNo===r.proj));
  const empty=ps.filter(r=>r.tot===0&&!projects.find(p=>p.projectNo===r.proj));
  const rows=[...active,...empty];
  document.getElementById('proj-tbody').innerHTML=rows.map(r=>`<tr>
    <td class="mono sm" style="color:var(--blue);">${h(r.proj)}</td>
    <td class="sm">${h(r.name)||'—'}</td>
    <td class="sm c-text2">${h(r.client)||'—'}</td>
    <td>${r.pStatus?bProjStatus(r.pStatus):'<span class="c-gray sm">—</span>'}</td>
    ${nCell(r.tot)}${nCell(r.open)}${nCell(r.ov,'c-red')}${nCell(r.d7,'c-amber')}
    ${nCell(r.bl,'c-red')}${nCell(r.p1,'c-purple')}
    <td class="sm c-text2">${r.next?r.next.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}):'—'}</td>
    <td>${r.tot>0?bAction(r.action):'<span class="c-gray sm">—</span>'}</td>
  </tr>`).join('');
}

function renderOwnerSummary() {
  document.getElementById('owner-tbody').innerHTML=calcOwnerSummary(tasks).map(r=>`<tr><td style="font-weight:600;">${r.owner}</td>${nCell(r.tot)}${nCell(r.open)}${nCell(r.ov,'c-red')}${nCell(r.d7,'c-amber')}${nCell(r.bl,'c-red')}${nCell(r.wt,'c-amber')}${nCell(r.p1,'c-purple')}${nCell(r.dn,'c-green')}<td>${bAction(r.action)}</td></tr>`).join('');
}

// ── PROJECTS PAGE ─────────────────────────────────────────────
function renderProjects() {
  const filterStatus=document.getElementById('pf-status')?.value||'All';
  const badge=document.getElementById('proj-count-badge');
  if(badge) badge.textContent=`${projects.length} project${projects.length!==1?'s':''}`;
  const container=document.getElementById('projects-container');
  if(!container)return;
  let filtered=projects.filter(p=>filterStatus==='All'||p.status===filterStatus);
  if(!filtered.length){
    container.innerHTML=`<div class="empty-state"><div class="empty-icon">📁</div>${projects.length?'No projects match the filter.':'No projects yet. Click <strong>+ New Project</strong> to create one.'}</div>`;
    return;
  }
  const grid=filtered.map(p=>{
    const taskCount=tasks.filter(t=>getTaskProjects(t).includes(p.projectNo)).length;
    const openCount=tasks.filter(t=>getTaskProjects(t).includes(p.projectNo)&&isOpen(t)).length;
    const dur=p.startDate?`${fmtDate(p.startDate)}${p.endDate?' → '+fmtDate(p.endDate):''}`:'' ;
    return `<div class="proj-card">
      <div class="proj-card-header">
        <div>
          <div class="proj-card-num">${h(p.projectNo)}</div>
          <div class="proj-card-name">${h(p.projectName)}</div>
          <div class="proj-card-client">🏢 ${h(p.clientName)}</div>
        </div>
        ${bProjStatus(p.status)}
      </div>
      ${p.description?`<div class="sm c-text2" style="margin-bottom:8px;line-height:1.55;white-space:pre-wrap;word-break:break-word;">${h(p.description)}</div>`:''}
      <div class="proj-card-meta">
        ${dur?`<span>📅 ${h(dur)}</span>`:''}
        <span>📋 ${taskCount} task${taskCount!==1?'s':''}</span>
        <span style="color:var(--blue);">⚡ ${openCount} open</span>
      </div>
      <div class="proj-card-actions">
        <button class="btn btn-ghost btn-sm" onclick="openEditProject('${p.id}')">✏️ Edit</button>
        <button class="btn btn-ghost btn-sm" onclick="showTab('task-capture');openAdd('${p.projectNo}')">+ Task</button>
        <button class="btn btn-danger btn-sm" onclick="confirmDelProject('${p.id}')">🗑 Delete</button>
      </div>
    </div>`;
  }).join('');
  container.innerHTML=`<div class="proj-cards-grid">${grid}</div>`;
}

function getProjLabel(projNo) {
  if(!projNo)return'';
  const p=projects.find(x=>x.projectNo===projNo);
  return p?`${projNo} — ${p.projectName}`:`projNo`;
}

// ── POPULATE DROPDOWNS ────────────────────────────────────────
function populateFilters() {
  function pop(id,opts){ const el=document.getElementById(id); if(!el)return; const cur=el.value; el.innerHTML=`<option>All</option>`+opts.map(o=>`<option>${o}</option>`).join(''); if(opts.includes(cur))el.value=cur; }
  pop('tv-dept',L.depts);
  pop('tv-owner',L.owners);
  pop('tv-status',L.statuses);
  pop('tv-pri',L.pris);
  // Project filter populated from projects array
  populateProjectFilter();
}

function populateProjectFilter() {
  const el=document.getElementById('tv-proj'); if(!el)return;
  const cur=el.value;
  const nums=projects.map(p=>p.projectNo);
  // Also include project numbers from tasks not in projects array
  tasks.forEach(t=>{ getTaskProjects(t).forEach(p=>{if(p&&!nums.includes(p))nums.push(p);}); });
  nums.sort();
  el.innerHTML='<option>All</option>'+nums.map(n=>{ const p=projects.find(x=>x.projectNo===n); return `<option value="${n}">${n}${p?' — '+p.projectName:''}</option>`; }).join('');
  if(nums.includes(cur))el.value=cur;
}

function populateProjectDropdown() {
  populateProjectFilter();
  populateConcernedList();
  // Re-render MPS options if panel is open
  const panel = document.getElementById('mps-panel');
  if (panel && panel.style.display !== 'none') renderMPSOptions();
}

function populateConcernedList() {
  // Legacy — now handled by populateCPDropdown from employee DB
  populateCPDropdown();
}

function populateModalDropdowns() {
  function sel(id,opts,blank){ const el=document.getElementById(id); if(!el)return; el.innerHTML=(blank?`<option value="">— ${blank} —</option>`:'')+opts.map(o=>`<option>${o}</option>`).join(''); }
  sel('f-dept',L.depts,'Select');
  sel('f-tasktype',L.taskTypes,'Select');
  sel('f-pri',L.pris,'Select');
  sel('f-status',L.statuses,'Select');
  sel('f-owner',L.owners,'Select');
  populateConcernedList();
  populateProjectDropdown();
}

// ── "OTHER" FIELD LOGIC ───────────────────────────────────────
function handleOther(selectId, wrapId) {
  const sel=document.getElementById(selectId);
  const wrap=document.getElementById(wrapId);
  if(!sel||!wrap)return;
  const show=sel.value==='Other';
  wrap.classList.toggle('visible',show);
  if(!show){ const inp=wrap.querySelector('input'); if(inp)inp.value=''; }
}

function handleRecurrenceChange() {
  const val=document.getElementById('f-recurrence').value;
  const wrap=document.getElementById('f-custom-days-wrap');
  if(wrap)wrap.style.display=val==='Custom'?'':'none';
}

function updateRecurPreview() {
  const followup=document.getElementById('f-followup-top')?.value || document.getElementById('f-followup')?.value || '';
  const recur=document.getElementById('f-recurrence').value;
  const custom=document.getElementById('f-custom-days').value;
  const preview=document.getElementById('recur-preview');
  if(!preview)return;
  if(!followup||!recur||recur==='None'){preview.textContent='';return;}
  const next=calcNextFollowup(followup,recur,custom);
  if(next) preview.textContent=`↻ Next follow-up after this: ${fmtDate(next)}`;
  else preview.textContent='';
}


// ═══════════════════════════════════════════════════════
// MULTI-PROJECT SELECT COMPONENT
// ═══════════════════════════════════════════════════════
let _selectedProjects = [];  // array of project numbers currently selected

function toggleMPS(e) {
  e.stopPropagation();
  const panel = document.getElementById('mps-panel');
  const trigger = document.getElementById('mps-trigger');
  const isOpen = panel.style.display !== 'none';
  if (isOpen) { closeMPS(); return; }
  panel.style.display = 'block';
  trigger.classList.add('open');
  document.getElementById('mps-search').value = '';
  renderMPSOptions();
  setTimeout(() => document.getElementById('mps-search').focus(), 50);
}

function closeMPS() {
  const panel = document.getElementById('mps-panel');
  const trigger = document.getElementById('mps-trigger');
  if (panel) panel.style.display = 'none';
  if (trigger) trigger.classList.remove('open');
}

function renderMPSOptions() {
  const search = (document.getElementById('mps-search')?.value || '').toLowerCase();
  const container = document.getElementById('mps-options'); if (!container) return;
  const filtered = projects.filter(p =>
    !search ||
    p.projectNo.toLowerCase().includes(search) ||
    (p.projectName||'').toLowerCase().includes(search) ||
    (p.clientName||'').toLowerCase().includes(search)
  );
  if (!filtered.length) {
    container.innerHTML = `<div class="mps-empty">${projects.length ? 'No projects match your search.' : 'No projects created yet. Add projects in the 📁 Projects tab first.'}</div>`;
    return;
  }
  container.innerHTML = filtered.map(p => {
    const checked = _selectedProjects.includes(p.projectNo);
    return `<div class="mps-option${checked?' checked':''}" onclick="toggleMPSItem('${p.projectNo}',this)">
      <input type="checkbox" ${checked?'checked':''} onclick="event.stopPropagation();toggleMPSItem('${p.projectNo}',this.closest('.mps-option'))">
      <span class="mps-option-num">${h(p.projectNo)}</span>
      <div class="mps-option-detail">
        <span class="mps-option-name">${h(p.projectName)}</span>
        <span class="mps-option-client">${h(p.clientName)}</span>
      </div>
    </div>`;
  }).join('');
}

function toggleMPSItem(projNo, el) {
  const idx = _selectedProjects.indexOf(projNo);
  if (idx >= 0) _selectedProjects.splice(idx, 1);
  else _selectedProjects.push(projNo);
  updateMPSTags();
  renderMPSOptions();
}

function updateMPSTags() {
  const container = document.getElementById('mps-tags'); if (!container) return;
  if (!_selectedProjects.length) {
    container.innerHTML = '<span class="mps-placeholder">Click to select projects…</span>';
    return;
  }
  container.innerHTML = _selectedProjects.map(pno => {
    const p = projects.find(x => x.projectNo === pno);
    const label = p ? `${pno} — ${p.projectName}` : pno;
    return `<span class="mps-tag">${h(label)}<span class="mps-tag-remove" onclick="event.stopPropagation();removeMPSItem('${pno}')" title="Remove">✕</span></span>`;
  }).join('');
}

function removeMPSItem(projNo) {
  _selectedProjects = _selectedProjects.filter(p => p !== projNo);
  updateMPSTags();
  renderMPSOptions();
}

function resetMPS() {
  _selectedProjects = [];
  updateMPSTags();
}

function setMPS(arr) {
  _selectedProjects = Array.isArray(arr) ? [...arr] : (arr ? [arr] : []);
  updateMPSTags();
}

// Close MPS when clicking outside
document.addEventListener('click', function(e) {
  const wrapper = document.getElementById('mps-wrapper');
  if (wrapper && !wrapper.contains(e.target)) closeMPS();
});

// ── TASK MODAL ────────────────────────────────────────────────
function nextId() {
  if(!tasks.length)return'T-0001';
  const max=Math.max(...tasks.map(t=>parseInt(t.id.replace('T-',''))||0));
  return'T-'+String(max+1).padStart(4,'0');
}

function openAdd(preselectedProject) {
  editingId=null;
  document.getElementById('modal-title').textContent='Add New Task';
  document.getElementById('f-id').value=nextId();
  document.getElementById('f-cdate').value=todayStr();
  ['f-task','f-next','f-dep','f-remarks'].forEach(id=>document.getElementById(id).value='');
  ['f-followup-top','f-deadline'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';}); 
  const _fdeptClear=document.getElementById('f-dept'); if(_fdeptClear) _fdeptClear.value='';
  if(typeof setMDSValue==='function'){setMDSValue([]);setMPSPersonValue([]);}
  setCPValue('');
  resetMPS();
  const tnEl=document.getElementById('f-tasknote'); if(tnEl) tnEl.value='';
  applyRoleToUI(); // enforce dept lock for dept users
  if(preselectedProject) setMPS([preselectedProject]);
  document.getElementById('f-tasktype').value='';
  document.getElementById('f-pri').value='';
  document.getElementById('f-status').value='Not Started';
  document.getElementById('f-owner').value='';
  document.getElementById('f-by').value=currentUser?(currentUser.displayName||currentUser.email):'Director';
  ['f-deadline','f-followup','f-closed'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('f-recurrence').value='None';
  document.getElementById('f-custom-days').value='';
  // Hide all "other" fields
  ['f-dept-other-wrap','f-tasktype-other-wrap','f-owner-other-wrap'].forEach(id=>{const el=document.getElementById(id);if(el)el.classList.remove('visible');});
  document.getElementById('f-custom-days-wrap').style.display='none';
  document.getElementById('recur-preview').textContent='';
  openModal();
}

function openEdit(id) {
  const t=tasks.find(x=>x.id===id); if(!t)return;
  editingId=id;
  document.getElementById('modal-title').textContent=`Edit Task — ${id}`;
  document.getElementById('f-id').value=t.id;
  document.getElementById('f-cdate').value=t.captureDate;
  document.getElementById('f-task').value=t.task;
  const _fdeptEl=document.getElementById('f-dept'); if(_fdeptEl) _fdeptEl.value=t.dept||''; // may not exist (multi-dept mode)
  setCPValue(t.concernedPerson||'');
  setMPS(getTaskProjects(t));
  document.getElementById('f-tasktype').value=t.taskType||'';
  document.getElementById('f-pri').value=t.priority;
  document.getElementById('f-status').value=t.status;
  document.getElementById('f-owner').value=t.owner;
  document.getElementById('f-by').value=t.assignedBy;
  document.getElementById('f-deadline').value=t.deadline;
  document.getElementById('f-followup').value=t.followup||'';
  // Populate multi-dept and multi-person
  if(typeof setMDSValue==='function'){
    setMDSValue(Array.isArray(t.depts)&&t.depts.length?t.depts:(t.dept?[t.dept]:[]));
    setMPSPersonValue(Array.isArray(t.concernedPersons)&&t.concernedPersons.length?t.concernedPersons:(t.concernedPerson?[t.concernedPerson]:[]));}
  document.getElementById('f-recurrence').value=t.followupRecurrence||'None';
  document.getElementById('f-custom-days').value=t.followupCustomDays||'';
  document.getElementById('f-next').value=t.nextAction;
  document.getElementById('f-dep').value=t.dependency;
  document.getElementById('f-remarks').value=t.remarks;
  const tnEl=document.getElementById('f-tasknote'); if(tnEl) tnEl.value=t.taskNote||'';
  document.getElementById('f-closed').value=t.closedDate;
  // Restore "other" fields
  ['dept','tasktype','owner'].forEach(k=>{
    const sel=document.getElementById('f-'+k);
    const wrap=document.getElementById('f-'+k+'-other-wrap');
    const inp=document.getElementById('f-'+k+'-other');
    if(!sel||!wrap)return;
    const isOther=sel.value==='Other';
    wrap.classList.toggle('visible',isOther);
    if(inp&&isOther){
      const map={dept:'deptOther',tasktype:'taskTypeOther',owner:'ownerOther'};
      inp.value=t[map[k]]||'';
    }
  });
  handleRecurrenceChange();
  updateRecurPreview();
  openModal();
}

function openModal()  { document.getElementById('task-modal').classList.add('open');
  arrangeFormNotes(); }
function closeModal() { document.getElementById('task-modal').classList.remove('open'); }

function saveTask() {
  const task=document.getElementById('f-task').value.trim();
  const _deptsArr=JSON.parse(document.getElementById('f-depts-json')?.value||'[]');
  const dept=_deptsArr[0]||''; // backward compat
  const pri=document.getElementById('f-pri').value;
  const status=document.getElementById('f-status').value;
  const owner=document.getElementById('f-owner').value;
  const deadline=document.getElementById('f-deadline').value;
  const recurrence=document.getElementById('f-recurrence').value;
  const customDays=document.getElementById('f-custom-days').value;
  const deptOther=document.getElementById('f-dept-other').value.trim();
  const taskTypeOther=document.getElementById('f-tasktype-other').value.trim();
  const ownerOther=document.getElementById('f-owner-other').value.trim();
  const _personsArr=JSON.parse(document.getElementById('f-persons-json')?.value||'[]');
  const concernedPerson=_personsArr[0]||''; // backward compat
  // No mandatory validation — only format check for custom recurrence days
  if(recurrence==='Custom'&&customDays&&isNaN(parseInt(customDays))) {
    toast('Custom recurrence days must be a number.','error'); return;
  }
  const taskTypeVal=document.getElementById('f-tasktype').value;
  const selectedProjs=[..._selectedProjects];
  const followup=document.getElementById('f-followup-top')?.value || document.getElementById('f-followup')?.value || '';
  const data = {
    id:                editingId||document.getElementById('f-id').value,
    captureDate:       document.getElementById('f-cdate').value,
    task, dept, deptOther, concernedPerson,
    depts: _deptsArr, concernedPersons: _personsArr,
    taskNote:    (document.getElementById('f-tasknote')?.value||'').trim(),
    projects:          selectedProjs,
    taskType:          taskTypeVal, taskTypeOther,
    priority:          pri, status, owner, ownerOther,
    assignedBy:        document.getElementById('f-by').value,
    deadline, followup,
    followupRecurrence: recurrence,
    followupCustomDays: recurrence==='Custom'?customDays:'',
    nextFollowup:      calcNextFollowup(followup,recurrence,customDays)||'',
    nextAction:        document.getElementById('f-next').value,
    dependency:        document.getElementById('f-dep').value,
    lastUpdate:        todayStr(),
    remarks:           document.getElementById('f-remarks').value,
    closedDate:        document.getElementById('f-closed').value,
    createdBy:         editingId?(tasks.find(t=>t.id===editingId)||{}).createdBy:(currentUser?currentUser.email:''),
  };
  if(editingId) {
    const oldT = tasks.find(t=>t.id===editingId)||{};
    const idx  = tasks.findIndex(t=>t.id===editingId);
    addActivityLog('update','task',data.id,(data.task||'').slice(0,60),'',`Status: ${oldT.status||'?'} → ${data.status}`);
    // Moving to Done → archive it, remove from tasks
    if(data.status==='Done' && oldT.status!=='Done') {
      data.closedDate = data.closedDate || todayStr();
      data.archivedAt = new Date().toISOString();
      if(idx>=0) tasks.splice(idx,1);
      archived.unshift({...data});
      addActivityLog('archive','task',data.id,'Archived: '+(data.task||'').slice(0,50));
      saveTasks(); saveArchive(); closeModal();
      renderAll(); renderArchive();
      toast('✅ Task marked Done and moved to Archive.','success');
      return;
    }
    if(idx>=0) tasks[idx]=data;
    toast(`Task ${editingId} updated.`,'success');
  } else {
    // New task — if somehow created as Done, archive immediately
    if(data.status==='Done') {
      data.closedDate = data.closedDate || todayStr();
      data.archivedAt = new Date().toISOString();
      archived.unshift({...data});
      addActivityLog('create','task',data.id,(data.task||'').slice(0,60));
      addActivityLog('archive','task',data.id,'Created and archived: '+(data.task||'').slice(0,50));
      saveTasks(); saveArchive(); closeModal();
      renderAll(); renderArchive();
      toast(`Task ${data.id} created and archived.`,'success');
      return;
    }
    tasks.push(data);
    toast(`Task ${data.id} added.`,'success');
    addActivityLog('create','task',data.id,(data.task||'').slice(0,60));
  }
  // Flash Save button green briefly, then close
  const saveBtn = document.querySelector('#task-modal .btn-primary');
  if(saveBtn) {
    saveBtn.innerHTML = '✔ Saved!';
    saveBtn.style.background = '#26A69A';
    saveBtn.style.pointerEvents = 'none';
    setTimeout(() => { closeModal(); showGreenSaved('Task saved'); }, 600);
  } else {
    closeModal();
    showGreenSaved('Task saved');
  }
  saveTasks();
}

// ── PROJECT MODAL ─────────────────────────────────────────────
function nextProjId() {
  const nums=projects.map(p=>{ const m=p.projectNo.match(/(\d+)$/); return m?parseInt(m[1]):0; });
  const max=nums.length?Math.max(...nums):0;
  return'P-'+String(max+1).padStart(3,'0');
}

function openAddProject() {
  editingProjId=null;
  document.getElementById('proj-modal-title').textContent='New Project';
  document.getElementById('pf-num').value=nextProjId();
  document.getElementById('pf-num').readOnly=false;
  document.getElementById('pf-client').value='';
  document.getElementById('pf-name').value='';
  document.getElementById('pf-desc').value='';
  document.getElementById('pf-start').value=todayStr();
  document.getElementById('pf-end').value='';
  document.getElementById('pf-status').value='Active';
  document.getElementById('project-modal').classList.add('open');
}

function openEditProject(id) {
  const p=projects.find(x=>x.id===id); if(!p)return;
  editingProjId=id;
  document.getElementById('proj-modal-title').textContent=`Edit Project — ${p.projectNo}`;
  document.getElementById('pf-num').value=p.projectNo;
  document.getElementById('pf-num').readOnly=true; // don't change project number once set
  document.getElementById('pf-client').value=p.clientName;
  document.getElementById('pf-name').value=p.projectName;
  document.getElementById('pf-desc').value=p.description||'';
  document.getElementById('pf-start').value=p.startDate;
  document.getElementById('pf-end').value=p.endDate||'';
  document.getElementById('pf-status').value=p.status;
  document.getElementById('project-modal').classList.add('open');
}

function closeProjModal() { document.getElementById('project-modal').classList.remove('open'); }

function saveProject() {
  const num=document.getElementById('pf-num').value.trim();
  const client=document.getElementById('pf-client').value.trim();
  const name=document.getElementById('pf-name').value.trim();
  const start=document.getElementById('pf-start').value;
  const status=document.getElementById('pf-status').value;
  // Only check for duplicate project number (data integrity, not mandatory)
  if(num && !editingProjId && projects.find(p=>p.projectNo===num)){ toast('Project Number '+num+' already exists. Please use a different number.','error'); return; }
  const data={
    id:          editingProjId||('PROJ-'+Date.now()),
    projectNo:   num,
    clientName:  client,
    projectName: name,
    description: document.getElementById('pf-desc').value,
    startDate:   start,
    endDate:     document.getElementById('pf-end').value,
    status,
    createdBy:   editingProjId?(projects.find(p=>p.id===editingProjId)||{}).createdBy:(currentUser?currentUser.email:''),
    createdAt:   editingProjId?(projects.find(p=>p.id===editingProjId)||{}).createdAt:todayStr(),
  };
  if(editingProjId){ const idx=projects.findIndex(p=>p.id===editingProjId); if(idx>=0)projects[idx]=data; toast('Project updated.','success'); }
  else { projects.push(data); toast(`Project ${num} created.`,'success'); }
  saveProjects(); closeProjModal();
}

function confirmDelProject(id) {
  pendingDelProjId=id;
  const p=projects.find(x=>x.id===id);
  document.getElementById('proj-confirm-msg').textContent=`Delete project "${p?p.projectNo+' — '+p.projectName:id}"? Tasks linked to this project will remain but lose the project link.`;
  document.getElementById('proj-confirm-bg').classList.add('open');
}
function closeProjConfirm() { pendingDelProjId=null; document.getElementById('proj-confirm-bg').classList.remove('open'); }
function doDeleteProject() {
  if(!pendingDelProjId)return;
  const p = projects.find(x=>x.id===pendingDelProjId);
  if(p) addAuditLog('delete','project',p.id,`${p.projectNo} — ${p.projectName}`);
  projects=projects.filter(p=>p.id!==pendingDelProjId);
  saveProjects(); closeProjConfirm(); toast('Project deleted.','success');
}

// ── TASK DELETE ───────────────────────────────────────────────
function confirmDel(id) {
  pendingDelId=id;
  const t=tasks.find(x=>x.id===id);
  const label = t ? (t.task||'').slice(0,55)+(t.task?.length>55?'…':'') : id;
  document.getElementById('confirm-title-text').textContent = 'Move Task to Trash?';
  document.getElementById('confirm-msg').innerHTML = `<strong style="color:var(--text);">"${h(label)}"</strong><br><span style="font-size:11px;color:var(--green);">ℹ Task will be in Trash for 30 days — recoverable via the 🔐 Recovery button.</span>`;
  document.getElementById('confirm-bg').classList.add('open');
}
function closeConfirm() { pendingDelId=null; const cb=document.getElementById('confirm-bg'); if(cb)cb.classList.remove('open'); pendingDelId=null; }
function doDelete() {
  if(!pendingDelId)return;
  // Check both tasks and archived
  const t = tasks.find(x=>x.id===pendingDelId) || archived.find(x=>x.id===pendingDelId);
  if(t){
    // Move to trash (soft delete) instead of permanent delete
    deletedTasks.push({...t, deletedAt:new Date().toISOString(), deletedBy:currentUser?.email||'unknown'});
    saveTrash();
    addAuditLog('delete','task',t.id, (t.task||'').slice(0,60)||t.id);
  }
  tasks=tasks.filter(t=>t.id!==pendingDelId);
  archived=archived.filter(t=>t.id!==pendingDelId);
  renderAll(); // immediate UI update
  saveTasks(); saveArchive(); closeConfirm();
  toast('Task moved to Trash (recoverable for 30 days via Recovery Centre).','success');
}

// ── EXPORT / IMPORT ───────────────────────────────────────────
function exportTasks() {
  const blob=new Blob([JSON.stringify({tasks,projects,employees},null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=`dcd-backup-${todayStr()}.json`;
  a.click(); URL.revokeObjectURL(a.href);
  toast('Exported tasks + projects.','success');
}
function importTasks(file) {
  if(!file)return;
  const reader=new FileReader();
  reader.onload=e=>{
    try{
      const p=JSON.parse(e.target.result);
      const tCount=(p.tasks||p||[]).length;
      if(!confirm('This will REPLACE all current tasks with ' + tCount + ' records from the file. This cannot be undone. Continue?')) return;
      if(p.tasks&&Array.isArray(p.tasks)){ tasks=p.tasks; saveTasks(); addAuditLog('import','tasks','*',tCount+' tasks imported from JSON'); }
      else if(Array.isArray(p)){ tasks=p; saveTasks(); addAuditLog('import','tasks','*',tCount+' tasks imported from JSON'); }
      else throw new Error();
      if(p.projects&&Array.isArray(p.projects)){ projects=p.projects; saveProjects(); }
      if(p.employees&&Array.isArray(p.employees)){ employees=p.employees; saveEmployees(); }
      toast('Imported '+tCount+' tasks successfully.','success');
    }catch{ toast('Invalid file.','error'); }
  };
  reader.readAsText(file);
}

// ── TABS & UI HELPERS ─────────────────────────────────────────
function showTab(id) {
  document.querySelectorAll('.nav-tab').forEach(t=>t.classList.toggle('active',t.dataset.tab===id));
  document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===`page-${id}`));
  if(id==='projects') renderProjects();
  if(id==='employees'){ renderEmployees(); refreshEmpFilters(); }
  if(id==='archive') { renderArchive(); }
  if(id==='activity') { renderActivityLog(); }
  if(id==='personal-calendar') {
    loadCalendar(); renderCalendar(); renderCalSidebar();
    requestCalNotifPermission();
  }
}

function showScreen(which) {
  document.getElementById('auth-screen').classList.toggle('visible',which==='auth');
  document.getElementById('app').classList.toggle('visible',which==='app');
}
function showEl(id) { const el=document.getElementById(id); if(el)el.classList.add('visible'); }
function hideLoadingOverlay() { document.getElementById('loading-overlay').classList.add('hidden'); }

function setConn(state,label) {
  const el=document.getElementById('conn-pill');
  const lb=document.getElementById('conn-label');
  if(el) el.className=`conn-pill conn-${state}`;
  if(lb) lb.textContent=label;
}

function setUserChip(user) {
  const name=user.displayName||user.email||'?';
  const initials=name.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
  const el=document.getElementById('user-name');
  const av=document.getElementById('user-avatar');
  if(el) el.textContent=user.displayName||user.email;
  if(av) av.textContent=initials;
}

function toast(msg,type='success') {
  const c=document.getElementById('toast-wrap');
  const d=document.createElement('div');
  d.className=`toast ${type}`; d.textContent=msg;
  c.appendChild(d); setTimeout(()=>d.remove(),3500);
}

function flashSaved() { showSaved(); } // alias
function _flashSaved_orig() {
  const el=document.getElementById('save-indicator');
  if(!el)return; el.style.opacity='1';
  setTimeout(()=>el.style.opacity='0',2000);
}

function updateHeaderDate() {
  const el=document.getElementById('header-date'); if(!el)return;
  const now=new Date();
  el.textContent=now.toLocaleDateString('en-IN',{weekday:'long',day:'2-digit',month:'long',year:'numeric'})+'  '+now.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'});
}


// ═══════════════════════════════════════════════════════════
// EMPLOYEE MANAGEMENT MODULE
// ═══════════════════════════════════════════════════════════

// ── Sort state ──
let empSortCol = 'name';
let empSortDir = 'asc';

// ── Next employee ID ──
function nextEmpId() {
  if (!employees.length) return 'EMP-001';
  const nums = employees.map(e => { const m = (e.empCode||'').match(/(\d+)$/); return m ? parseInt(m[1]) : 0; });
  return 'EMP-' + String(Math.max(...nums) + 1).padStart(3,'0');
}

// ── Render employee table ──
function renderEmployees() {
  const search  = (document.getElementById('emp-search')?.value||'').toLowerCase();
  const deptF   = document.getElementById('emp-filter-dept')?.value||'';
  const desgF   = document.getElementById('emp-filter-desg')?.value||'';
  const statF   = document.getElementById('emp-filter-status')?.value||'';
  const dirF    = document.getElementById('emp-filter-director')?.value||'';

  let filtered = employees.filter(e=>{
    if(search && !( (e.name||'').toLowerCase().includes(search) || (e.empCode||'').toLowerCase().includes(search) )) return false;
    if(deptF  && e.department !== deptF)  return false;
    if(desgF  && e.designation !== desgF) return false;
    if(statF  && e.status !== statF)      return false;
    if(dirF === 'yes' && !e.isDirector)   return false;
    if(dirF === 'no'  && e.isDirector)    return false;
    return true;
  });

  // Sort
  filtered.sort((a,b)=>{
    const av = (a[empSortCol]||'').toString().toLowerCase();
    const bv = (b[empSortCol]||'').toString().toLowerCase();
    return empSortDir==='asc' ? av.localeCompare(bv) : bv.localeCompare(av);
  });

  // Update sort icons
  document.querySelectorAll('.emp-table thead th[data-col]').forEach(th=>{
    th.classList.remove('sort-asc','sort-desc');
    if(th.dataset.col===empSortCol) th.classList.add(empSortDir==='asc'?'sort-asc':'sort-desc');
  });

  const badge = document.getElementById('emp-count-badge');
  if(badge) badge.textContent = `${filtered.length} of ${employees.length} employee${employees.length!==1?'s':''}`;

  const tbody = document.getElementById('emp-tbody');
  if(!tbody)return;

  if(!filtered.length){
    tbody.innerHTML=`<tr><td colspan="9" class="empty-state"><div class="empty-icon">👤</div>${employees.length?'No employees match the filters.':'No employees yet. Click <strong>+ Add Employee</strong>.'}</td></tr>`;
    return;
  }

  tbody.innerHTML = filtered.map(e=>{
    const initials = (e.name||'?').split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
    const statusBadge = e.status==='Active'
      ? '<span class="badge badge-active">Active</span>'
      : '<span class="badge badge-inactive">Inactive</span>';
    const dirBadge = e.isDirector
      ? '<span class="badge badge-director">★ Director</span>'
      : '<span class="c-gray sm">—</span>';
    const contact = [e.email, e.mobile].filter(Boolean).join(' · ') || '<span class="c-gray">—</span>';
    return `<tr>
      <td class="mono sm" style="color:var(--blue);font-weight:600;">${h(e.empCode)||'—'}</td>
      <td><div class="emp-name-cell"><div class="emp-avatar">${initials}</div><div><div class="emp-name-text">${h(e.name)||'—'}</div><div class="emp-email">${h(e.email)||''}</div></div></div></td>
      <td class="sm">${h(e.designation)||'—'}</td>
      <td class="sm">${h(e.department)||'—'}</td>
      <td>${statusBadge}</td>
      <td>${dirBadge}</td>
      <td class="sm c-text2">${contact}</td>
      <td class="sm c-text2">${h(e.reportingManager)||'—'}</td>
      <td><div style="display:flex;gap:4px;">
        <button class="btn btn-ghost btn-sm btn-icon" onclick="openEditEmp('${e.id}')" title="Edit">✏️</button>
        <button class="btn btn-danger btn-sm btn-icon" onclick="confirmDelEmp('${e.id}')" title="Delete">🗑</button>
      </div></td>
    </tr>`;
  }).join('');
}

function sortEmployees(col) {
  if(empSortCol===col) empSortDir = empSortDir==='asc'?'desc':'asc';
  else { empSortCol=col; empSortDir='asc'; }
  renderEmployees();
}

function refreshEmpFilters() {
  // Dept filter
  const depts=[...new Set(employees.map(e=>e.department).filter(Boolean))].sort();
  const deptEl=document.getElementById('emp-filter-dept'); 
  if(deptEl){ const cur=deptEl.value; deptEl.innerHTML='<option value="">All Departments</option>'+depts.map(d=>`<option>${d}</option>`).join(''); deptEl.value=cur; }
  // Designation filter
  const desgs=[...new Set(employees.map(e=>e.designation).filter(Boolean))].sort();
  const desgEl=document.getElementById('emp-filter-desg');
  if(desgEl){ const cur=desgEl.value; desgEl.innerHTML='<option value="">All Designations</option>'+desgs.map(d=>`<option>${d}</option>`).join(''); desgEl.value=cur; }
  // Manager datalist in emp modal
  const mgEl=document.getElementById('ef-manager-list');
  if(mgEl) mgEl.innerHTML=employees.filter(e=>e.status==='Active').map(e=>`<option value="${e.name}">`).join('');
  // Also populate dept dropdown in emp form
  const empDeptEl=document.getElementById('ef-dept');
  if(empDeptEl){ const cur=empDeptEl.value; empDeptEl.innerHTML='<option value="">— Select —</option>'+L.depts.map(d=>`<option>${d}</option>`).join(''); if(cur)empDeptEl.value=cur; }
}

// ── Add / Edit employee modal ──
function openAddEmp() {
  editingEmpId=null;
  document.getElementById('emp-modal-title').textContent='Add Employee';
  document.getElementById('ef-code').value=nextEmpId();
  document.getElementById('ef-name').value='';
  document.getElementById('ef-desg').value='';
  const _deptEl=document.getElementById('ef-dept'); if(_deptEl)_deptEl.value='';
  const _emailEl=document.getElementById('ef-email'); if(_emailEl)_emailEl.value='';
  const _mobileEl=document.getElementById('ef-mobile'); if(_mobileEl)_mobileEl.value='';
  const _managerEl=document.getElementById('ef-manager'); if(_managerEl)_managerEl.value='';
  document.getElementById('ef-status').value='Active';
  const _dirNo=document.getElementById('ef-dir-no'); if(_dirNo)_dirNo.checked=false;
  const _dirSel=document.getElementById('ef-dir-select'); if(_dirSel)_dirSel.value='no';
  const _efEm=document.getElementById('ef-email'); if(_efEm)_efEm.value='';
  const _efMb=document.getElementById('ef-mobile'); if(_efMb)_efMb.value='';
  const _efMg=document.getElementById('ef-manager'); if(_efMg)_efMg.value='';
  refreshEmpFilters();
  document.getElementById('emp-modal').classList.add('open');
}

function openEditEmp(id) {
  const e=employees.find(x=>x.id===id); if(!e)return;
  editingEmpId=id;
  document.getElementById('emp-modal-title').textContent=`Edit Employee — ${e.empCode||e.name}`;
  document.getElementById('ef-code').value=e.empCode||'';
  document.getElementById('ef-name').value=e.name||'';
  document.getElementById('ef-desg').value=e.designation||'';
  refreshEmpFilters();
  (document.getElementById('ef-dept')||{value:''}).value=e.department||'';
  (document.getElementById('ef-email')||{value:''}).value=e.email||'';
  (document.getElementById('ef-mobile')||{value:''}).value=e.mobile||'';
  (document.getElementById('ef-manager')||{value:''}).value=e.reportingManager||'';
  document.getElementById('ef-status').value=e.status||'Active';
  if(e.isDirector) document.getElementById('ef-dir-yes').checked=true;
  const _dirNoFix=document.getElementById('ef-dir-no'); if(_dirNoFix)_dirNoFix.checked=true;
  document.getElementById('emp-modal').classList.add('open');
}

function closeEmpModal() { document.getElementById('emp-modal').classList.remove('open'); }

function saveEmployee() {
  const name=document.getElementById('ef-name').value.trim();
  if(!name){ toast('Employee name is required.','error'); return; }
  const data={
    id:              editingEmpId||('EMP-'+Date.now()),
    empCode:         document.getElementById('ef-code').value.trim(),
    name,
    designation:     document.getElementById('ef-desg').value.trim(),
    department:      (document.getElementById('ef-dept')||{value:''}).value,
    email:           (document.getElementById('ef-email')||{value:''}).value.trim(),
    mobile:          (document.getElementById('ef-mobile')||{value:''}).value.trim(),
    reportingManager:(document.getElementById('ef-manager')||{value:''}).value.trim(),
    status:          document.getElementById('ef-status').value,
    isDirector:      document.querySelector('input[name="ef-director"]:checked')?.value==='yes',
    createdAt:       editingEmpId?(employees.find(e=>e.id===editingEmpId)||{}).createdAt:todayStr(),
    createdBy:       editingEmpId?(employees.find(e=>e.id===editingEmpId)||{}).createdBy:(currentUser?currentUser.email:''),
  };
  if(editingEmpId){ const idx=employees.findIndex(e=>e.id===editingEmpId); if(idx>=0)employees[idx]=data; toast(`${data.name} updated.`,'success'); }
  else { employees.push(data); toast(`${data.name} added.`,'success'); }
  saveEmployees();
  closeEmpModal();
}

function confirmDelEmp(id) {
  pendingDelEmpId=id;
  const e=employees.find(x=>x.id===id);
  document.getElementById('emp-confirm-msg').textContent=`Delete "${e?e.name:id}"? This cannot be undone.`;
  document.getElementById('emp-confirm-bg').classList.add('open');
}
function closeEmpConfirm() { pendingDelEmpId=null; document.getElementById('emp-confirm-bg').classList.remove('open'); }
function doDeleteEmp() {
  if(!pendingDelEmpId)return;
  const _e = employees.find(x=>x.id===pendingDelEmpId);
  if(_e) addAuditLog('delete','employee', _e.id, (_e.empCode||'?')+' — '+(_e.name||'?'));
  employees=employees.filter(e=>e.id!==pendingDelEmpId);
  saveEmployees(); closeEmpConfirm();
  toast('Employee deleted.','success');
}

// ═══════════════════════════════════════════════════════════
// CONCERNED PERSON — Custom Searchable Dropdown
// Grouped: Directors first, then Active employees
// ═══════════════════════════════════════════════════════════
let _cpValue = '';    // stored as "Name – Designation" or just name
let _cpOpen  = false;

function toggleCP(e) {
  e.stopPropagation();
  _cpOpen = !_cpOpen;
  const _cpp=document.getElementById('cp-panel'); if(_cpp)_cpp.style.display=_cpOpen?'block':'none';
  document.getElementById('cp-trigger').classList.toggle('open', _cpOpen);
  if(_cpOpen){
    const _cps=document.getElementById('cp-search'); if(_cps)_cps.value='';
    renderCPOptions();
    setTimeout(()=>{const _cpf=document.getElementById('cp-search');if(_cpf)_cpf.focus();},50);
  }
}

function closeCP() {
  _cpOpen=false;
  const p=document.getElementById('cp-panel'); if(p)p.style.display='none';
  const t=document.getElementById('cp-trigger'); if(t)t.classList.remove('open');
}

function renderCPOptions() {
  const search=(document.getElementById('cp-search')?.value||'').toLowerCase();
  const container=document.getElementById('cp-options'); if(!container)return;
  const active=employees.filter(e=>e.status==='Active');
  const dirs  =active.filter(e=>e.isDirector);
  const others=active.filter(e=>!e.isDirector);
  const all   =[...dirs,...others];

  const filtered=search ? all.filter(e=>
    (e.name||'').toLowerCase().includes(search)||
    (e.designation||'').toLowerCase().includes(search)||
    (e.department||'').toLowerCase().includes(search)
  ) : all;

  if(!filtered.length){
    container.innerHTML=`<div class="cp-empty">${employees.length?'No employees match your search.':'No employees yet. Add employees in the 👥 Employees tab first.'}</div>`;
    return;
  }

  let html='';
  const fDirs  =filtered.filter(e=>e.isDirector);
  const fOthers=filtered.filter(e=>!e.isDirector);

  if(fDirs.length){
    html+=`<div class="cp-optgroup-label">★ Directors</div>`;
    html+=fDirs.map(e=>cpOptionHTML(e)).join('');
  }
  if(fOthers.length){
    html+=`<div class="cp-optgroup-label">👤 Employees</div>`;
    html+=fOthers.map(e=>cpOptionHTML(e)).join('');
  }
  container.innerHTML=html;
}

function cpOptionHTML(e) {
  const initials=(e.name||'?').split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
  const label=e.designation?`${e.name} – ${e.designation}`:e.name;
  const selected=_cpValue===label;
  return `<div class="cp-option${selected?' selected':''}" onclick="selectCP('${label.replace(/'/g,"\'")}')">
    <div class="cp-opt-avatar${e.isDirector?' cp-opt-director':''}">${initials}</div>
    <div class="cp-opt-info">
      <span class="cp-opt-name">${h(e.name)}</span>
      <span class="cp-opt-desg">${h(e.designation||e.department||'')}</span>
    </div>
    ${e.isDirector?'<span class="cp-opt-dir-badge">Director</span>':''}
  </div>`;
}

function selectCP(label) {
  _cpValue=label;
  const _fc1=document.getElementById('f-concerned'); if(_fc1)_fc1.value=label;
  const disp=document.getElementById('cp-display');
  if(disp){ disp.textContent=label; disp.classList.remove('cp-placeholder'); }
  closeCP();
}

function clearCP() {
  _cpValue='';
  const _fc2=document.getElementById('f-concerned'); if(_fc2)_fc2.value='';
  const disp=document.getElementById('cp-display');
  if(disp){ disp.textContent='Select concerned person…'; disp.classList.add('cp-placeholder'); }
  closeCP();
}

function setCPValue(val) {
  _cpValue=val||'';
  const _fc3=document.getElementById('f-concerned'); if(_fc3)_fc3.value=_cpValue;
  const disp=document.getElementById('cp-display');
  if(disp){
    if(_cpValue){ disp.textContent=_cpValue; disp.classList.remove('cp-placeholder'); }
    else { disp.textContent='Select concerned person…'; disp.classList.add('cp-placeholder'); }
  }
}

function populateCPDropdown() {
  if(_cpOpen) renderCPOptions();
  // Only re-render task tables if employees actually changed
}

// Close CP when clicking outside
document.addEventListener('click', function(e){
  const wrap=document.getElementById('cp-wrap');
  if(wrap && !wrap.contains(e.target)) closeCP();
});


// ═══════════════════════════════════════════════════════════════════
// BULK IMPORT / EXPORT ENGINE
// Uses SheetJS (xlsx) loaded dynamically from cdnjs
// ═══════════════════════════════════════════════════════════════════

let _xlsxReady = false;
let _xlsxLoading = false;
let _xlsxCallbacks = [];

function loadXLSX(cb) {
  if (_xlsxReady) { cb(); return; }
  _xlsxCallbacks.push(cb);
  if (_xlsxLoading) return;
  _xlsxLoading = true;
  const s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
  s.onload = () => { _xlsxReady = true; _xlsxLoading = false; _xlsxCallbacks.forEach(fn=>fn()); _xlsxCallbacks = []; };
  s.onerror = () => { _xlsxLoading = false; toast('Could not load Excel library. Check your internet connection.', 'error'); };
  document.head.appendChild(s);
}

// ── Import results state ─────────────────────────────────────────
let _lastErrorRows = [];

function showImportResults(title, rows) {
  const ok    = rows.filter(r=>r.status==='ok').length;
  const errs  = rows.filter(r=>r.status==='error').length;
  const skips = rows.filter(r=>r.status==='skip').length;
  document.getElementById('import-results-title').textContent = title;
  document.getElementById('ir-total').textContent = rows.length;
  document.getElementById('ir-ok').textContent    = ok;
  document.getElementById('ir-err').textContent   = errs;
  document.getElementById('ir-skip').textContent  = skips;
  _lastErrorRows = rows.filter(r=>r.status==='error');
  document.getElementById('ir-download-errors').style.display = _lastErrorRows.length ? '' : 'none';
  document.getElementById('ir-rows').innerHTML = rows.map((r,i)=>{
    const cls   = r.status==='ok'?'import-row-ok':r.status==='error'?'import-row-err':'';
    const icon  = r.status==='ok'?'✅':r.status==='error'?'❌':'⚠️';
    const lbl   = r.status==='ok'?'Imported':r.status==='error'?'Error':'Skipped';
    return `<tr style="border-bottom:1px solid var(--border);">
      <td style="padding:7px 10px;font-family:var(--mono);font-size:11px;color:var(--text3);">${r.row||i+2}</td>
      <td style="padding:7px 10px;"><span class="${cls}">${icon} ${lbl}</span></td>
      <td style="padding:7px 10px;font-size:11px;color:var(--text2);">${h(r.label||'')}</td>
      <td style="padding:7px 10px;font-size:11px;color:${r.status==='error'?'var(--red)':'var(--text3)'};">${h(r.note||'')}</td>
    </tr>`;
  }).join('');
  document.getElementById('import-results-modal').classList.add('open');
}

function downloadErrorReport() {
  const lines = ['Row,Status,Record,Error'];
  _lastErrorRows.forEach(r => lines.push(`${r.row},"Error","${(r.label||'').replace(/"/g,'""')}","${(r.note||'').replace(/"/g,'""')}"`));
  const blob = new Blob([lines.join('\n')], {type:'text/csv'});
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
  a.download = `import-errors-${todayStr()}.csv`; a.click(); URL.revokeObjectURL(a.href);
}

function setUploadProgress(id, visible, msg) {
  const el = document.getElementById(id);
  if (!el) return;
  el.classList.toggle('visible', visible);
  const msgEl = el.querySelector('span');
  if (msgEl && msg) msgEl.textContent = msg;
}

// ── Helper: read file as ArrayBuffer ──────────────────────────────
function readFileAsAB(file) {
  return new Promise((res,rej) => {
    const r = new FileReader();
    r.onload = e => res(e.target.result);
    r.onerror = () => rej(new Error('File read failed'));
    r.readAsArrayBuffer(file);
  });
}

// ── Excel parsing helper ──────────────────────────────────────────
async function parseExcel(file) {
  const ab = await readFileAsAB(file);
  const wb = XLSX.read(ab, {type:'array', cellDates:true});
  const ws = wb.Sheets[wb.SheetNames[0]];
  return XLSX.utils.sheet_to_json(ws, {defval:'', raw:false});
}

// ── Generate Excel file ───────────────────────────────────────────
function buildExcel(sheetName, headers, sampleRow) {
  const wb = XLSX.utils.book_new();
  const data = [headers, sampleRow];
  const ws = XLSX.utils.aoa_to_sheet(data);
  // Column widths
  ws['!cols'] = headers.map(h => ({wch: Math.max(h.length + 4, 18)}));
  // Style header row (SheetJS lite doesn't support cell styles in free version, but we set frozen row)
  ws['!freeze'] = {xSplit:0, ySplit:1};
  XLSX.utils.book_append_sheet(wb, ws, sheetName);
  return wb;
}

function downloadExcel(wb, filename) {
  XLSX.writeFile(wb, filename);
}

// ════════════════════════════════════════════════════════════════════
// A. TASK BULK IMPORT / EXPORT
// ════════════════════════════════════════════════════════════════════
const TASK_HEADERS = [
  'Task Title','Task Description','Project Numbers (comma separated)',
  'Department','Concerned Person','Priority','Status','Task Owner',
  'Assigned By','Deadline (YYYY-MM-DD)','Follow-up Date (YYYY-MM-DD)',
  'Follow-up Frequency','Task Type','Dependency','Remarks'
];
const TASK_SAMPLE = [
  'Install new server','Setup and configure the server','P-001,P-002',
  'IT','John Smith – Managing Director','P2 - High','Not Started','IT Manager',
  'Director','2026-07-31','2026-07-15','Weekly','Review','Awaiting hardware','Sample task'
];

function downloadTaskTemplate() {
  loadXLSX(() => {
    const wb = buildExcel('Tasks', TASK_HEADERS, TASK_SAMPLE);
    // Add a notes sheet
    const ws_instr_task = XLSX.utils.aoa_to_sheet([
      ['Field','Valid Values / Notes'],
      ['Priority','P1 - Critical | P2 - High | P3 - Medium | P4 - Low'],
      ['Status','Not Started | In Progress | Waiting | Blocked | Done | Cancelled'],
      ['Follow-up Frequency','None | Daily | Alternate Days | Weekly | Fortnightly | Monthly | Quarterly | Custom'],
      ['Department', L.depts.join(' | ')],
      ['Deadline / Follow-up Date','Format: YYYY-MM-DD (e.g. 2026-07-31)'],
      ['Project Numbers','Use comma to separate multiple: P-001,P-002'],
    ]);
    notes['!cols'] = [{wch:28},{wch:80}];
    XLSX.utils.book_append_sheet(wb, notes, 'Instructions');
    downloadExcel(wb, `Task-Import-Template-${todayStr()}.xlsx`);
    toast('Task Excel template downloaded.', 'success');
  });
}

async function handleTaskExcelUpload(input) {
  if (!input.files?.length) return;
  const file = input.files[0]; input.value='';
  setUploadProgress('task-upload-progress', true, 'Reading Excel…');
  loadXLSX(async () => {
    try {
      const rows = await parseExcel(file);
      if (!rows.length) { toast('Excel file is empty or has no data rows.','error'); setUploadProgress('task-upload-progress',false); return; }
      setUploadProgress('task-upload-progress', true, `Validating ${rows.length} rows…`);
      const results = []; const newTasks = [];
      for (let i=0; i<rows.length; i++) {
        const r = rows[i]; const rowNum = i+2;
        const title = (r['Task Title']||r['task']||r['Task']||'').toString().trim();
        if (!title) {
          results.push({row:rowNum, status:'skip', label:'(empty)', note:'Task Title is blank — row skipped'});
          continue;
        }
        // Map columns
        const projRaw = (r['Project Numbers (comma separated)']||r['Project Numbers']||r['Projects']||'').toString().trim();
        const projArr = projRaw ? projRaw.split(',').map(p=>p.trim()).filter(Boolean) : [];
        const freq = (r['Follow-up Frequency']||r['Recurrence']||'None').toString().trim();
        const validFreqs = ['None','Daily','Alternate Days','Weekly','Fortnightly','Monthly','Quarterly','Custom'];
        const validPris  = ['P1 - Critical','P2 - High','P3 - Medium','P4 - Low'];
        const validStats = ['Not Started','In Progress','Waiting','Blocked','Done','Cancelled'];
        const warnings = [];
        const pri = (r['Priority']||'P3 - Medium').toString().trim();
        if (pri && !validPris.includes(pri)) warnings.push(`Priority "${pri}" not recognised — using P3 - Medium`);
        const stat = (r['Status']||'Not Started').toString().trim();
        if (stat && !validStats.includes(stat)) warnings.push(`Status "${stat}" not recognised — using Not Started`);
        const task = {
          id: nextId(),
          captureDate: todayStr(),
          task: title,
          dept: (r['Department']||'').toString().trim(),
          deptOther: '',
          concernedPerson: (r['Concerned Person']||'').toString().trim(),
          projects: projArr,
          taskType: (r['Task Type']||'').toString().trim(),
          taskTypeOther: '',
          priority: validPris.includes(pri) ? pri : 'P3 - Medium',
          status: validStats.includes(stat) ? stat : 'Not Started',
          owner: (r['Task Owner']||r['Owner']||'').toString().trim(),
          ownerOther: '',
          assignedBy: (r['Assigned By']||'').toString().trim(),
          deadline: fmtImportDate(r['Deadline (YYYY-MM-DD)']||r['Deadline']||r['Due Date']||''),
          followup: fmtImportDate(r['Follow-up Date (YYYY-MM-DD)']||r['Follow-up Date']||''),
          followupRecurrence: validFreqs.includes(freq) ? freq : 'None',
          followupCustomDays: '',
          nextFollowup: '',
          nextAction: (r['Next Action']||'').toString().trim(),
          dependency: (r['Dependency']||'').toString().trim(),
          lastUpdate: todayStr(),
          remarks: (r['Remarks']||r['Notes']||'').toString().trim(),
          closedDate: '',
          createdBy: currentUser ? currentUser.email : '',
        };
        newTasks.push(task);
        results.push({row:rowNum, status:'ok', label:title, note: warnings.length ? '⚠ '+warnings.join('; ') : 'Imported successfully'});
      }
      if (newTasks.length) {
        tasks.push(...newTasks);
        setUploadProgress('task-upload-progress', true, `Saving ${newTasks.length} tasks…`);
        saveTasks();
      }
      setUploadProgress('task-upload-progress', false);
      showImportResults(`Task Import — ${file.name}`, results);
    } catch(e) {
      setUploadProgress('task-upload-progress', false);
      toast('Import failed: '+e.message, 'error');
    }
  });
}

