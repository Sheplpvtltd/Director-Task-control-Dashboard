async function handleProjExcelUpload(input) {
  if (!input.files?.length) return;
  const file = input.files[0]; input.value='';
  setUploadProgress('proj-upload-progress', true, 'Reading Excel…');
  loadXLSX(async () => {
    try {
      const rows = await parseExcel(file);
      if (!rows.length) { toast('Excel file is empty.','error'); setUploadProgress('proj-upload-progress',false); return; }
      const results = []; const newProjs = [];
      const validStats = ['Planning','Active','On Hold','Completed','Cancelled'];
      for (let i=0; i<rows.length; i++) {
        const r = rows[i]; const rowNum = i+2;
        const pname = (r['Project Name']||r['Name']||'').toString().trim();
        if (!pname) { results.push({row:rowNum, status:'skip', label:'(empty)', note:'Project Name is blank — row skipped'}); continue; }
        let pnum = (r['Project Number']||r['Project No']||'').toString().trim();
        if (!pnum) pnum = nextProjId();
        const dup = projects.find(p=>p.projectNo===pnum);
        if (dup) { results.push({row:rowNum, status:'error', label:pnum, note:`Duplicate: Project Number ${pnum} already exists`}); continue; }
        const statRaw = (r['Status']||'Active').toString().trim();
        const proj = {
          id:          'PROJ-'+Date.now()+'-'+i,
          projectNo:   pnum,
          projectName: pname,
          clientName:  (r['Client Name']||r['Client']||'').toString().trim(),
          description: (r['Project Description']||r['Description']||r['Remarks']||'').toString().trim(),
          startDate:   fmtImportDate(r['Start Date (YYYY-MM-DD)']||r['Start Date']||''),
          endDate:     fmtImportDate(r['End Date (YYYY-MM-DD)']||r['End Date']||''),
          status:      validStats.includes(statRaw)?statRaw:'Active',
          createdAt:   todayStr(),
          createdBy:   currentUser?currentUser.email:'',
        };
        newProjs.push(proj);
        results.push({row:rowNum, status:'ok', label:`${pnum} — ${pname}`, note:'Imported successfully'});
      }
      if (newProjs.length) {
        projects.push(...newProjs);
        setUploadProgress('proj-upload-progress', true, `Saving ${newProjs.length} projects…`);
        saveProjects();
      }
      setUploadProgress('proj-upload-progress', false);
      showImportResults(`Project Import — ${file.name}`, results);
    } catch(e) {
      setUploadProgress('proj-upload-progress', false);
      toast('Import failed: '+e.message, 'error');
    }
  });
}

// ── Date format helper for import ─────────────────────────────────
function fmtImportDate(val) {
  if (!val) return '';
  const s = val.toString().trim();
  // Already YYYY-MM-DD
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  // Try parsing
  const d = new Date(s);
  if (!isNaN(d)) return d.toISOString().slice(0,10);
  return '';
}


// ═══════════════════════════════════════════════════════════════════
// DATA SAFETY LAYER
// localStorage backup + soft delete + audit log + recovery
// ═══════════════════════════════════════════════════════════════════

// ── localStorage backup (secondary safety net) ────────────────────
const LS_BACKUP_KEY = 'dcd-tasks-safety-backup';
const LS_AUDIT_KEY  = 'dcd-audit-log';
const LS_TRASH_KEY  = 'dcd-trash';

function lsBackupSave(taskArr) {
  try {
    localStorage.setItem(LS_BACKUP_KEY, JSON.stringify({
      tasks:   taskArr,
      savedAt: new Date().toISOString(),
      count:   taskArr.length,
      by:      currentUser?.email || 'system'
    }));
  } catch(e) { /* localStorage might be full — ignore */ }
}

function lsBackup() {
  try { const raw = localStorage.getItem(LS_BACKUP_KEY); if(!raw) return []; const obj = JSON.parse(raw); return Array.isArray(obj?.tasks) ? obj.tasks : []; }
  catch(e) { return []; }
}

function lsBackupMeta() {
  try { const raw = localStorage.getItem(LS_BACKUP_KEY); if(!raw) return null; return JSON.parse(raw); }
  catch(e) { return null; }
}

function tryRestoreFromLocalStorage() {
  const backup = lsBackup();
  // Only show banner if we actually have TASKS in backup (not just calendar events)
  if(backup.length > 0 && tasks.length === 0) {
    const meta = lsBackupMeta();
    const when = meta?.savedAt ? new Date(meta.savedAt).toLocaleString('en-IN') : 'unknown time';
    showRecoveryBanner(backup.length, when);
  }
}

// ── First-time seed (only when database is genuinely new) ─────────
let _seededOnce = false;
function safeSeedOnce() {
  if(_seededOnce) return;
  _seededOnce = true;
  // Only seed if no localStorage backup either (truly brand new)
  const lsBk = lsBackup();
  if(lsBk.length > 0) {
    // Firebase empty but localStorage has data — restore from backup
    tasks = lsBk;
    fbReady = true;
    renderAll();
    saveTasks(); // push backup back to Firebase
    toast('⚠ Firebase was empty — restored ' + lsBk.length + ' tasks from local backup.', 'success');
    return;
  }
  // Truly first use — seed with sample tasks
  withToken(token=>{
    fetch(DB_TASKS+'?auth='+token,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(SEED_TASKS)})
    .then(r=>r.json()).then(()=>{ tasks=SEED_TASKS; fbReady=true; renderAll(); lsBackupSave(SEED_TASKS); })
    .catch(()=>{});
  });
}

// ── Soft delete / Trash ───────────────────────────────────────────
let deletedTasks = [];

function loadTrash() {
  try { const raw = localStorage.getItem(LS_TRASH_KEY); if(raw) deletedTasks = JSON.parse(raw); } catch(e){}
}

function saveTrash() {
  // Keep trash for 30 days, max 200 items
  const cutoff = new Date(); cutoff.setDate(cutoff.getDate()-30);
  deletedTasks = deletedTasks.filter(t=>{
    if(!t.deletedAt) return true;
    return new Date(t.deletedAt) > cutoff;
  }).slice(0, 200);
  try { localStorage.setItem(LS_TRASH_KEY, JSON.stringify(deletedTasks)); } catch(e){}
}

// ── Audit Log ─────────────────────────────────────────────────────
let auditLog = [];

function loadAuditLog() {
  try { const raw = localStorage.getItem(LS_AUDIT_KEY); if(raw) auditLog = JSON.parse(raw); } catch(e){}
}

function addAuditLog(action, entity, id, label, extra) {
  const entry = {
    action, entity, id, label,
    by: currentUser?.email || currentUser?.displayName || 'unknown',
    at: new Date().toISOString(),
    extra: extra||null
  };
  auditLog.unshift(entry);
  if(auditLog.length > 500) auditLog = auditLog.slice(0,500);
  try { localStorage.setItem(LS_AUDIT_KEY, JSON.stringify(auditLog)); } catch(e){}
}

// ── Recovery banner ───────────────────────────────────────────────
function showRecoveryBanner(count, when) {
  const banner = document.getElementById('recovery-banner');
  const msg    = document.getElementById('recovery-msg');
  if(!banner||!msg) return;
  // Only show if we genuinely lost TASKS (not calendar events)
  if(count === 0) return;
  msg.textContent = `⚠ Firebase appears empty but a local backup of ${count} tasks from ${when} was found.`;
  banner.style.display = 'block';
}

function hideRecoveryBanner() {
  const banner = document.getElementById('recovery-banner');
  if(banner) banner.style.display = 'none';
}

function restoreFromBackup() {
  const backup = lsBackup();
  if(!backup.length) { toast('No local backup found.','error'); return; }
  if(!confirm('Restore ' + backup.length + ' tasks from local backup to Firebase? This will overwrite current Firebase data.')) return;
  tasks = backup;
  fbReady = true;
  saveTasks();
  renderAll();
  hideRecoveryBanner();
  addAuditLog('restore','tasks','*', backup.length + ' tasks restored from local backup');
  toast('✅ Restored ' + backup.length + ' tasks from local backup.','success');
}

// ── Data Recovery modal ───────────────────────────────────────────
function openRecoveryModal() {
  const meta   = lsBackupMeta();
  const trash  = deletedTasks;
  const lsTasks= lsBackup();

  let html = '';

  // Firebase direct check instructions
  html += '<div style="background:var(--amber-glow);border:1px solid rgba(245,158,11,.3);border-radius:8px;padding:12px 14px;margin-bottom:14px;font-size:12px;color:var(--amber);">';
  html += '<strong>Step 1 — Check Firebase directly:</strong><br>';
  html += 'Go to <a href="https://console.firebase.google.com" target="_blank" style="color:var(--blue);">console.firebase.google.com</a> → your project → Realtime Database → <code>tasks</code> node.<br>';
  html += 'If your tasks are there, the issue is a frontend display bug. If it shows only 3 rows (T-0001 to T-0003), the seed bug replaced your data.</div>';

  // LocalStorage backup info
  html += '<div class="form-section-divider full" style="padding:8px 0 4px;"><span>Local Backup</span></div>';
  if(meta && lsTasks.length > 0) {
    html += `<div style="background:var(--green-glow);border:1px solid rgba(16,185,129,.3);border-radius:8px;padding:12px 14px;margin-bottom:10px;font-size:12px;color:var(--green);">`;
    html += `✅ Local backup found: <strong>${lsTasks.length} tasks</strong> saved on <strong>${new Date(meta.savedAt).toLocaleString('en-IN')}</strong> by ${meta.by||'unknown'}.</div>`;
    html += `<button class="btn btn-success btn-sm" onclick="restoreFromBackup();closeRecoveryModal();">⬆ Restore ${lsTasks.length} Tasks from Backup</button>&nbsp;`;
    html += `<button class="btn btn-ghost btn-sm" onclick="downloadBackupAsJSON()">⬇ Download Backup JSON</button>`;
  } else {
    html += '<div style="font-size:12px;color:var(--text3);padding:8px 0;">No local backup found. This may be because the browser was cleared, or the dashboard never successfully saved to localStorage on this device.</div>';
  }

  // Trash (soft-deleted tasks)
  html += '<div class="form-section-divider full" style="padding:8px 0 4px;margin-top:10px;"><span>Recently Deleted Tasks (30-day Trash)</span></div>';
  if(trash.length) {
    html += `<div style="max-height:180px;overflow-y:auto;font-size:12px;">`;
    html += `<table style="width:100%;border-collapse:collapse;">`;
    html += `<thead><tr><th style="text-align:left;padding:5px 8px;color:var(--text3);font-size:10px;border-bottom:1px solid var(--border);">Task</th><th style="padding:5px 8px;color:var(--text3);font-size:10px;border-bottom:1px solid var(--border);">Deleted At</th><th style="padding:5px 8px;border-bottom:1px solid var(--border);"></th></tr></thead>`;
    html += `<tbody>` + trash.slice(0,50).map(t=>`
      <tr style="border-bottom:1px solid var(--border);">
        <td style="padding:7px 8px;color:var(--text2);">${h(t.task||'').slice(0,60)}<br><span style="font-size:10px;color:var(--text3);">by ${h(t.deletedBy||'unknown')}</span></td>
        <td style="padding:7px 8px;font-size:10px;color:var(--text3);">${t.deletedAt||'—'}</td>
        <td style="padding:7px 8px;"><button class="btn btn-success btn-sm" onclick="restoreFromTrash('${t.id}')">Restore</button></td>
      </tr>`).join('') + `</tbody></table></div>`;
  } else {
    html += '<div style="font-size:12px;color:var(--text3);padding:8px 0;">No recently deleted tasks in trash.</div>';
  }

  // Audit log
  html += '<div class="form-section-divider full" style="padding:8px 0 4px;margin-top:10px;"><span>Recent Audit Log</span></div>';
  if(auditLog.length) {
    html += `<div style="max-height:180px;overflow-y:auto;font-family:var(--mono);font-size:11px;color:var(--text2);">`;
    html += auditLog.slice(0,30).map(e=>`
      <div style="padding:5px 0;border-bottom:1px solid var(--border);">
        <span style="color:var(--text3);">${new Date(e.at).toLocaleString('en-IN')}</span>
        <span style="color:var(--blue);margin:0 6px;">[${e.action.toUpperCase()}]</span>
        <span>${h(e.entity)} — ${h(e.label||e.id||'')}</span>
        <span style="color:var(--text3);"> by ${h(e.by||'unknown')}</span>
      </div>`).join('');
    html += '</div>';
  } else {
    html += '<div style="font-size:12px;color:var(--text3);padding:8px 0;">No audit log entries yet.</div>';
  }

  // Add calendar recovery section
  html += '<div class="form-section-divider full" style="padding:8px 0 4px;margin-top:12px;"><span>📅 Personal Calendar Recovery</span></div>';
  const calAllFound = searchAllCalendarStorage();
  if(calAllFound.length > 0) {
    const byKey = {};
    calAllFound.forEach(ev => { (byKey[ev._foundIn]=byKey[ev._foundIn]||[]).push(ev); });
    html += `<div style="background:rgba(0,191,165,.08);border:1px solid rgba(0,191,165,.25);border-radius:8px;padding:12px 14px;margin-bottom:10px;font-size:12px;">`;
    html += `<div style="font-weight:700;color:var(--corp-teal);margin-bottom:6px;">✅ Found ${calAllFound.length} calendar events across ${Object.keys(byKey).length} storage location(s):</div>`;
    Object.entries(byKey).forEach(([k,evs]) => {
      html += `<div style="font-size:11px;color:var(--text2);">📂 ${k}: ${evs.length} event(s)</div>`;
    });
    html += `<div style="margin-top:8px;display:flex;gap:8px;">
      <button class="btn btn-success btn-sm" onclick="restoreCalendarFromRecovery()">♻ Restore All ${calAllFound.length} Events</button>
      <button class="btn btn-ghost btn-sm" onclick="exportCalendarJSON()">⬇ Export Calendar JSON</button>
    </div>`;
    html += '</div>';
    html += '<div style="font-size:11px;color:var(--text3);margin-bottom:8px;">Recent events found:</div>';
    html += '<div style="max-height:150px;overflow-y:auto;">';
    html += calAllFound.slice(0,20).map(ev =>
      `<div style="font-size:11px;padding:4px 0;border-bottom:1px solid var(--border);display:flex;gap:8px;">
        <span style="color:var(--corp-teal);min-width:80px;">${ev.date||'?'}</span>
        <span style="flex:1;">${ev.title||'?'}</span>
        <span style="color:var(--text3);">${ev.startTime||''}–${ev.endTime||''}</span>
      </div>`).join('');
    html += '</div>';
  } else {
    html += '<div style="font-size:12px;color:var(--text3);padding:8px 0;">No calendar events found in any storage location on this browser. If you used a different browser or device, events would be stored there.</div>';
    html += '<div style="font-size:11px;color:var(--amber);margin-top:6px;">⚠ Data loss reason: Calendar data is stored per-browser. Switching browsers, clearing browser data, or using private/incognito mode will lose data.</div>';
  }
  html += '<div style="display:flex;gap:8px;margin-top:8px;">';
  html += '<button class="btn btn-ghost btn-sm" onclick="importCalendarJSON()">📂 Import Calendar JSON</button>';
  html += '</div>';

  // Add Full Backup section at top
  const fullBackupHtml = `
    <div style="background:linear-gradient(135deg,rgba(0,191,165,.1),rgba(0,191,165,.05));border:2px solid rgba(0,191,165,.4);border-radius:10px;padding:16px;margin-bottom:16px;">
      <div style="font-size:13px;font-weight:800;color:var(--corp-teal);margin-bottom:6px;">📦 Full Dashboard Backup</div>
      <div style="font-size:11px;color:var(--text2);margin-bottom:12px;">
        Export or import <strong>everything</strong> — tasks, archive, employees, projects, notes and all 3 calendars — in one JSON file.
        Use this to transfer data to a new dashboard or restore after data loss.
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <button class="btn btn-primary" onclick="exportFullBackup()" style="font-size:12px;padding:8px 18px;">
          ⬇ Export Full Backup
        </button>
        <button class="btn btn-ghost" onclick="importFullBackup()" style="font-size:12px;padding:8px 18px;">
          📂 Import Full Backup
        </button>
      </div>
    </div>
  `;
  document.getElementById('recovery-modal-body').innerHTML = fullBackupHtml + html;
  document.getElementById('recovery-modal').classList.add('open');
}

function restoreCalendarFromRecovery() {
  loadCalendar();
  closeRecoveryModal();
  toast('🔄 Calendar refreshed from Firebase.','success');
}

function exportCalendarJSON() {
  const data = { events: calEvents, exportedAt: new Date().toISOString(), count: calEvents.length };
  const blob = new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob);
  a.download='MyCalendar-backup-'+dateStr(new Date())+'.json'; a.click(); URL.revokeObjectURL(a.href);
  toast('Calendar exported as JSON.','success');
}

function importCalendarJSON() {
  const input = document.createElement('input');
  input.type='file'; input.accept='.json';
  input.onchange = e => {
    const file=e.target.files[0]; if(!file)return;
    const reader=new FileReader();
    reader.onload=ev=>{
      try {
        const data=JSON.parse(ev.target.result);
        const events=data.events||data;
        if(!Array.isArray(events)) throw new Error('Invalid format');
        if(!confirm('Import '+events.length+' calendar events? Existing events will be kept (merged).')) return;
        calEvents=mergeCalEvents(calEvents,events);
        saveCalendar();
        closeRecoveryModal();
        toast('✅ Imported '+events.length+' events.','success');
      } catch(err){ toast('Invalid calendar file: '+err.message,'error'); }
    };
    reader.readAsText(file);
  };
  input.click();
}

function closeRecoveryModal() {
  document.getElementById('recovery-modal').classList.remove('open');
}

function downloadBackupAsJSON() {
  const backup = lsBackup();
  const blob = new Blob([JSON.stringify({tasks:backup, exportedAt:new Date().toISOString()},null,2)],{type:'application/json'});
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
  a.download = 'task-backup-'+todayStr()+'.json'; a.click(); URL.revokeObjectURL(a.href);
  toast('Backup downloaded.','success');
}

function restoreFromTrash(taskId) {
  const idx = deletedTasks.findIndex(t=>t.id===taskId);
  if(idx<0) return;
  const t = {...deletedTasks[idx]};
  delete t.deletedAt; delete t.deletedBy;
  tasks.push(t);
  deletedTasks.splice(idx,1);
  saveTasks(); saveTrash();
  addAuditLog('restore','task',t.id, t.task?.slice(0,60)||t.id);
  toast('Task restored: '+((t.task||'').slice(0,40)||t.id),'success');
  closeRecoveryModal();
}


// ═══════════════════════════════════════════════════════════════════
// FIREBASE PERMISSION ERROR HANDLER
// Detects expired test-mode rules and shows exact fix steps
// ═══════════════════════════════════════════════════════════════════
let _firebaseErrorShown = false;

function handleFirebasePermissionError(status, operation) {
  if(_firebaseErrorShown) return;
  _firebaseErrorShown = true;
  setConn('err','Blocked');
  const banner = document.getElementById('firebase-error-banner');
  if(banner) banner.style.display = 'block';
  const title = document.getElementById('fb-err-title');
  if(title) title.textContent = `Firebase ${status} Error — Cannot ${operation}. Your data is safe but access is blocked.`;
  addAuditLog('error','firebase','*',`HTTP ${status} on ${operation} — rules likely expired`);
  console.error(`Firebase ${status}: ${operation} blocked. Fix your Realtime Database rules.`);
}

function hideFirebaseError() {
  _firebaseErrorShown = false;
  const banner = document.getElementById('firebase-error-banner');
  if(banner) banner.style.display = 'none';
}

// ═══════════════════════════════════════════════════════════════════
// EXCEL BACKUP & EXPORT SYSTEM
// • In-memory snapshot updated every 30 sec (reliable interval)
// • On-demand download always uses latest live data
// • Full field export — all task columns
// • Admin = all tasks; Department user = own dept only
// ═══════════════════════════════════════════════════════════════════

let _excelSnapshot = [];      // in-memory backup of all tasks
let _excelLastUpdate = null;  // timestamp of last snapshot
let _excelTimer = null;       // interval timer

function startExcelBackupTimer() {
  // Update snapshot every 30 seconds (safe browser interval)
  _excelTimer = setInterval(updateExcelSnapshot, 60000);
  updateExcelSnapshot(); // immediate first snapshot
}

function updateExcelSnapshot() {
  if(!tasks || tasks.length===0) return;
  _excelSnapshot = JSON.parse(JSON.stringify(tasks)); // deep clone
  _excelLastUpdate = new Date();
  updateExcelSyncBadge();
}

function updateExcelSyncBadge() {
  const badge = document.getElementById('excel-sync-label');
  if(!badge) return;
  if(!_excelLastUpdate){ badge.textContent='Excel Ready'; return; }
  const secs = Math.round((new Date()-_excelLastUpdate)/1000);
  badge.textContent = secs < 5 ? 'Excel Synced' : `Excel: ${secs}s ago`;
}

// Refresh badge text every 5 seconds
setInterval(updateExcelSyncBadge, 30000);

// ── Role check ────────────────────────────────────────
function currentUserIsAdmin() {
  if(!currentUser) return false;
  // Check employees list — Director = admin
  const emp = employees.find(e =>
    (e.email && e.email.toLowerCase()===currentUser.email.toLowerCase()) ||
    (e.name && currentUser.displayName && e.name.toLowerCase()===currentUser.displayName.toLowerCase())
  );
  return emp ? emp.isDirector===true : false;
}

function currentUserDept() {
  if(!currentUser) return '';
  const emp = employees.find(e =>
    (e.email && e.email.toLowerCase()===currentUser.email.toLowerCase()) ||
    (e.name && currentUser.displayName && e.name.toLowerCase()===currentUser.displayName.toLowerCase())
  );
  return emp ? (emp.department||'') : '';
}

// ── Main Excel download function ──────────────────────
function downloadFullExcel(scope) {
  const isAdmin = canExportAll();
  const userDept = currentUserDept();

  // Access control
  if(scope==='all' && !isAdmin) {
    toast('⚠ Admin (Director) access required to download all tasks. Use "Export My Dept" instead.','error');
    return;
  }

  loadXLSX(() => {
    // Always use latest live tasks (not snapshot) for download accuracy
    let exportTasks = JSON.parse(JSON.stringify(tasks));

    // Department filter for non-admin
    if(scope==='dept') {
      if(userDept) {
        exportTasks = exportTasks.filter(t=>t.dept===userDept);
        if(exportTasks.length===0) {
          toast('No tasks found for your department: '+userDept,'error'); return;
        }
      }
    }

    const wb = XLSX.utils.book_new();

    // ── Sheet 1: Full Task Data ──────────────────────────
    const headers = [
      'Task ID','Capture Date','Task Title','Department','Dept (Other)',
      'Concerned Person','Projects','Task Type','Task Type (Other)',
      'Priority','Status','Task Owner','Owner (Other)','Assigned By',
      'Deadline','Follow-up Date','Recurrence','Next Follow-up',
      'Next Action','Dependency / Constraint',
      'Remarks / Closure Notes','Closed Date',
      'Created By','Last Update'
    ];

    const rows = exportTasks.map(t => [
      t.id||'',
      t.captureDate||'',
      t.task||'',
      t.dept||'',
      t.deptOther||'',
      t.concernedPerson||'',
      Array.isArray(t.projects)?t.projects.join(', '):(t.project||''),
      t.taskType||'',
      t.taskTypeOther||'',
      t.priority||'',
      t.status||'',
      t.owner||'',
      t.ownerOther||'',
      t.assignedBy||'',
      t.deadline||'',
      t.followup||'',
      t.followupRecurrence||'',
      t.nextFollowup||'',
      t.nextAction||'',
      t.dependency||'',
      t.remarks||'',
      t.closedDate||'',
      t.createdBy||'',
      t.lastUpdate||''
    ]);

    const ws = XLSX.utils.aoa_to_sheet([headers, ...rows]);
    // Column widths
    const colWidths = [10,13,40,22,15,25,20,16,16,16,14,18,15,16,13,13,14,13,35,25,30,13,25,13];
    ws['!cols'] = colWidths.map(w=>({wch:w}));
    // Freeze header row
    ws['!freeze'] = {xSplit:0,ySplit:1};
    XLSX.utils.book_append_sheet(wb, ws, 'Tasks');

    // ── Sheet 2: Summary by Department ──────────────────
    const deptMap = {};
    exportTasks.forEach(t=>{
      const d=t.dept||'Other';
      if(!deptMap[d]) deptMap[d]={dept:d,total:0,open:0,done:0,overdue:0,blocked:0};
      deptMap[d].total++;
      if(t.status==='Done') deptMap[d].done++;
      else { deptMap[d].open++;
        if(t.deadline && new Date(t.deadline)<new Date()) deptMap[d].overdue++;
        if(t.status==='Blocked') deptMap[d].blocked++;
      }
    });
    const sumHeaders = ['Department','Total Tasks','Open','Done','Overdue','Blocked'];
    const sumRows = Object.values(deptMap).map(r=>[r.dept,r.total,r.open,r.done,r.overdue,r.blocked]);
    const ws2 = XLSX.utils.aoa_to_sheet([sumHeaders,...sumRows]);
    ws2['!cols'] = [{wch:24},{wch:13},{wch:10},{wch:10},{wch:10},{wch:10}];
    XLSX.utils.book_append_sheet(wb, ws2, 'Dept Summary');

    // ── Sheet 3: Audit Log ───────────────────────────────
    if(auditLog.length) {
      const aHeaders=['Timestamp','Action','Entity','ID','Details','By'];
      const aRows=auditLog.slice(0,200).map(e=>[
        e.at?new Date(e.at).toLocaleString('en-IN'):'',
        e.action||'',e.entity||'',e.id||'',e.label||e.extra||'',e.by||''
      ]);
      const ws3=XLSX.utils.aoa_to_sheet([aHeaders,...aRows]);
      ws3['!cols']=[{wch:22},{wch:12},{wch:12},{wch:14},{wch:45},{wch:28}];
      XLSX.utils.book_append_sheet(wb, ws3, 'Audit Log');
    }

    // ── Sheet 4: Export Metadata ──────────────────────────
    const meta = [
      ['Export Details',''],
      ['Exported By', currentUser?.displayName||currentUser?.email||'Unknown'],
      ['Export Time', new Date().toLocaleString('en-IN')],
      ['Scope', scope==='all'?'All Departments (Admin)':'Department: '+userDept],
      ['Total Records', exportTasks.length],
      ['Dashboard URL', window.location.href],
      ['Firebase Project', FIREBASE_CONFIG.projectId||''],
    ];
    const ws4=XLSX.utils.aoa_to_sheet(meta);
    ws4['!cols']=[{wch:22},{wch:50}];
    XLSX.utils.book_append_sheet(wb, ws4, 'Export Info');

    const filename = `SHEngitech-Tasks-${scope==='dept'?userDept+'-':''}${todayStr()}.xlsx`;
    XLSX.writeFile(wb, filename);

    addAuditLog('export','tasks','*',
      `${exportTasks.length} tasks exported to Excel (${scope==='all'?'Admin - All depts':'Dept: '+userDept}) by ${currentUser?.email||'unknown'}`
    );
    toast(`✅ Exported ${exportTasks.length} tasks to ${filename}`,'success');
  });
}


// ═══════════════════════════════════════════════════════════════════
// QUICK NOTES SYSTEM
// ═══════════════════════════════════════════════════════════════════

function toggleQN(ctx) {
  const body   = document.getElementById('qn-body-'+ctx);
  const toggle = document.getElementById('qn-toggle-'+ctx);
  if(!body||!toggle) return;
  const open = body.style.display!=='none';
  body.style.display = open ? 'none' : '';
  toggle.textContent = open ? '▾' : '▴';
}

function saveNote(ctx) {
  const type = document.getElementById('qn-type-'+ctx)?.value || 'Follow Up';
  const text = (document.getElementById('qn-text-'+ctx)?.value || '').trim();
  if(!text) { toast('Please write something before saving a note.','error'); return; }
  const note = {
    id:       'N-'+Date.now(),
    type,
    text,
    createdAt: new Date().toISOString(),
    createdBy: currentUser?.email || 'unknown',
    displayName: currentUser?.displayName || currentUser?.email || 'unknown',
    pinned: false
  };
  notes.unshift(note);
  document.getElementById('qn-text-'+ctx).value = '';
  saveNotes();
  renderNotes();
  addActivityLog('note', 'note', note.id, `[${type}] ${text.slice(0,60)}`);
  toast('Note saved.','success');
}

function clearQN(ctx) {
  const ta = document.getElementById('qn-text-'+ctx);
  if(ta) ta.value = '';
}

function deleteNote(id) {
  notes = notes.filter(n=>n.id!==id);
  saveNotes(); renderNotes();
  addActivityLog('delete','note',id,'Note deleted');
}

function pinNote(id) {
  const n = notes.find(x=>x.id===id);
  if(n) n.pinned = !n.pinned;
  saveNotes(); renderNotes();
}

function renderNotes() {
  // Sort: pinned first, then newest
  const sorted = [...notes].sort((a,b)=>{
    if(a.pinned&&!b.pinned) return -1;
    if(!a.pinned&&b.pinned) return 1;
    return new Date(b.createdAt)-new Date(a.createdAt);
  });

  ['dash','task'].forEach(ctx=>{
    const container = document.getElementById('qn-cards-'+ctx);
    const badge     = document.getElementById('qn-badge-'+ctx);
    if(badge) badge.textContent = notes.length + ' note' + (notes.length!==1?'s':'');
    if(!container) return;
    if(!sorted.length) {
      container.innerHTML = '<div style="font-size:12px;color:var(--text3);padding:8px 0;">No notes yet. Write one above and click Save Note.</div>';
      return;
    }
    container.innerHTML = sorted.slice(0,20).map(n=>{
      const isFollowUp = n.type==='Follow Up';
      const when = new Date(n.createdAt).toLocaleString('en-IN',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'});
      return `<div class="qn-card${n.pinned?' pinned':''}">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
          <span class="qn-card-tag ${isFollowUp?'followup':'dept'}">${isFollowUp?'📌':'🏢'} ${h(n.type)}</span>
          <div style="display:flex;gap:3px;">
            <button class="qn-card-pin" onclick="pinNote('${n.id}')" title="${n.pinned?'Unpin':'Pin'}">${n.pinned?'⭐':'☆'}</button>
            <button class="qn-card-del" onclick="deleteNote('${n.id}')" title="Delete note">✕</button>
          </div>
        </div>
        <div class="qn-card-text">${h(n.text)}</div>
        <div class="qn-card-meta">
          <span>${h(n.displayName||n.createdBy||'')}</span>
          <span>${when}</span>
        </div>
      </div>`;
    }).join('');
  });
}


function updateArchiveNavCount() {
  const el = document.getElementById('archive-nav-count');
  if(el) el.textContent = archived.length;
}
function saveArchive() {
  withToken(token=>{
    fetch(DB_ARCHIVE+'?auth='+token,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(archived)})
    .then(r=>{ if(r.status===401||r.status===403){handleFirebasePermissionError(r.status,'save archive');return;} })
    .catch(()=>{});
    try{localStorage.setItem('dcd-archive-backup',JSON.stringify(archived));}catch(e){}
    updateArchiveNavCount();
  });
}

function moveToArchive(taskId) {
  const idx = tasks.findIndex(t=>t.id===taskId);
  if(idx<0) return false;
  const t = tasks[idx];
  // Set archive metadata
  t.status      = 'Done';
  t.closedDate  = t.closedDate || todayStr();
  t.archivedAt  = new Date().toISOString();
  // Move from tasks → archived
  archived.unshift({...t});   // add to front of archive
  tasks.splice(idx, 1);       // remove from active tasks
  addActivityLog('archive','task',t.id,'Archived: '+(t.task||'').slice(0,60));
  saveTasks();
  saveArchive();
  renderAll();
  return true;
}

function saveNotes() {
  withToken(token=>{
    fetch(DB_NOTES+'?auth='+token,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(notes)})
    .then(r=>{ if(r.status===401||r.status===403){handleFirebasePermissionError(r.status,'save notes');return;} })
    .catch(()=>{});
    // Always localStorage backup
    try{localStorage.setItem('dcd-notes-backup',JSON.stringify(notes));}catch(e){}
  });
}

// ═══════════════════════════════════════════════════════════════════
// ARCHIVE SYSTEM — Completed tasks auto-archived, never deleted
// ═══════════════════════════════════════════════════════════════════

function getArchivedTasks() {
  // Archive is ONLY the separate archived array — Done tasks are moved here
  return [...archived].sort((a,b)=>{
    const da = a.archivedAt||a.closedDate||a.lastUpdate||'';
    const db = b.archivedAt||b.closedDate||b.lastUpdate||'';
    return db.localeCompare(da);
  });
}


function renderArchive() {
  const search  = (document.getElementById('arc-search')?.value||'').toLowerCase();
  const deptF   = document.getElementById('arc-dept')?.value||'';
  const projF   = document.getElementById('arc-proj')?.value||'';

  let arc = getArchivedTasks().filter(t=>{
    if(search && !(t.task||'').toLowerCase().includes(search) && !(t.id||'').toLowerCase().includes(search)) return false;
    if(deptF && t.dept!==deptF) return false;
    if(projF && !getTaskProjects(t).includes(projF)) return false;
    return true;
  });

  const countEl = document.getElementById('arc-count');
  if(countEl) countEl.textContent = `${arc.length} archived task${arc.length!==1?'s':''}`;

  // Populate dept filter
  const deptEl = document.getElementById('arc-dept');
  if(deptEl && deptEl.options.length<=1) {
    const depts=[...new Set(getArchivedTasks().map(t=>t.dept).filter(Boolean))].sort();
    const cur=deptEl.value;
    deptEl.innerHTML='<option value="">All Depts</option>'+depts.map(d=>`<option>${d}</option>`).join('');
    if(cur)deptEl.value=cur;
  }

  const tbody = document.getElementById('archive-tbody');
  if(!tbody) return;
  if(!arc.length){
    tbody.innerHTML=`<tr><td colspan="11" class="empty-state"><div class="empty-icon">📦</div><strong>No archived tasks</strong><br><span style='font-size:11px;color:var(--text3);'>When a task is marked as Done, it automatically moves here and disappears from the active task list.</span></td></tr>`;
    return;
  }
  tbody.innerHTML = arc.map(t=>{
    const projs = getTaskProjects(t);
    const projTags = projs.length ? projs.map(p=>`<span style="display:inline-flex;background:var(--blue-glow);color:var(--blue);border:1px solid rgba(59,130,246,.25);border-radius:3px;padding:1px 5px;font-size:10px;font-family:var(--mono);margin:1px;">${h(p)}</span>`).join(' ') : '—';
    return `<tr style="opacity:.85;">
      <td class="mono sm" style="color:var(--green);">${t.id}</td>
      <td class="sm c-gray">${fmtDate(t.closedDate||t.archivedAt||t.lastUpdate)}</td>
      <td class="task-cell">${h(t.task||'')}</td>
      <td class="sm">${h(t.dept||'')}</td>
      <td>${projTags}</td>
      <td>${bPri(t.priority)}</td>
      <td class="sm">${h(t.owner||'')}</td>
      <td class="sm c-text2">${fmtDate(t.deadline)}</td>
      <td class="note-cell">${h(t.remarks||'')}</td>
      <td class="sm c-gray">${h(t.createdBy?t.createdBy.split('@')[0]:'')}</td>
      <td>
        <button class="btn btn-ghost btn-sm" onclick="unarchiveTask('${t.id}')" title="Reopen task" style="font-size:10px;">↩ Reopen</button>
      </td>
    </tr>`;
  }).join('');
}

function unarchiveTask(id) {
  const idx = archived.findIndex(x=>x.id===id);
  if(idx<0){ toast('Task not found in archive.','error'); return; }
  const t = {...archived[idx]};
  // Reset to active status
  t.status    = 'In Progress';
  t.archivedAt = '';
  t.closedDate = '';
  // Move from archive back to tasks
  archived.splice(idx, 1);
  tasks.unshift(t);
  saveTasks(); saveArchive();
  addActivityLog('restore','task',t.id,'Reopened from Archive: '+(t.task||'').slice(0,50));
  toast('✅ Task reopened and moved back to active tasks.','success');
  renderAll(); renderArchive();
}

function resetArchiveFilters() {
  ['arc-search','arc-dept','arc-proj'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});
  renderArchive();
}

// ═══════════════════════════════════════════════════════════════════
// ACTIVITY LOG — comprehensive action tracking
// ═══════════════════════════════════════════════════════════════════
let activityLog = [];

function loadActivityLog() {
  try{ const r=localStorage.getItem('dcd-activity-log'); if(r) activityLog=JSON.parse(r); }catch(e){}
}

function addActivityLog(action, entity, id, label, extra, oldVal, newVal) {
  const icons = {create:'✅',update:'✏️',delete:'🗑️',archive:'📦',note:'📝',export:'📊',backup:'💾',error:'❌',restore:'♻️',import:'📥'};
  const entry = {
    action, entity, id: id||'',
    label: label||'',
    extra: extra||'',
    oldVal: oldVal||'',
    newVal: newVal||'',
    by:   currentUser?.displayName || currentUser?.email || 'system',
    email: currentUser?.email||'system',
    at:   new Date().toISOString(),
    icon: icons[action]||'•'
  };
  activityLog.unshift(entry);
  if(activityLog.length>1000) activityLog=activityLog.slice(0,1000);
  try{localStorage.setItem('dcd-activity-log',JSON.stringify(activityLog.slice(0,500)));}catch(e){}
  // Also call old auditLog system for backward compat
  addAuditLog(action,entity,id,label);
  // Re-render if visible
  if(document.getElementById('page-activity')?.classList.contains('active')) renderActivityLog();
}

function renderActivityLog() {
  const filterAction = document.getElementById('act-filter')?.value||'';
  const filtered = filterAction ? activityLog.filter(e=>e.action===filterAction) : activityLog;
  const badge = document.getElementById('activity-count-badge');
  if(badge) badge.textContent=activityLog.length+' entries';
  const wrap = document.getElementById('activity-log-wrap'); if(!wrap)return;
  if(!filtered.length){
    wrap.innerHTML='<div class="empty-state"><div class="empty-icon">📋</div>No activity recorded yet.</div>';
    return;
  }
  wrap.innerHTML = filtered.slice(0,200).map(e=>{
    const when = new Date(e.at).toLocaleString('en-IN',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit'});
    return `<div class="activity-entry">
      <div class="activity-icon ${e.action}">${e.icon||'•'}</div>
      <div class="activity-body">
        <div class="activity-action">${e.action.toUpperCase()} ${e.entity}</div>
        <div class="activity-detail">${h(e.label||e.id||'')}${e.extra?' — '+h(e.extra):''}</div>
        ${e.oldVal||e.newVal?`<div style="font-size:10px;color:var(--text3);margin-top:1px;">${e.oldVal?'<span style="color:var(--red);">Old: '+h(e.oldVal)+'</span> ':''} ${e.newVal?'<span style="color:var(--green);">New: '+h(e.newVal)+'</span>':''}</div>`:''}
        <div style="font-size:10px;color:var(--text3);margin-top:2px;">by ${h(e.by||e.email||'unknown')}</div>
      </div>
      <div class="activity-time">${when}</div>
    </div>`;
  }).join('');
}

function downloadActivityCSV() {
  const lines=['Timestamp,Action,Entity,ID,Details,By'];
  activityLog.forEach(e=>{
    lines.push([
      new Date(e.at).toLocaleString('en-IN'),
      e.action||'',e.entity||'',e.id||'',
      (e.label||'').replace(/,/g,';'),
      e.by||''
    ].map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(','));
  });
  const blob=new Blob([lines.join('\n')],{type:'text/csv'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);
  a.download='activity-log-'+todayStr()+'.csv';a.click();URL.revokeObjectURL(a.href);
  addActivityLog('export','activity-log','*','Activity log downloaded as CSV');
  toast('Activity log downloaded.','success');
}

// ═══════════════════════════════════════════════════════════════════
// AUTO EXCEL BACKUP — generates every 30 seconds automatically
// Browser cannot write to disk automatically, so we pre-generate
// the Excel file in memory. Download is always instant and complete.
// ═══════════════════════════════════════════════════════════════════
let _lastBackupTime  = null;
let _backupGenCount  = 0;

function startExcelBackupTimer() {
  generateExcelBlob(); // immediate first generation
  _excelGenTimer = setInterval(()=>{ generateExcelBlob(); }, 30000); // every 30 seconds
  setInterval(updateBackupBadge, 5000); // update badge text every 5 seconds
}

function generateExcelBlob() {
  if(!tasks) return;
  loadXLSX(()=>{
    try {
      const wb = buildFullWorkbook();
      const wbout = XLSX.write(wb, {bookType:'xlsx', type:'array'});
      // Revoke old blob URL to free memory
      if(_excelBlobUrl) URL.revokeObjectURL(_excelBlobUrl);
      _excelBlob   = new Blob([wbout],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
      _excelBlobUrl= URL.createObjectURL(_excelBlob);
      _lastBackupTime = new Date();
      _backupGenCount++;
      updateBackupBadge();
      updateExcelSnapshot(); // also update legacy snapshot
      // Log backup every 10th generation to avoid flooding activity log
      if(_backupGenCount % 10 === 1) {
        addActivityLog('backup','excel','*',`Auto backup #${_backupGenCount} — ${tasks.length} tasks, ${notes.length} notes`);
        try{localStorage.setItem('dcd-backup-meta',JSON.stringify({at:new Date().toISOString(),taskCount:tasks.length,noteCount:notes.length,gen:_backupGenCount}));}catch(e){}
      }
    } catch(e) { console.warn('Excel backup generation failed:', e); }
  });
}

function buildFullWorkbook() {
  const wb = XLSX.utils.book_new();
  const allTasks  = [...tasks, ...archived]; // active + archived for complete export
  const arcTasks  = getArchivedTasks(); // reads from archived array

  // ── Sheet 1: ALL TASKS (active + done) ──────────────────────────
  const TH = ['Task ID','Capture Date','Task Title','Quick Note','Department','Dept Detail',
    'Concerned Person','Projects','Task Type','Task Type Detail',
    'Priority','Status','Task Owner','Owner Detail','Assigned By',
    'Deadline','Follow-up Date','Recurrence','Next Follow-up',
    'Next Action','Dependency','Remarks','Closed Date',
    'Archived','Created By','Last Update'];
  const taskRows = allTasks.map(t=>[
    t.id||'', t.captureDate||'', t.task||'', t.dept||'', t.deptOther||'',
    t.concernedPerson||'',
    Array.isArray(t.projects)?t.projects.join(', '):(t.project||''),
    t.taskType||'', t.taskTypeOther||'',
    t.priority||'', t.status||'', t.owner||'', t.ownerOther||'', t.assignedBy||'',
    t.deadline||'', t.followup||'', t.followupRecurrence||'', t.nextFollowup||'',
    t.nextAction||'', t.dependency||'', t.remarks||'', t.closedDate||'',
    t.status==='Done'?'Yes':'No',
    t.createdBy||'', t.lastUpdate||''
  ]);
  const ws1=XLSX.utils.aoa_to_sheet([TH,...taskRows]);
  const cw1=[10,12,42,22,15,24,22,15,15,16,14,18,15,16,13,13,14,13,40,26,34,13,8,25,13];
  ws1['!cols']=cw1.map(w=>({wch:w})); ws1['!freeze']={xSplit:0,ySplit:1};
  XLSX.utils.book_append_sheet(wb,ws1,'All Tasks');

  // ── Sheet 2: ACTIVE TASKS only ──────────────────────────────────
  const actRows=allTasks.filter(t=>t.status!=='Done'&&t.status!=='Cancelled').map(t=>[
    t.id||'',t.captureDate||'',t.task||'',t.dept||'',
    Array.isArray(t.projects)?t.projects.join(', '):(t.project||''),
    t.priority||'',t.status||'',t.owner||'',t.deadline||'',t.followup||'',
    t.followupRecurrence||'',t.nextAction||'',t.remarks||'',t.createdBy||''
  ]);
  const ws2=XLSX.utils.aoa_to_sheet([
    ['Task ID','Capture Date','Task','Department','Projects','Priority','Status','Owner','Deadline','Follow-up','Recurrence','Next Action','Remarks','Created By'],
    ...actRows
  ]);
  ws2['!cols']=[10,12,42,22,22,16,14,18,13,13,14,40,34,25].map(w=>({wch:w}));
  ws2['!freeze']={xSplit:0,ySplit:1};
  XLSX.utils.book_append_sheet(wb,ws2,'Active Tasks');

  // ── Sheet 3: ARCHIVE (Completed Tasks) ──────────────────────────
  const arcRows=arcTasks.map(t=>[
    t.id||'',t.closedDate||t.lastUpdate||'',t.task||'',t.dept||'',
    Array.isArray(t.projects)?t.projects.join(', '):(t.project||''),
    t.priority||'',t.owner||'',t.deadline||'',t.remarks||'',t.createdBy||''
  ]);
  const ws3=XLSX.utils.aoa_to_sheet([
    ['Task ID','Completed Date','Task','Department','Projects','Priority','Owner','Deadline','Remarks','Created By'],
    ...arcRows
  ]);
  ws3['!cols']=[10,13,42,22,22,16,18,13,34,25].map(w=>({wch:w}));
  ws3['!freeze']={xSplit:0,ySplit:1};
  XLSX.utils.book_append_sheet(wb,ws3,'Archive (Done Tasks)');

  // ── Sheet 4: QUICK NOTES ────────────────────────────────────────
  if(notes.length) {
    const nRows=notes.map(n=>[
      n.id||'', n.type||'', n.text||'',
      new Date(n.createdAt).toLocaleString('en-IN'),
      n.displayName||n.createdBy||''
    ]);
    const ws4=XLSX.utils.aoa_to_sheet([['Note ID','Type','Note Text','Created At','Created By'],...nRows]);
    ws4['!cols']=[14,20,60,22,25].map(w=>({wch:w}));
    XLSX.utils.book_append_sheet(wb,ws4,'Quick Notes');
  }

  // ── Sheet 5: ACTIVITY LOG ────────────────────────────────────────
  if(activityLog.length) {
    const aRows=activityLog.slice(0,500).map(e=>[
      new Date(e.at).toLocaleString('en-IN'),
      e.action||'',e.entity||'',e.id||'',e.label||'',e.by||e.email||''
    ]);
    const ws5=XLSX.utils.aoa_to_sheet([['Timestamp','Action','Entity','ID','Details','By'],...aRows]);
    ws5['!cols']=[22,12,12,14,50,28].map(w=>({wch:w}));
    XLSX.utils.book_append_sheet(wb,ws5,'Activity Log');
  }

  // ── Sheet 6: DEPT SUMMARY ───────────────────────────────────────
  const dmap={};
  allTasks.forEach(t=>{
    const d=t.dept||'Other';
    if(!dmap[d])dmap[d]={dept:d,total:0,active:0,done:0,overdue:0,blocked:0,followups:0};
    dmap[d].total++;
    if(t.status==='Done') dmap[d].done++;
    else {
      dmap[d].active++;
      if(t.deadline&&new Date(t.deadline)<new Date()) dmap[d].overdue++;
      if(t.status==='Blocked') dmap[d].blocked++;
      if(t.followupRecurrence&&t.followupRecurrence!=='None') dmap[d].followups++;
    }
  });
  const ws6=XLSX.utils.aoa_to_sheet([
    ['Department','Total','Active','Done/Archived','Overdue','Blocked','With Recurrence'],
    ...Object.values(dmap).map(r=>[r.dept,r.total,r.active,r.done,r.overdue,r.blocked,r.followups])
  ]);
  ws6['!cols']=[24,10,10,14,10,10,16].map(w=>({wch:w}));
  XLSX.utils.book_append_sheet(wb,ws6,'Dept Summary');

  // ── Sheet 7: BACKUP METADATA ─────────────────────────────────────
  const ws7=XLSX.utils.aoa_to_sheet([
    ['Field','Value'],
    ['Generated At',new Date().toLocaleString('en-IN')],
    ['Generated By',currentUser?.displayName||currentUser?.email||'System'],
    ['Total Tasks',allTasks.length],
    ['Active Tasks',allTasks.filter(t=>t.status!=='Done'&&t.status!=='Cancelled').length],
    ['Archived Tasks',arcTasks.length],
    ['Quick Notes',notes.length],
    ['Activity Entries',activityLog.length],
    ['Backup #',_backupGenCount],
    ['Firebase Project',FIREBASE_CONFIG.projectId||''],
    ['Dashboard URL',typeof window!=='undefined'?window.location.href:''],
  ]);
  ws7['!cols']=[22,55].map(w=>({wch:w}));
  XLSX.utils.book_append_sheet(wb,ws7,'Backup Info');

  return wb;
}

function updateBackupBadge() {
  const el  = document.getElementById('backup-label');
  const dot = document.getElementById('backup-dot');
  if(!el) return;
  if(!_lastBackupTime){ el.textContent='Backup Pending…'; return; }
  const secs = Math.round((new Date()-_lastBackupTime)/1000);
  if(secs < 5) {
    el.textContent='Backup Saved ✓';
    if(dot){dot.classList.add('pulsing'); setTimeout(()=>dot.classList.remove('pulsing'),3000);}
  } else {
    el.textContent=`Backup ${secs}s ago`;
  }
}

// Override downloadFullExcel to use pre-generated blob
function downloadFullExcel(scope) {
  const isAdmin = canExportAll();
  const userDept = currentUserDept();
  // canExportAll() is true for director, superadmin, and ea.director@shengitech.com
  if(scope==='all' && !canExportAll()) {
    toast('⚠ Director/Admin access required for full export. Use Export My Dept instead.','error'); return;
  }
  loadXLSX(()=>{
    // Always generate fresh for download (most up-to-date data)
    let exportTasks = scope==='dept' && userDept
      ? tasks.filter(t=>t.dept===userDept)
      : tasks;
    if(scope==='dept' && userDept && !exportTasks.length){
      toast('No tasks found for your department: '+userDept,'error'); return;
    }
    // For dept export, filter the workbook manually
    // For admin/all, use the pre-generated blob if fresh enough
    if(_excelBlob && _lastBackupTime && scope==='all') {
      const secs=(new Date()-_lastBackupTime)/1000;
      if(secs < 35) {
        // Use pre-generated blob (< 35 seconds old)
        const a=document.createElement('a');
        a.href=_excelBlobUrl;
        a.download=`SHEngitech-Complete-Backup-${todayStr()}.xlsx`;
        a.click();
        addActivityLog('export','excel','*',`Complete Excel backup downloaded (${tasks.length} tasks, ${notes.length} notes, ${activityLog.length} log entries)`);
        toast(`✅ Downloaded complete backup Excel (${tasks.length} tasks + notes + activity log).`,'success');
        return;
      }
    }
    // Generate fresh
    const wb = buildFullWorkbook();
    const filename=scope==='dept'
      ? `SHEngitech-${userDept}-Tasks-${todayStr()}.xlsx`
      : `SHEngitech-Complete-Backup-${todayStr()}.xlsx`;
    XLSX.writeFile(wb,filename);
    addActivityLog('export','excel','*',`Excel downloaded: ${scope} — ${exportTasks.length} tasks by ${currentUser?.email||'unknown'}`);
    toast(`✅ Downloaded ${filename}`,'success');
  });
}


// ═══════════════════════════════════════════════════════════════════
// ACCESS CONTROL SYSTEM
// ea.director@shengitech.com = Super Admin
// Director employees = Full access
// Department employees = Own department only
// ═══════════════════════════════════════════════════════════════════

function getEmployeeByCurrentUser() {
  if(!currentUser) return null;
  return employees.find(e =>
    (e.email && e.email.toLowerCase().trim() === currentUser.email.toLowerCase().trim()) ||
    (e.name  && currentUser.displayName && e.name.toLowerCase() === currentUser.displayName.toLowerCase())
  ) || null;
}

// ════════════════════════════════════════════════════════════════════
// ACCESS CONTROL — SIMPLE & BULLETPROOF
// Rule: FULL ACCESS by default for all authenticated users.
// ONLY restrict to department-level if user is explicitly in the
// employee list, is NOT a director, AND has a department set.
// ea.director@shengitech.com = permanent Super Admin (hardcoded).
// ════════════════════════════════════════════════════════════════════

// These emails ALWAYS get full admin access — no employee list needed
const FULL_ACCESS_EMAILS = [
  'ea.director@shengitech.com',
  'admin@shengitech.com',
  'director@shengitech.com'
];

function isFullAccessEmail(email) {
  if(!email) return false;
  const e = (email||'').toLowerCase().trim();
  if(FULL_ACCESS_EMAILS.some(a => a.toLowerCase() === e)) return true;
  if(e.endsWith('@shengitech.com') &&
     (e.split('@')[0].includes('director') || e.split('@')[0].includes('admin'))) return true;
  return false;
}

function resolveUserRole() {
  // No user → no access
  if(!currentUser || !currentUser.email) {
    _userRole = 'none'; _userDept = null; return;
  }

  // ★ ALWAYS give full access to hardcoded admin emails
  if(isFullAccessEmail(currentUser.email)) {
    _userRole = 'superadmin'; _userDept = null; return;
  }

  // Check employee list ONLY if it's loaded
  if(employees && employees.length > 0) {
    const emp = getEmployeeByCurrentUser();
    if(emp) {
      // Director in employee list → full access
      if(emp.isDirector === true) {
        _userRole = 'director'; _userDept = null; return;
      }
      // Non-director with department → dept-restricted
      if(emp.department) {
        _userRole = 'department'; _userDept = emp.department; return;
      }
    }
  }

  // Fallback: any authenticated user who isn't explicitly restricted
  // gets full director-level access
  _userRole = 'director'; _userDept = null;
}

// Core permission checks
function hasFullAccess()  { return _userRole === 'superadmin' || _userRole === 'director'; }
function isSuperAdmin()   { return _userRole === 'superadmin'; }
function canAddTask()     { return !!currentUser; }   // any logged-in user can add
function canEditTask(t)   {
  if(hasFullAccess()) return true;
  if(_userRole === 'department') return !t.dept || t.dept === _userDept;
  return !!currentUser; // logged-in users can edit
}
function canDeleteTask(t) { return hasFullAccess() || !!currentUser; }
function canExportAll()   { return hasFullAccess(); }

function getVisibleTasks() {
  // Tasks array should not contain Done tasks (they're in archived)
  // but filter as safety net in case of timing issues
  const active = tasks.filter(t => t.status !== 'Done');
  // Dept-restricted users see only their dept tasks
  if(_userRole === 'department' && _userDept) {
    return active.filter(t => !t.dept || t.dept === _userDept);
  }
  return active;
}

// getVisibleTasks defined in ACL section above

function getTasksForExport(scope) {
  if(scope==='dept') return tasks.filter(t=>t.dept===_userDept);
  if(hasFullAccess()) return tasks;
  return getVisibleTasks();
}

function getRoleBadgeHTML() {
  const labels = {superadmin:'★ Super Admin',director:'Director',department:'Dept User',limited:'Read Only',none:'—'};
  const cls    = {superadmin:'role-superadmin',director:'role-director',department:'role-department',limited:'role-limited',none:'role-limited'};
  const dept   = _userDept ? ' · '+_userDept : '';
  return `<span class="role-badge ${cls[_userRole]||'role-limited'}">${labels[_userRole]||'?'}${dept}</span>`;
}

function applyRoleToUI() {
  resolveUserRole(); // always re-resolve before applying

  // ── Debug log (check browser console if role seems wrong) ──
  applyCalendarAccess();
  applyCalendarPersonAccess();
  console.log('[ACL] Email:', currentUser?.email,
              '| Role:', _userRole,
              '| Dept:', _userDept,
              '| fullAccess:', hasFullAccess());

  // ── Role badge in header ──────────────────────────────────
  const chip = document.getElementById('user-chip');
  if(chip) {
    const existing = chip.querySelector('.role-badge');
    if(existing) existing.remove();
    chip.insertAdjacentHTML('beforeend', getRoleBadgeHTML());
  }

  // ── ALL BUTTONS VISIBLE for admin/director/superadmin ─────
  // Never hide buttons for full-access users
  if(hasFullAccess() || _userRole !== 'department') {
    // Show all action buttons
    const addBtn = document.getElementById('btn-add-task');
    if(addBtn) addBtn.style.display = '';
    ['btn-excel-all','btn-excel-dept','btn-task-tpl','btn-emp-tpl','btn-proj-tpl'].forEach(id=>{
      const el = document.getElementById(id); if(el) el.style.display = '';
    });
    // No dept lock
    const deptSel = document.getElementById('f-dept');
    if(deptSel) { deptSel.disabled = false; deptSel.style.opacity = ''; }
    // Hide access denied banner
    const banner = document.getElementById('access-denied-dash');
    if(banner) banner.classList.remove('visible');
    return; // done — no restrictions apply
  }

  // ── DEPARTMENT USER — apply restrictions ──────────────────
  const addBtn = document.getElementById('btn-add-task');
  if(addBtn) addBtn.style.display = '';  // dept users can still add (to their dept)

  const deptSel = document.getElementById('f-dept');
  if(deptSel && _userDept) {
    deptSel.value = _userDept;
    deptSel.disabled = true;
    deptSel.style.opacity = '.7';
  }

  // Show dept access banner
  const banner = document.getElementById('access-denied-dash');
  if(banner) {
    banner.classList.add('visible');
    const msg = document.getElementById('access-denied-msg-dash');
    if(msg) msg.textContent =
      'You are viewing tasks for your department (' + (_userDept||'assigned dept') +
      ') only. Contact your Director/Admin for broader access.';
  }
}


function populateQNoteEmployeeDropdown() {
  const sel = document.getElementById('qnote-employee'); if(!sel) return;
  const cur = sel.value;
  // Build grouped options: Directors first, then others
  const dirs  = employees.filter(e=>e.status!=='Inactive'&&e.isDirector);
  const others= employees.filter(e=>e.status!=='Inactive'&&!e.isDirector);
  let html = '<option value="">— Select Employee —</option>';
  if(dirs.length){
    html += '<optgroup label="★ Directors">';
    html += dirs.map(e=>`<option value="${h(e.name)}">${h(e.name)}${e.designation?' – '+h(e.designation):''}</option>`).join('');
    html += '</optgroup>';
  }
  if(others.length){
    html += '<optgroup label="Employees">';
    html += others.map(e=>`<option value="${h(e.name)}">${h(e.name)}${e.designation?' – '+h(e.designation):''}</option>`).join('');
    html += '</optgroup>';
  }
  sel.innerHTML = html;
  if(cur) sel.value = cur;
}

let _qnoteAutoSaveTimer = null;
let _qnoteIsDirty       = false;

function openQNote(taskId) {
  const t = tasks.find(x=>x.id===taskId);
  if(!t){ toast('Task not found.','error'); return; }
  _qnoteTaskId = taskId;
  _qnoteIsDirty = false;

  // Populate employee dropdown
  populateQNoteEmployeeDropdown();

  // Set title and task preview
  const title = document.getElementById('qnote-modal-title');
  const prev  = document.getElementById('qnote-task-preview');
  const txt   = document.getElementById('qnote-text');
  const meta  = document.getElementById('qnote-meta');
  const status= document.getElementById('qnote-autosave-status');
  const empSel= document.getElementById('qnote-employee');
  const manualName = document.getElementById('qnote-manual-name');

  if(title)   title.textContent   = '📝 Quick Note — '+taskId;
  if(prev)    prev.textContent    = (t.task||'').slice(0,140)+(t.task?.length>140?'…':'');
  if(txt)     txt.value           = t.taskNote||'';
  if(status)  status.style.opacity= '0';
  if(manualName) manualName.value = '';

  // Pre-select employee from last note author or current user
  if(empSel){
    const lastBy = t.taskNoteUpdatedBy||'';
    // Try to match by name or email
    const matchEmp = employees.find(e=>
      e.name===lastBy || e.email===lastBy ||
      (currentUser?.displayName && e.name===currentUser.displayName) ||
      (currentUser?.email && e.email===currentUser.email)
    );
    empSel.value = matchEmp ? matchEmp.name : '';
  }

  // Show metadata
  if(meta){
    if(t.taskNote && t.taskNoteUpdatedAt){
      meta.innerHTML = `Last updated: <strong>${new Date(t.taskNoteUpdatedAt).toLocaleString('en-IN')}</strong> by <strong>${h(t.taskNoteUpdatedBy||'unknown')}</strong>`;
    } else if(t.taskNote){
      meta.textContent = 'Note exists. Last update time not recorded.';
    } else {
      meta.textContent = 'No quick note yet. Type above — it saves automatically.';
    }
  }

  document.getElementById('qnote-modal').classList.add('open');
  setTimeout(()=>{ if(txt) txt.focus(); }, 80);
}

function closeQNote() {
  // Save any pending changes before closing
  if(_qnoteIsDirty) saveQNoteNow();
  if(_qnoteAutoSaveTimer) { clearTimeout(_qnoteAutoSaveTimer); _qnoteAutoSaveTimer=null; }
  _qnoteTaskId=null; _qnoteIsDirty=false;
  document.getElementById('qnote-modal').classList.remove('open');
}

function onQNoteEmployeeChange() {
  // If employee selected from dropdown, clear manual name field
  const empSel = document.getElementById('qnote-employee');
  const manualName = document.getElementById('qnote-manual-name');
  if(empSel?.value && manualName) manualName.value='';
  scheduleQNoteAutoSave();
}

function getQNoteAuthor() {
  const empSel = document.getElementById('qnote-employee');
  const manualName = document.getElementById('qnote-manual-name');
  if(manualName?.value?.trim()) return manualName.value.trim();
  if(empSel?.value) return empSel.value;
  return currentUser?.displayName || currentUser?.email || 'unknown';
}

function scheduleQNoteAutoSave() {
  _qnoteIsDirty = true;
  if(_qnoteAutoSaveTimer) clearTimeout(_qnoteAutoSaveTimer);
  _qnoteAutoSaveTimer = setTimeout(saveQNoteNow, 800); // auto-save 800ms after last keystroke
}

function saveQNoteNow() {
  if(!_qnoteTaskId) return;
  const idx = tasks.findIndex(t=>t.id===_qnoteTaskId);
  if(idx<0) return;
  const noteText = (document.getElementById('qnote-text')?.value||'').trim();
  const author   = getQNoteAuthor();
  const now      = new Date().toISOString();
  const oldNote  = tasks[idx].taskNote||'';
  // Only save if actually changed
  if(noteText===oldNote && tasks[idx].taskNoteUpdatedBy===author) { _qnoteIsDirty=false; return; }
  tasks[idx].taskNote          = noteText;
  tasks[idx].taskNoteUpdatedAt = now;
  tasks[idx].taskNoteUpdatedBy = author;
  tasks[idx].lastUpdate        = todayStr();
  // Update metadata display
  const meta = document.getElementById('qnote-meta');
  if(meta) meta.innerHTML = `Last updated: <strong>${new Date(now).toLocaleString('en-IN')}</strong> by <strong>${h(author)}</strong>`;
  // Flash auto-save indicator
  const status = document.getElementById('qnote-autosave-status');
  if(status){ status.style.opacity='1'; setTimeout(()=>status.style.opacity='0',2000); }
  // Save to Firebase
  addActivityLog('note','task-note',_qnoteTaskId,`Quick note on ${_qnoteTaskId} by ${author}`,`"${noteText.slice(0,60)}"`);
  saveTasks();
  _qnoteIsDirty = false;
}

function clearQNoteForTask() {
  if(!_qnoteTaskId || !confirm('Clear the quick note for this task?')) return;
  const txt = document.getElementById('qnote-text');
  if(txt) txt.value='';
  _qnoteIsDirty = true;
  saveQNoteNow();
  toast('Quick note cleared.','success');
}

// Alias for backward compatibility
function saveQNote() { saveQNoteNow(); }


function closeQNote() {
  _qnoteTaskId=null;
  document.getElementById('qnote-modal').classList.remove('open');
}

function saveQNote() {
  if(!_qnoteTaskId) return;
  const idx = tasks.findIndex(t=>t.id===_qnoteTaskId);
  if(idx<0){ closeQNote(); return; }
  const oldNote = tasks[idx].taskNote||'';
  const newNote = (document.getElementById('qnote-text').value||'').trim();
  if(oldNote===newNote){ closeQNote(); return; }
  tasks[idx].taskNote          = newNote;
  tasks[idx].taskNoteUpdatedAt = new Date().toISOString();
  tasks[idx].taskNoteUpdatedBy = currentUser?.displayName||currentUser?.email||'unknown';
  tasks[idx].lastUpdate        = todayStr();
  addActivityLog('note','task-note',_qnoteTaskId,
    `Quick note on ${_qnoteTaskId}`,
    `"${newNote.slice(0,80)}"`
  );
  saveTasks();
  closeQNote();
  toast('Quick note saved.','success');
}

// ═══════════════════════════════════════════════════════════════════
// ENHANCED RENDER — exact column format as specified
// Task ID | Capture Date | Task | Department | Concerned Person |
// Quick Note | Projects | Task Type | Status | Priority | Deadline |
// Owner | Assigned By | Follow-up | Recurrence | Next Action |
// Dependency | Age | Days Left | Escalation | Remarks | Closed | By | Actions
// ═══════════════════════════════════════════════════════════════════

const TASK_TABLE_HEADERS = `<tr>
  <th class="f1" style="width:78px;min-width:78px;max-width:78px;">Task ID</th>
  <th class="f2" style="width:94px;min-width:94px;max-width:94px;">Capture Date</th>
  <th class="f3" style="min-width:200px;">Task</th>
  <th style="min-width:160px;">Department</th>
  <th style="min-width:180px;">Concerned Person</th>
  <th style="min-width:220px;">📝 Notes &amp; Remarks</th>
  <th style="min-width:120px;">Status</th>
  <th style="min-width:108px;">Follow-up</th>
  <th style="min-width:105px;">Priority</th>
  <th style="min-width:108px;">Deadline</th>
  <th style="min-width:110px;">Projects</th>
  <th style="min-width:100px;">Task Type</th>
  <th style="min-width:115px;">Owner</th>
  <th style="min-width:100px;">Assigned By</th>
  <th style="min-width:95px;">Recurrence</th>
  <th style="min-width:160px;">Next Action</th>
  <th style="min-width:130px;">Dependency</th>
  <th style="min-width:50px;">Age</th>
  <th style="min-width:60px;">Days Left</th>
  <th style="min-width:90px;">Escalation</th>
  <th style="min-width:90px;">Closed</th>
  <th style="min-width:75px;">By</th>
  <th style="min-width:75px;">Actions</th>
</tr>`;

function buildTaskRow(t, showActions) {
  const age    = calcAge(t);
  const dl     = calcLeft(t);
  const esc    = calcEsc(t);
  const dlStyle = isOpen(t)&&dl!==null&&dl<0 ? 'color:var(--red);font-weight:700;' : dl===0 ? 'color:var(--amber);font-weight:700;' : '';
  const canEdit = canEditTask(t);
  const canDel  = canDeleteTask(t);

  // ── Projects tags ─────────────────────────────────────
  const projs = getTaskProjects(t);
  const projTags = projs.length
    ? projs.map(p=>`<span style="display:inline-flex;background:rgba(0,191,165,.12);color:var(--corp-teal);border:1px solid rgba(0,191,165,.25);border-radius:3px;padding:1px 5px;font-size:9px;font-family:var(--mono);margin:1px;">${h(p)}</span>`).join('')
    : '<span style="color:var(--text3);font-size:10px;">—</span>';

  // ── Col 5: Concerned Person — employee dropdown ────────
  const cpCell = canEdit ? makeCPSelect(t.id, t.concernedPerson||'')
    : `<span style="font-size:11px;">${h(t.concernedPerson||'—')}</span>`;

  // ── Col 6: Notes & Remarks (combined) ─────────────────
  const noteText   = t.taskNote||'';
  const remarkText = t.remarks||'';
  const noteBy     = t.taskNoteUpdatedBy ? `<span style="font-size:9px;color:var(--text3);"> — ${h(t.taskNoteUpdatedBy)}</span>` : '';
  const noteHTML   = noteText
    ? `<div style="font-size:11px;color:var(--text2);white-space:pre-wrap;word-break:break-word;line-height:1.45;">${h(noteText)}${noteBy}</div>`
    : '';
  const remarkHTML = remarkText
    ? `<div style="font-size:10px;color:var(--green);background:rgba(38,166,154,.07);border-left:2px solid rgba(38,166,154,.4);padding:2px 5px;margin-top:3px;white-space:pre-wrap;word-break:break-word;border-radius:0 3px 3px 0;">${h(remarkText)}</div>`
    : '';
  const emptyLabel = !noteText && !remarkText ? `<span style="color:var(--text3);font-size:10px;font-style:italic;">—</span>` : '';
  const noteBtn    = canEdit ? `<button class="plus-note-btn" onclick="openQNote('${t.id}')" title="Quick Note" style="flex-shrink:0;">📝</button>` : '';
  const remarkBtn  = canEdit ? `<button class="plus-remark-btn" onclick="openInlineRemark('${t.id}')" title="Remark" style="flex-shrink:0;">+</button>` : '';

  const notesCell  = `<div style="display:flex;gap:4px;align-items:flex-start;">
    <div style="flex:1;min-width:0;">${noteHTML}${remarkHTML}${emptyLabel}</div>
    <div style="display:flex;flex-direction:column;gap:2px;">${noteBtn}${remarkBtn}</div>
  </div>`;

  // ── Col 7-14: Inline editable dropdowns ───────────────
  const statusCell  = canEdit ? buildStatusCell(t.id, t.status||'') : bStatus(t.status);
  const followupCell= canEdit
    ? `<input type="date" value="${t.followup||''}" title="Follow-up date"
         style="font-size:10px;padding:2px 4px;background:var(--bg2);border:1px solid var(--border);
                border-radius:4px;color:var(--text2);width:108px;cursor:pointer;"
         onchange="inlineUpdate('${t.id}','followup',this.value)">`
    : `<span style="font-size:10px;color:var(--text2);">${fmtDate(t.followup)||'—'}</span>`;
  const priCell     = canEdit ? makeInlineSelect('priority',t.priority||'',L.pris,t.id) : bPri(t.priority);
  const deadlineCell= canEdit
    ? `<input type="date" value="${t.deadline||''}" title="Deadline"
         style="font-size:10px;padding:2px 4px;background:var(--bg2);
                border:1px solid ${dl!==null&&dl<0?'rgba(239,83,80,.5)':'var(--border)'};
                border-radius:4px;color:inherit;width:108px;cursor:pointer;${dlStyle}"
         onchange="inlineUpdate('${t.id}','deadline',this.value)">`
    : `<span style="font-size:10px;${dlStyle}">${fmtDate(t.deadline)||'—'}</span>`;
  const deptCell    = canEdit ? makeInlineSelect('dept',t.dept||'',L.depts,t.id) : `<span style="font-size:11px;">${h(t.dept||'—')}</span>`;
  const typeCell    = canEdit ? makeInlineSelect('taskType',t.taskType||'',L.taskTypes,t.id) : `<span style="font-size:11px;color:var(--text2);">${h(t.taskType||'—')}</span>`;
  const ownerCell   = canEdit ? makeInlineSelect('owner',t.owner||'',L.owners,t.id) : `<span style="font-size:11px;">${h(t.owner||'—')}</span>`;
  const recurCell   = canEdit ? makeInlineSelect('followupRecurrence',t.followupRecurrence||'None',L.recurrence,t.id) : bRecur(t.followupRecurrence);

  // ── Actions ───────────────────────────────────────────
  const actions = showActions ? `<div style="display:flex;gap:3px;align-items:center;flex-wrap:wrap;">
    ${canEdit ? `<button class="btn btn-ghost btn-sm btn-icon" onclick="openEdit('${t.id}')" title="Edit">✏️</button>` : ''}
    ${canDel   ? `<button class="btn btn-danger btn-sm btn-icon" onclick="confirmDel('${t.id}')" title="Delete">🗑</button>` : ''}
  </div>` : '';

  return `<tr>
    <td class="f1" style="width:78px;min-width:78px;max-width:78px;"><span class="task-id-link" onclick="openEdit('${t.id}')">${t.id}</span></td>
    <td class="f2" style="width:94px;min-width:94px;max-width:94px;font-size:10px;color:var(--text3);white-space:nowrap;">${fmtDate(t.captureDate)}</td>
    <td class="f3" style="min-width:200px;white-space:pre-wrap;word-break:break-word;font-size:11px;line-height:1.5;">${h(t.task||'')}</td>
    <td style="white-space:normal;word-break:break-word;max-width:200px;">${deptCell}</td>
    <td style="white-space:normal;word-break:break-word;max-width:220px;">${cpCell}</td>
    <td>${notesCell}</td>
    <td>${statusCell}</td>
    <td>${followupCell}</td>
    <td>${priCell}</td>
    <td>${deadlineCell}</td>
    <td>${projTags}</td>
    <td>${typeCell}</td>
    <td>${ownerCell}</td>
    <td style="font-size:10px;color:var(--text3);">${h(t.assignedBy||'—')}</td>
    <td>${recurCell}</td>
    <td style="font-size:10px;white-space:pre-wrap;word-break:break-word;max-width:160px;">${h(t.nextAction||'—')}</td>
    <td style="font-size:10px;color:var(--text3);white-space:pre-wrap;word-break:break-word;max-width:130px;">${h(t.dependency||'—')}</td>
    <td class="num" style="font-size:10px;">${age}</td>
    <td class="num" style="font-size:10px;${dlStyle}">${dl!==null?dl:'—'}</td>
    <td>${bEsc(esc)}</td>
    <td style="font-size:10px;color:var(--text3);">${fmtDate(t.closedDate)||'—'}</td>
    <td style="font-size:10px;color:var(--text3);">${h(t.createdBy?t.createdBy.split('@')[0]:'—')}</td>
    ${showActions?`<td>${actions}</td>`:''}
  </tr>`;
}


var _zoom = parseFloat(localStorage.getItem('dcd-zoom') || '1.0');

function setZoom(level) {
  _zoom = Math.max(0.5, Math.min(1.5, level));
  _zoom = Math.round(_zoom * 10) / 10;
  const appEl = document.getElementById('app');
  if(appEl) { appEl.style.zoom = _zoom; appEl.style.transformOrigin='top left'; }
  const lbl = document.getElementById('zoom-label');
  if(lbl) lbl.textContent = Math.round(_zoom*100)+'%';
  localStorage.setItem('dcd-zoom', _zoom);
}
function zoomIn()  { setZoom(_zoom + 0.1); }
function zoomOut() { setZoom(_zoom - 0.1); }
function resetZoom(){ setZoom(1.0); }
function fitToScreen() {
  const avail = window.innerWidth || 1200;
  const target = 1400; // typical dashboard content width
  const scale  = Math.min(avail / target, 1.0);
  setZoom(Math.round(scale * 10) / 10);
}
function initZoom() {
  const saved = parseFloat(localStorage.getItem('dcd-zoom')||'0');
  if(saved > 0) setZoom(saved);
  else fitToScreen();
}


// ═══════════════════════════════════════════════════════════════════
// INLINE EDITABLE DROPDOWNS — direct edit from task table
// ═══════════════════════════════════════════════════════════════════


// ── Status cell: Done triggers archive with confirmation ──────────
function buildStatusCell(taskId, currentStatus) {
  // Statuses EXCLUDING Done (Done handled by ✓ button)
  const activeStatuses = ['Not Started','In Progress','Waiting','Blocked','Cancelled'];
  const statusCls = {
    'In Progress':'status-inprog','Blocked':'status-blocked',
    'Waiting':'status-waiting','Cancelled':'status-waiting',
    'Not Started':''
  }[currentStatus]||'';
  const opts = activeStatuses.map(s=>
    `<option value="${s}" ${s===currentStatus?'selected':''}>${s}</option>`
  ).join('');
  return `<div style="display:flex;flex-direction:column;gap:3px;">
    <select class="inline-select ${statusCls}"
      onchange="inlineUpdate('${taskId}','status',this.value)">${opts}</select>
    <button onclick="confirmMarkDone('${taskId}')"
      style="font-size:9px;padding:2px 5px;border-radius:4px;
      background:rgba(38,166,154,.12);color:var(--corp-teal);
      border:1px solid rgba(38,166,154,.3);cursor:pointer;font-family:var(--sans);
      font-weight:700;white-space:nowrap;" title="Mark as Done and move to Archive">
      ✓ Mark Done
    </button>
  </div>`;
}

function confirmMarkDone(taskId) {
  const t = tasks.find(x=>x.id===taskId); if(!t) return;
  if(!confirm(`Mark "${(t.task||taskId).slice(0,60)}" as Done?\n\nThis task will be moved to the Archive tab and removed from the active task list.`)) return;
  inlineUpdate(taskId,'status','Done');
}

function makeInlineSelect(field, currentVal, options, taskId, extraCls) {
  const statusCls = field==='status' ? {
    'Done':'status-done','Blocked':'status-blocked',
    'Waiting':'status-waiting','In Progress':'status-inprog'
  }[currentVal]||'' : '';
  const opts = ['', ...options].map(o =>
    `<option value="${h(o)}" ${o===currentVal?'selected':''}>${o||'— select —'}</option>`
  ).join('');
  return `<select class="inline-select ${statusCls} ${extraCls||''}"
    onchange="inlineUpdate('${taskId}','${field}',this.value)">${opts}</select>`;
}

function makeCPSelect(taskId, currentVal) {
  // PERFORMANCE: Show text + click-to-edit instead of a full <select>
  // This avoids building a dropdown with all employees for every row
  const displayName = currentVal || '— Select —';
  const shortName = displayName.length > 22 ? displayName.slice(0,22)+'…' : displayName;

  return `<div style="cursor:pointer;min-width:140px;" title="Click to change concerned person"
    onclick="activateCPSelect(this,'${taskId}','${h(currentVal||'')}')">
    <span style="font-size:11px;padding:3px 22px 3px 7px;background:var(--bg2);
      border:1px solid var(--border);border-radius:5px;display:inline-block;
      min-width:130px;color:${currentVal?'var(--text)':'var(--text3)'};
      position:relative;white-space:nowrap;">
      ${h(shortName)}
      <span style="position:absolute;right:5px;top:50%;transform:translateY(-50%);
        font-size:9px;color:var(--text3);">▼</span>
    </span>
  </div>`;
}

// Called when user clicks the CP display — replaces it with a real <select>
function activateCPSelect(el, taskId, currentVal) {
  const active   = employees.filter(e => e.status !== 'Inactive');
  const dirs     = active.filter(e => e.isDirector);
  const others   = active.filter(e => !e.isDirector);
  const allNames = active.map(e => e.name);

  let html = `<select class="inline-select" style="max-width:190px;font-size:11px;width:190px;"
    onchange="inlineUpdate('${taskId}','concernedPerson',this.value)"
    onblur="this.closest('div').outerHTML=makeCPSelect('${taskId}',this.value)"
    autofocus>`;
  html += `<option value="">— Select Person —</option>`;

  if(dirs.length) {
    html += '<optgroup label="★ Directors">';
    html += dirs.map(e => {
      const d = e.designation ? ' – '+e.designation.slice(0,18) : '';
      return `<option value="${h(e.name)}" ${e.name===currentVal?'selected':''}>${h(e.name)}${h(d)}</option>`;
    }).join('');
    html += '</optgroup>';
  }
  if(others.length) {
    html += '<optgroup label="── Employees">';
    html += others.map(e => {
      const d = e.designation ? ' – '+e.designation.slice(0,18) : '';
      return `<option value="${h(e.name)}" ${e.name===currentVal?'selected':''}>${h(e.name)}${h(d)}</option>`;
    }).join('');
    html += '</optgroup>';
  }
  if(currentVal && !allNames.includes(currentVal)) {
    html = html.replace('<option value="">— Select Person —</option>',
      `<option value="">— Select Person —</option><option value="${h(currentVal)}" selected>✎ ${h(currentVal)}</option>`);
  }
  html += '</select>';

  // Replace the click-to-edit div with the real select
  el.outerHTML = `<div style="min-width:140px;">${html}</div>`;
  // Auto-focus the select
  setTimeout(() => {
    const selEl = el.parentElement?.querySelector('select');
    if(selEl) selEl.focus();
  }, 10);
}


function makeProjSelect(taskId, currentProjs) {
  // Show selected projects as tags + a quick-add button
  const tags = currentProjs.length
    ? currentProjs.map(p=>`<span style="display:inline-flex;align-items:center;gap:2px;background:rgba(0,191,165,.12);color:var(--corp-teal);border:1px solid rgba(0,191,165,.25);border-radius:3px;padding:1px 4px;font-size:9px;font-family:var(--mono);">${h(p)}<span onclick="removeProjInline('${taskId}','${p}')" style="cursor:pointer;margin-left:2px;opacity:.7;">✕</span></span>`).join(' ')
    : '<span style="color:var(--text3);font-size:10px;">—</span>';
  return `<div style="display:flex;flex-direction:column;gap:3px;">${tags}<button class="btn btn-ghost" style="font-size:9px;padding:2px 6px;margin-top:2px;" onclick="openEdit('${taskId}')">✎ Edit</button></div>`;
}

function removeProjInline(taskId, projNo) {
  const idx = tasks.findIndex(t=>t.id===taskId); if(idx<0) return;
  tasks[idx].projects = (tasks[idx].projects||[]).filter(p=>p!==projNo);
  tasks[idx].lastUpdate = todayStr();
  addActivityLog('update','task',taskId,`Project ${projNo} removed`);
  saveTasks();
}

function inlineUpdate(taskId, field, value) {
  if(!canAddTask()) { toast('Access denied.','error'); return; }
  const idx = tasks.findIndex(t => t.id === taskId);
  if(idx < 0) return;
  const oldVal = String(tasks[idx][field] || '');
  if(oldVal === value) return; // no change

  // Update local state immediately (optimistic)
  tasks[idx][field]      = value;
  tasks[idx].lastUpdate  = todayStr();

  if(field === 'status' && value === 'Done') {
    tasks[idx].closedDate = todayStr();
    tasks[idx].archivedAt = new Date().toISOString();
    const archTask = { ...tasks[idx] };
    archived.unshift(archTask);
    tasks.splice(idx, 1);
    addActivityLog('archive','task', taskId, 'Archived: ' + (archTask.task||'').slice(0,50));
    renderAll(); renderArchive();
    saveTasks(); saveArchive();
    toast('✅ Task marked Done and moved to Archive.','success');
    return;
  }
  if(field === 'status' && value !== 'Done') tasks[idx].closedDate = '';

  addActivityLog('update','task', taskId, field + ': "' + oldVal + '" → "' + value + '"');
  // Re-render immediately so change is visible at once
  renderAll();
  // Then persist to Firebase
  saveTasks();
}


function openRemarks(taskId) {
  const t = tasks.find(x=>x.id===taskId);
  if(!t){ toast('Task not found.','error'); return; }
  if(!canEditTask(t)){ toast('No permission to edit this task.','error'); return; }
  _remarksTaskId = taskId;
  _remarksDirty  = false;
  const txt    = document.getElementById('remarks-text');
  const prev   = document.getElementById('remarks-task-preview');
  const meta   = document.getElementById('remarks-meta');
  const status = document.getElementById('remarks-autosave-status');
  if(prev)   prev.textContent  = (t.task||'').slice(0,130)+(t.task?.length>130?'…':'');
  if(txt)    txt.value         = t.remarks||'';
  if(status) status.style.opacity='0';
  if(meta){
    meta.textContent = t.remarks
      ? `Last updated: ${t.lastUpdate||'—'}  by ${t.createdBy||'unknown'}`
      : 'No remarks yet. Start typing — auto-saves in 0.8s.';
  }
  document.getElementById('remarks-modal').classList.add('open');
  setTimeout(()=>{ if(txt) txt.focus(); }, 80);
}

function closeRemarks() {
  if(_remarksDirty) saveRemarksNow();
  if(_remarksTimer){ clearTimeout(_remarksTimer); _remarksTimer=null; }
  _remarksTaskId=null; _remarksDirty=false;
  document.getElementById('remarks-modal').classList.remove('open');
}

function scheduleRemarksAutoSave() {
  _remarksDirty = true;
  if(_remarksTimer) clearTimeout(_remarksTimer);
  _remarksTimer = setTimeout(saveRemarksNow, 800);
}

function saveRemarksNow() {
  if(!_remarksTaskId) return;
  const idx = tasks.findIndex(t=>t.id===_remarksTaskId); if(idx<0) return;
  const newVal = (document.getElementById('remarks-text')?.value||'').trim();
  const oldVal = tasks[idx].remarks||'';
  if(newVal===oldVal){ _remarksDirty=false; return; }
  tasks[idx].remarks    = newVal;
  tasks[idx].lastUpdate = todayStr();
  const statusEl = document.getElementById('remarks-autosave-status');
  if(statusEl){ statusEl.style.opacity='1'; setTimeout(()=>statusEl.style.opacity='0',2000); }
  const metaEl = document.getElementById('remarks-meta');
  if(metaEl) metaEl.textContent = `Saved: ${new Date().toLocaleTimeString('en-IN')}`;
  addActivityLog('update','task-remarks',_remarksTaskId,'Remarks updated: '+(newVal.slice(0,60)));
  saveTasks();
  _remarksDirty = false;
}

function clearRemarksForTask() {
  if(!_remarksTaskId||!confirm('Clear remarks for this task?')) return;
  const txt = document.getElementById('remarks-text');
  if(txt) txt.value='';
  _remarksDirty=true;
  saveRemarksNow();
  toast('Remarks cleared.','success');
}

// ═══════════════════════════════════════════════════════════════════
// RAPID SWITCHER
// ═══════════════════════════════════════════════════════════════════
let _switcherOpen = false;

function toggleSwitcher() {
  _switcherOpen = !_switcherOpen;
  const menu = document.getElementById('rapid-menu');
  const btn  = document.getElementById('switcher-toggle');
  if(menu) menu.classList.toggle('open', _switcherOpen);
  if(btn)  btn.textContent = _switcherOpen ? '✕' : '⚡';
}

// Close switcher when clicking outside
document.addEventListener('click', function(e) {
  const sw = null; // rapid switcher removed
  if(sw && !sw.contains(e.target) && _switcherOpen) toggleSwitcher();
});

// ═══════════════════════════════════════════════════════════════════
// FIXED RIBBON — ensure nav stays visible
// ═══════════════════════════════════════════════════════════════════
function ensureRibbonFixed() {
  // Force sticky on nav
  const navEl = document.querySelector('.nav-tabs');
  if(navEl){
    navEl.style.position = 'sticky';
    navEl.style.top      = '57px';
    navEl.style.zIndex   = '199';
  }
}


// ═══════════════════════════════════════════════════════════════════
// INLINE REMARK EDITOR — + button, auto-save, no page change needed
// ═══════════════════════════════════════════════════════════════════
let _remarkTaskId      = null;
let _remarkTimer       = null;
let _remarkDirty       = false;

function openInlineRemark(taskId) {
  const t = tasks.find(x=>x.id===taskId);
  if(!t) return;
  if(!canEditTask(t)) { toast('Access denied.','error'); return; }
  _remarkTaskId = taskId;
  _remarkDirty  = false;
  const modal   = document.getElementById('inline-remark-modal');
  const title   = document.getElementById('irm-title');
  const preview = document.getElementById('irm-preview');
  const txt     = document.getElementById('irm-text');
  const saved   = document.getElementById('irm-saved');
  if(title)   title.textContent   = 'Remark — ' + taskId;
  if(preview) preview.textContent = (t.task||'').slice(0,100) + (t.task?.length>100?'…':'');
  if(txt)     txt.value           = t.remarks||'';
  if(saved)   saved.classList.remove('show');
  modal.style.display = 'block'; modal.classList.add('visible');
  setTimeout(()=>{ if(txt) txt.focus(); }, 60);
}

function closeInlineRemark() {
  if(_remarkDirty) saveRemarkNow();
  if(_remarkTimer) { clearTimeout(_remarkTimer); _remarkTimer=null; }
  const modal = document.getElementById('inline-remark-modal');
  if(modal) modal.style.display='none'; modal.classList.remove('visible');
  _remarkTaskId=null; _remarkDirty=false;
}

function scheduleRemarkAutoSave() {
  _remarkDirty = true;
  if(_remarkTimer) clearTimeout(_remarkTimer);
  _remarkTimer = setTimeout(saveRemarkNow, 900);
}

function saveRemarkNow() {
  if(!_remarkTaskId) return;
  const idx = tasks.findIndex(t=>t.id===_remarkTaskId);
  if(idx<0) return;
  const newText  = (document.getElementById('irm-text')?.value||'').trim();
  const oldText  = tasks[idx].remarks||'';
  if(newText===oldText) { _remarkDirty=false; return; }
  tasks[idx].remarks    = newText;
  tasks[idx].lastUpdate = todayStr();
  addActivityLog('update','task-remark',_remarkTaskId,
    `Remark updated on ${_remarkTaskId}`, `"${newText.slice(0,60)}"`);
  saveTasks();
  _remarkDirty=false;
  const saved = document.getElementById('irm-saved');
  if(saved) { saved.classList.add('show'); setTimeout(()=>saved.classList.remove('show'),2500); }
}

// ═══════════════════════════════════════════════════════════════════
// RAPID SWITCHER — floating FAB quick navigation
// ═══════════════════════════════════════════════════════════════════
let _rsOpen = false;





// Close RS when clicking outside
document.addEventListener('click', function(e) {
  const rs = null; // rapid switcher removed
  if(rs && !rs.contains(e.target) && _rsOpen) closeRS();
});

// ═══════════════════════════════════════════════════════════════════
// DEFAULT DATE — ensure f-cdate always gets today on openAdd
// ═══════════════════════════════════════════════════════════════════
// Patch openAdd to always force today's date
const _origOpenAdd = typeof openAdd === 'function' ? openAdd : null;

// Force date after DOM ready
document.addEventListener('DOMContentLoaded', function() {
  // Patch f-cdate to always show today when modal opens
  const obs = new MutationObserver(()=>{
    const cdEl = document.getElementById('f-cdate');
    const modal = document.getElementById('task-modal');
    if(cdEl && modal && modal.classList.contains('open')) {
      if(!cdEl.value || cdEl.value === '') {
        cdEl.value = todayStr();
      }
    }
  });
  const modal = document.getElementById('task-modal');
  if(modal) obs.observe(modal, {attributes:true, attributeFilter:['class']});
});

// ═══════════════════════════════════════════════════════════════════
// FORM: Put Quick Note and Remarks side by side
// ═══════════════════════════════════════════════════════════════════
function arrangeFormNotes() {
  const qnEl  = document.getElementById('f-tasknote')?.closest('.form-group');
  const rmEl  = document.getElementById('f-remarks')?.closest('.form-group');
  if(!qnEl || !rmEl) return;
  // Wrap them in a side-by-side container if not already done
  if(qnEl.parentElement?.classList.contains('form-notes-row')) return;
  const wrapper = document.createElement('div');
  wrapper.className = 'form-notes-row full';
  wrapper.style.gridColumn = '1/-1';
  qnEl.parentElement.insertBefore(wrapper, qnEl);
  wrapper.appendChild(qnEl);
  wrapper.appendChild(rmEl);
  // Remove the 'full' class from each child since wrapper handles it
  qnEl.classList.remove('full');
  rmEl.classList.remove('full');
}


function syncFollowup(val) {
  // Keep both follow-up date fields in sync
  const a = document.getElementById('f-followup-top');
  const b = document.getElementById('f-followup');
  if(a && a.value !== val) a.value = val;
  if(b && b.value !== val) b.value = val;
  if(b) updateRecurPreview();
}


// ═══════════════════════════════════════════════════════════════════
// REAL-TIME SYNC — Optimistic updates + fast polling
// Strategy:
//   1. Every local change updates the UI IMMEDIATELY (optimistic)
//   2. Firebase save runs in background
//   3. 2-second polling syncs changes made by OTHER users
//   4. On save failure: rollback UI + show error
// ═══════════════════════════════════════════════════════════════════

// ── Connection + loading state ────────────────────────────
function showSaving() {
  const el = document.getElementById('save-indicator');
  const sp = document.getElementById('saving-spinner');
  if(el){ el.textContent='Saving…'; el.style.color='var(--amber)'; el.style.opacity='1'; }
  if(sp) sp.classList.add('active');
}
function showSaved() {
  const el = document.getElementById('save-indicator');
  const sp = document.getElementById('saving-spinner');
  if(sp) sp.classList.remove('active');
  if(el){ el.textContent='✔ Saved'; el.style.color='var(--green)'; el.style.opacity='1';
    setTimeout(()=>{ if(el && el.textContent==='✔ Saved') el.style.opacity='0'; }, 2500); }
}
function showSaveError(msg) {
  const el = document.getElementById('save-indicator');
  const sp = document.getElementById('saving-spinner');
  if(sp) sp.classList.remove('active');
  if(el){ el.textContent='✕ Save failed'; el.style.color='var(--red)'; el.style.opacity='1'; }
  toast('❌ '+(msg||'Save failed — check your connection.'),'error');
}

// Stubs for SSE functions (no-op — SSE removed in favour of polling)
function closeRealtimeListeners() {}
function startRealtimeListeners() {}


