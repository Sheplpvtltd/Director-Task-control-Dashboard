// B. EMPLOYEE BULK IMPORT / EXPORT
// ════════════════════════════════════════════════════════════════════
const EMP_HEADERS = [
  'Employee ID','Employee Name','Designation','Department',
  'Email','Mobile Number','Reporting Manager','Director (Yes/No)','Status'
];
const EMP_SAMPLE = [
  'EMP-010','John Smith','Managing Director','Management',
  'john@company.com','+91 98765 43210','','Yes','Active'
];

function downloadEmpTemplate() {
  loadXLSX(() => {
    const wb = buildExcel('Employees', EMP_HEADERS, EMP_SAMPLE);
    const ws_instr_emp = XLSX.utils.aoa_to_sheet([
      ['Field','Valid Values / Notes'],
      ['Employee ID','Unique code e.g. EMP-001 (auto-generated if blank)'],
      ['Director (Yes/No)','Yes or No'],
      ['Status','Active or Inactive'],
      ['Department', L.depts.join(' | ')],
    ]);
    ws_instr_emp['!cols'] = [{wch:24},{wch:80}];
    XLSX.utils.book_append_sheet(wb, notes, 'Instructions');
    downloadExcel(wb, `Employee-Import-Template-${todayStr()}.xlsx`);
    toast('Employee Excel template downloaded.', 'success');
  });
}

async function handleEmpExcelUpload(input) {
  if (!input.files?.length) return;
  const file = input.files[0]; input.value='';
  setUploadProgress('emp-upload-progress', true, 'Reading Excel…');
  loadXLSX(async () => {
    try {
      const rows = await parseExcel(file);
      if (!rows.length) { toast('Excel file is empty.','error'); setUploadProgress('emp-upload-progress',false); return; }
      const results = []; const newEmps = [];
      for (let i=0; i<rows.length; i++) {
        const r = rows[i]; const rowNum = i+2;
        const name = (r['Employee Name']||r['Name']||'').toString().trim();
        if (!name) { results.push({row:rowNum, status:'skip', label:'(empty)', note:'Employee Name is blank — row skipped'}); continue; }
        const empCode = (r['Employee ID']||r['Employee Code']||'').toString().trim() || nextEmpId();
        const dup = employees.find(e=>e.empCode===empCode&&e.name===name);
        if (dup) { results.push({row:rowNum, status:'skip', label:name, note:`Duplicate: ${empCode} already exists`}); continue; }
        const dirRaw = (r['Director (Yes/No)']||r['Director']||'No').toString().toLowerCase();
        const statRaw = (r['Status']||'Active').toString().trim();
        const emp = {
          id: 'EMP-'+Date.now()+'-'+i,
          empCode,
          name,
          designation:     (r['Designation']||'').toString().trim(),
          department:      (r['Department']||'').toString().trim(),
          email:           (r['Email']||r['Email Address']||'').toString().trim(),
          mobile:          (r['Mobile Number']||r['Mobile']||'').toString().trim(),
          reportingManager:(r['Reporting Manager']||'').toString().trim(),
          isDirector:      dirRaw==='yes'||dirRaw==='true'||dirRaw==='1',
          status:          ['Active','Inactive'].includes(statRaw)?statRaw:'Active',
          createdAt:       todayStr(),
          createdBy:       currentUser?currentUser.email:'',
        };
        newEmps.push(emp);
        results.push({row:rowNum, status:'ok', label:`${empCode} — ${name}`, note:'Imported successfully'});
      }
      if (newEmps.length) {
        employees.push(...newEmps);
        setUploadProgress('emp-upload-progress', true, `Saving ${newEmps.length} employees…`);
        saveEmployees();
      }
      setUploadProgress('emp-upload-progress', false);
      showImportResults(`Employee Import — ${file.name}`, results);
    } catch(e) {
      setUploadProgress('emp-upload-progress', false);
      toast('Import failed: '+e.message, 'error');
    }
  });
}

