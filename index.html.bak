  document.getElementById('project-modal').addEventListener('click', e=>{ if(e.target===e.currentTarget)closeProjModal(); });
  document.getElementById('proj-confirm-yes').addEventListener('click', doDeleteProject);
  document.getElementById('proj-confirm-no').addEventListener('click', closeProjConfirm);
  document.getElementById('pf-status').addEventListener('change', renderProjects);

  // Task view filters
  ['tv-dept','tv-proj','tv-owner','tv-status','tv-pri','tv-esc'].forEach(id=>{
    const el=document.getElementById(id); if(el) el.addEventListener('change', renderTaskView);
  });
  const tvConcerned=document.getElementById('tv-concerned');
  if(tvConcerned) tvConcerned.addEventListener('input', renderTaskView);
  document.getElementById('tv-reset').addEventListener('click',()=>{
    ['tv-dept','tv-proj','tv-owner','tv-status','tv-pri','tv-esc'].forEach(id=>{ const el=document.getElementById(id); if(el)el.value='All'; });
    ['tv-search','tv-concerned','tv-deadline'].forEach(id=>{ const el=document.getElementById(id); if(el)el.value=''; });
    const tc=document.getElementById('tv-concerned'); if(tc)tc.value='';
  const ts=document.getElementById('tv-search'); if(ts)ts.value='';
  const td=document.getElementById('tv-deadline'); if(td)td.value='';
  const te=document.getElementById('tv-esc'); if(te)te.value='All';
    renderTaskView();
  });
});
</script>

<!-- ══ REMARKS MODAL ══ -->
<div class="modal-backdrop" id="remarks-modal">
  <div class="modal" style="width:520px;">
    <div class="modal-hdr">
      <div class="modal-title">📋 Remarks</div>
      <div id="remarks-autosave-status" style="font-size:10px;color:#FF8F00;font-weight:600;margin-left:10px;opacity:0;transition:opacity .4s;">✔ Saved</div>
      <button class="modal-close" onclick="closeRemarks()">✕</button>
    </div>
    <div class="modal-body">
      <div style="font-size:12px;color:var(--text2);background:var(--bg2);border:1px solid var(--border);border-radius:7px;padding:9px 12px;margin-bottom:12px;line-height:1.5;" id="remarks-task-preview"></div>
      <label class="form-label" style="display:block;margin-bottom:4px;">Remarks / Closure Notes <span style="font-size:9px;color:#FF8F00;font-weight:400;">(auto-saves as you type)</span></label>
      <textarea id="remarks-text" rows="5"
        style="width:100%;background:var(--bg2);border:1px solid rgba(255,143,0,.3);border-radius:7px;color:var(--text);padding:10px 12px;font-family:var(--sans);font-size:13px;outline:none;resize:vertical;"
        placeholder="Add remarks, closure notes, decisions, or outcome details…"
        oninput="scheduleRemarksAutoSave()"></textarea>
      <div id="remarks-meta" style="font-size:10px;color:var(--text3);margin-top:8px;line-height:1.6;"></div>
    </div>
    <div class="modal-ftr" style="justify-content:space-between;">
      <button class="btn btn-ghost btn-sm" onclick="clearRemarksForTask()" style="font-size:10px;color:var(--red);">🗑 Clear</button>
      <div style="display:flex;gap:8px;">
        <button class="btn btn-ghost" onclick="closeRemarks()">Close</button>
        <button class="btn btn-sm" onclick="saveRemarksNow()" style="background:#FF8F00;color:#fff;border:none;border-radius:7px;font-weight:700;padding:6px 16px;">💾 Save Remarks</button>
      </div>
    </div>
  </div>
</div>



</div>


  <button class="rs-fab" id="rs-fab" onclick="event.stopPropagation();toggleRS()" title="Quick Navigation — Fast page switcher">⚡</button>
</div>

</body>
</html>
