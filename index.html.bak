<!-- ══ QUICK NOTE MODAL (with employee dropdown + auto-save) ══ -->
<div class="modal-backdrop" id="qnote-modal">
  <div class="modal" style="width:560px;">
    <div class="modal-hdr">
      <div class="modal-title" id="qnote-modal-title">📝 Quick Note</div>
      <div id="qnote-autosave-status" style="font-size:10px;color:var(--green);font-weight:600;margin-left:10px;opacity:0;transition:opacity .4s;">✔ Auto-saved</div>
      <button class="modal-close" onclick="closeQNote()">✕</button>
    </div>
    <div class="modal-body">
      <!-- Task context -->
      <div style="font-size:12px;color:var(--text2);background:var(--bg2);border:1px solid var(--border);border-radius:7px;padding:9px 12px;margin-bottom:12px;line-height:1.5;" id="qnote-task-preview"></div>

      <!-- Employee dropdown -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
        <div>
          <label class="form-label" style="display:block;margin-bottom:4px;">Note By (Employee)</label>
          <select id="qnote-employee" onchange="onQNoteEmployeeChange()"
            style="width:100%;background:var(--bg2);border:1px solid var(--border);border-radius:7px;color:var(--text);padding:7px 28px 7px 10px;font-family:var(--sans);font-size:12px;outline:none;appearance:none;">
            <option value="">— Select Employee —</option>
          </select>
        </div>
        <div>
          <label class="form-label" style="display:block;margin-bottom:4px;">Or Enter Name Manually</label>
          <input type="text" id="qnote-manual-name" placeholder="Custom name…"
            style="width:100%;background:var(--bg2);border:1px solid var(--border);border-radius:7px;color:var(--text);padding:7px 10px;font-family:var(--sans);font-size:12px;outline:none;"
            oninput="scheduleQNoteAutoSave()">
        </div>
      </div>

      <!-- Note textarea (auto-saves on typing) -->
      <label class="form-label" style="display:block;margin-bottom:4px;">Quick Note <span style="font-size:9px;color:var(--green);font-weight:400;">(auto-saves as you type)</span></label>
      <textarea id="qnote-text" rows="5"
        style="width:100%;background:var(--bg2);border:1px solid var(--border);border-radius:7px;color:var(--text);padding:10px 12px;font-family:var(--sans);font-size:13px;outline:none;resize:vertical;"
        placeholder="Type a quick note, action item, or follow-up…"
        oninput="scheduleQNoteAutoSave()"></textarea>

      <!-- Note metadata -->
      <div id="qnote-meta" style="font-size:10px;color:var(--text3);margin-top:8px;line-height:1.6;"></div>
    </div>
    <div class="modal-ftr" style="justify-content:space-between;">
      <button class="btn btn-danger btn-sm" onclick="clearQNoteForTask()" style="font-size:10px;">🗑 Clear Note</button>
      <div style="display:flex;gap:8px;">
        <button class="btn btn-ghost" onclick="closeQNote()">Close</button>
        <button class="btn btn-primary" onclick="saveQNoteAndClose()">💾 Save Now</button>
      </div>
    </div>
  </div>
</div>

<!-- ══ TASK MODAL ══ -->
<div class="modal-backdrop" id="task-modal">
  <div class="modal">
    <div class="modal-hdr"><div class="modal-title" id="modal-title">Add New Task</div><button class="modal-close" id="modal-close">✕</button></div>
    <div class="modal-body">
      <div class="form-grid">
        <!-- Row 1: ID + Date -->
        <div class="form-group"><label class="form-label">Task ID</label><input type="text" id="f-id" readonly style="opacity:.5;"></div>
        <div class="form-group"><label class="form-label">Capture Date</label><input type="date" id="f-cdate"></div>

        <!-- Task -->
        <div class="form-group full"><label class="form-label">Task Captured</label><textarea id="f-task" rows="2" placeholder="Write the exact task…"></textarea></div>

        <div class="form-section-divider"><span>Classification</span></div>

        <!-- Department -->
        <div class="form-group">
          <label class="form-label">Department</label>
          <select id="f-dept" onchange="handleOther('f-dept','f-dept-other-wrap')"></select>
          <div class="other-field" id="f-dept-other-wrap">
            <input type="text" id="f-dept-other" placeholder="Please provide details…">
            <div class="other-hint">ℹ If Other, please specify</div>
          </div>
        </div>

        <!-- Concerned Persons (multi-select) -->
        <div class="form-group full" id="mpsp-wrap">
          <label class="form-label">Concerned Person <span style="font-size:10px;color:var(--text3);">(select one or more)</span></label>
          <input type="hidden" id="f-persons-json" value="[]">
          <div id="mpsp-tags" onclick="openMPSPerson()"
            style="min-height:36px;padding:5px 10px;background:var(--bg2);border:1px solid var(--border);
                   border-radius:6px;cursor:pointer;display:flex;flex-wrap:wrap;gap:5px;align-items:center;">
            <span style="color:var(--text3);font-size:11px;">Click to select concerned persons…</span>
          </div>
          <div id="mpsp-panel" style="display:none;position:fixed;z-index:10000;background:var(--surface);
               border:1px solid var(--border2);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.4);
               min-width:280px;max-height:340px;overflow-y:auto;display:flex;flex-direction:column;">
            <div style="padding:8px 10px;border-bottom:1px solid var(--border);">
              <input type="text" id="mpsp-search" placeholder="🔍 Search employees…"
                oninput="renderMPSPersonPanel()"
                style="width:100%;padding:6px 9px;background:var(--bg2);border:1px solid var(--border);
                       border-radius:5px;color:var(--text);font-size:11px;outline:none;">
            </div>
            <div id="mpsp-options"></div>
            <div style="padding:8px 10px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;">
              <button class="btn btn-primary btn-sm" onclick="closeMPSPerson()">Done ✓</button>
            </div>
          </div>
        </div>
        <!-- Projects (multi-select) -->

        <div class="form-group full">
          <label class="form-label">Projects <span style="font-size:10px;color:var(--text3);font-weight:400;text-transform:none;letter-spacing:0;">(select one or more)</span></label>
          <div class="mps-wrapper" id="mps-wrapper">
            <div class="mps-trigger" id="mps-trigger" onclick="toggleMPS(event)">
              <div class="mps-tags" id="mps-tags"><span class="mps-placeholder">Click to select projects…</span></div>
              <span class="mps-arrow">▾</span>
            </div>
            <div class="mps-panel" id="mps-panel" style="display:none;">
              <input type="text" class="mps-search" id="mps-search" placeholder="🔍 Search project number or name…" oninput="renderMPSOptions()">
              <div class="mps-options" id="mps-options"></div>
            </div>
          </div>
        </div>

        <!-- Task Type -->
        <div class="form-group">
          <label class="form-label">Task Type</label>
          <select id="f-tasktype" onchange="handleOther('f-tasktype','f-tasktype-other-wrap')"></select>
          <div class="other-field" id="f-tasktype-other-wrap">
            <input type="text" id="f-tasktype-other" placeholder="Please specify task type…">
            <div class="other-hint">ℹ If Other, please specify</div>
          </div>
        </div>

        <!-- Priority + Status -->
        <div class="form-group"><label class="form-label">Priority</label><select id="f-pri"></select></div>
        <div class="form-group"><label class="form-label">Status</label><select id="f-status"></select></div>

        <!-- Owner + Assigned By -->
        <div class="form-group">
          <label class="form-label">Task Owner</label>
          <select id="f-owner" onchange="handleOther('f-owner','f-owner-other-wrap')"></select>
          <div class="other-field" id="f-owner-other-wrap">
            <input type="text" id="f-owner-other" placeholder="Specify owner name…">
            <div class="other-hint">ℹ If Other, please specify</div>
          </div>
        </div>
        <div class="form-group"><label class="form-label">Assigned By</label><input type="text" id="f-by" placeholder="Director…"></div>

        <!-- Deadline -->
        <!-- Deadline + Follow-up SIDE BY SIDE -->
                <!-- ═══ Deadline + Follow-up side by side ═══ -->
        <div style="grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0;">
          <div class="form-group" style="border:1px solid rgba(239,83,80,.25);border-radius:8px;padding:10px;background:rgba(239,83,80,.04);">
          <label class="form-label" style="color:var(--red);">📅 Deadline</label>
          <input type="date" id="f-deadline" style="width:100%;font-weight:700;">
        </div>
          <div class="form-group" style="border:1px solid rgba(0,191,165,.25);border-radius:8px;padding:10px;background:rgba(0,191,165,.04);">
          <label class="form-label" style="color:var(--corp-teal);">🔔 Follow-up Date</label>
          <input type="date" id="f-followup-top" oninput="syncFollowup(this.value)" style="width:100%;font-weight:700;">
          <div style="font-size:9px;color:var(--text3);margin-top:4px;">Date to follow up on this task</div>
        </div>
        </div>


        <div class="form-section-divider" style="grid-column:1/-1;"><span>Follow-up &amp; Recurrence</span></div>

        <!-- Follow-up Date + Recurrence -->
        <div class="form-group full">
          <div class="recur-section">
            <div class="recur-section-title">📅 Follow-up Schedule</div>
            <div class="recur-row">
              <div class="form-group" style="margin:0;">
                <label class="form-label">Follow-up Date</label>
                <input type="date" id="f-followup" oninput="syncFollowup(this.value)">
              </div>
              <div class="form-group" style="margin:0;">
                <label class="form-label">Recurrence</label>
                <select id="f-recurrence" onchange="handleRecurrenceChange(); updateRecurPreview();">
                  <option value="None">No Recurrence</option>
                  <option value="Daily">Daily</option>
                  <option value="Alternate Days">Alternate Days (Every 2 Days)</option>
                  <option value="Weekly">Weekly (Every 7 Days)</option>
                  <option value="Fortnightly">Fortnightly (Every 14 Days)</option>
                  <option value="Monthly">Monthly (Every 30 Days)</option>
                  <option value="Quarterly">Quarterly (Every 91 Days)</option>
                  <option value="Custom">Custom (Specify Days)</option>
                </select>
              </div>
            </div>
            <!-- Custom days -->
            <div id="f-custom-days-wrap" style="display:none;margin-top:10px;">
              <label class="form-label">Repeat every</label>
              <div style="display:flex;align-items:center;gap:8px;margin-top:4px;">
                <input type="number" id="f-custom-days" min="1" max="365" placeholder="e.g. 10" style="width:100px;" oninput="updateRecurPreview()">
                <span style="font-size:12px;color:var(--text2);">days</span>
              </div>
            </div>
            <div class="recur-next-preview" id="recur-preview"></div>
          </div>
        </div>

        <div class="form-section-divider"><span>Details</span></div>

        <!-- Next Action + Dependency + Remarks -->
        <div class="form-group full"><label class="form-label">Next Action</label><textarea id="f-next" rows="2" placeholder="What is the very next step?"></textarea></div>
        <div class="form-group full"><label class="form-label">Dependency / Constraint</label><input type="text" id="f-dep" placeholder="What is blocking or waiting?"></div>
        <div class="form-group full">
          <div class="form-notes-row">
            <div>
              <label class="form-label" style="display:flex;align-items:center;gap:6px;"><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--corp-teal);"></span> Quick Note <span style="font-size:9px;font-weight:400;color:var(--text3);">(visible in table)</span></label>
              <textarea id="f-tasknote" rows="3" placeholder="Quick note, action item, or follow-up…" style="width:100%;resize:vertical;"></textarea>
            </div>
            <div>
              <label class="form-label" style="display:flex;align-items:center;gap:6px;"><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#FF8F00;"></span> Remarks / Closure Notes <span style="font-size:9px;font-weight:400;color:var(--text3);">(visible in table)</span></label>
              <textarea id="f-remarks" rows="3" placeholder="Outcome, closure decision, details…" style="width:100%;resize:vertical;"></textarea>
            </div>
          </div>
        </div>
        <div class="form-group"><label class="form-label">Closed Date</label><input type="date" id="f-closed"></div>
      </div>
    </div>
    <div class="modal-ftr">
      <button class="btn btn-ghost" id="modal-cancel">Cancel</button>
      <button class="btn btn-primary" id="modal-save">Save Task</button>
    </div>
  </div>
</div>

<!-- ══ PROJECT MODAL ══ -->
<div class="modal-backdrop modal-sm" id="project-modal">
  <div class="modal">
    <div class="modal-hdr"><div class="modal-title" id="proj-modal-title">New Project</div><button class="modal-close" id="proj-modal-close">✕</button></div>
