        <div class="form-group"><label class="form-label">Project Name</label><input type="text" id="pf-name" placeholder="Short project title"></div>
        <div class="form-group"><label class="form-label">Start Date</label><input type="date" id="pf-start"></div>
        <div class="form-group"><label class="form-label">End Date (optional)</label><input type="date" id="pf-end"></div>
        <div class="form-group full"><label class="form-label">Project Description</label><textarea id="pf-desc" rows="3" placeholder="Scope, objectives, key deliverables…"></textarea></div>
      </div>
    </div>
    <div class="modal-ftr">
      <button class="btn btn-ghost" id="proj-modal-cancel">Cancel</button>
      <button class="btn btn-primary" id="proj-modal-save">Save Project</button>
    </div>
  </div>
</div>

